          <h6 class="fw-bold text-white mb-3">Tautan Portal</h6>
          <ul class="footer-links">
            <li><a href="#hero"><i class="bi bi-chevron-right me-1 small"></i> Beranda</a></li>
            <li><a href="#packages"><i class="bi bi-chevron-right me-1 small"></i> Paket Internet</a></li>
            <li><a href="/customer/check-billing"><i class="bi bi-chevron-right me-1 small"></i> Cek & Bayar Tagihan</a></li>
            <li><a href="/customer/voucher"><i class="bi bi-chevron-right me-1 small"></i> Beli Voucher Wi-Fi</a></li>
            <li><a href="/customer/register"><i class="bi bi-chevron-right me-1 small"></i> Pasang Baru</a></li>
