              <% if (settings.social_facebook) { %><a href="<%= settings.social_facebook %>" target="_blank" rel="noopener" class="text-white opacity-75 hover-opacity-100 fs-5"><i class="bi bi-facebook"></i></a><% } %>
              <% if (settings.social_tiktok) { %><a href="<%= settings.social_tiktok %>" target="_blank" rel="noopener" class="text-white opacity-75 hover-opacity-100 fs-5"><i class="bi bi-tiktok"></i></a><% } %>
            </div>
          <% } %>
        </div>

