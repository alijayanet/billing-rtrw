  <!-- Dynamic Announcement / Maintenance Banner -->
  <% if (settings.portal_banner_enabled && settings.portal_banner_text) { 
    const bType = settings.portal_banner_type || 'info';
    let alertCls = 'bg-info bg-opacity-15 text-info border-info border-opacity-30';
    let bIcon = 'bi-info-circle-fill';
    if (bType === 'warning') {
      alertCls = 'bg-warning bg-opacity-20 text-warning border-warning border-opacity-40';
      bIcon = 'bi-exclamation-triangle-fill';
    } else if (bType === 'danger') {
      alertCls = 'bg-danger bg-opacity-20 text-danger border-danger border-opacity-40';
      bIcon = 'bi-exclamation-octagon-fill';
    } else if (bType === 'success') {
      alertCls = 'bg-success bg-opacity-20 text-success border-success border-opacity-40';
      bIcon = 'bi-megaphone-fill';
    }
  %>
    <div class="portal-announcement-banner border-bottom py-2 px-3 <%= alertCls %>" id="portalAnnouncement">
      <div class="container d-flex align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-2 small fw-semibold">
          <i class="bi <%= bIcon %> fs-6 flex-shrink-0"></i>
          <span><%= settings.portal_banner_text %></span>
        </div>
        <button type="button" class="btn-close btn-close-white small flex-shrink-0" style="font-size:0.75rem;" onclick="document.getElementById('portalAnnouncement').style.display='none'"></button>
      </div>
    </div>
  <% } %>

  <!-- Hero & Login Section -->
