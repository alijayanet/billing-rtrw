  <!-- Floating PWA Install Banner -->
  <div id="pwa-install-banner" class="position-fixed bottom-0 start-50 translate-middle-x p-3 mb-3" style="z-index: 9999; max-width: 92%; width: 440px; display: none;">
    <div class="glass-card p-3 shadow-2xl border border-warning border-opacity-50 rounded-4 d-flex align-items-center justify-content-between gap-3 text-white" style="background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(16px);">
      <div class="d-flex align-items-center gap-3">
        <div class="bg-warning bg-opacity-20 p-2 rounded-3 text-warning border border-warning border-opacity-25 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; flex-shrink: 0;">
          <i class="bi bi-phone-vibrate fs-3"></i>
        </div>
        <div>
          <h6 class="fw-bold mb-0 text-warning">Install Aplikasi Pelanggan</h6>
          <small class="text-slate-300" style="font-size:12px">Akses cepat & praktis tanpa perlu buka browser!</small>
        </div>
      </div>
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-warning btn-sm fw-bold px-3 py-2 rounded-3 shadow" onclick="triggerPwaInstall()">
          <i class="bi bi-download me-1"></i> Install
        </button>
        <button type="button" class="btn-close btn-close-white ms-1" onclick="dismissPwaBanner()"></button>
      </div>
    </div>
  </div>

  <!-- PWA Install Modal -->
  <div class="modal fade" id="pwaInstallModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content text-white border border-secondary border-opacity-25 shadow-2xl" style="background: #1e293b; border-radius: 16px;">
        <div class="modal-header border-secondary border-opacity-25">
          <h5 class="modal-title fw-bold text-warning d-flex align-items-center gap-2">
            <i class="bi bi-download"></i> Cara Install Aplikasi Pelanggan
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <p class="text-slate-300 small mb-3">
            Nikmati akses instan ke <strong>Portal Pelanggan <%= settings.company_header || 'Portal ISP' %></strong> langsung dari layar utama HP / Komputer Anda tanpa perlu membuka browser tiap kali ingin cek tagihan/bayar!
          </p>

          <!-- Android / Chrome / Edge Instructions -->
          <div class="p-3 mb-3 rounded-3 border border-secondary border-opacity-25 bg-dark bg-opacity-50">
            <h6 class="fw-bold text-info mb-2"><i class="bi bi-android2 me-1"></i> Android / Chrome / Laptop (Windows/Mac)</h6>
            <ol class="small text-slate-300 mb-0 ps-3">
              <li class="mb-1">Klik tombol <strong>"Install Sekarang"</strong> di bawah ini.</li>
              <li class="mb-1">Tekan tombol <strong>Install / Tambahkan</strong> pada jendela konfirmasi browser.</li>
              <li>Icon aplikasi <strong>Pelanggan</strong> akan otomatis muncul di Home Screen Anda!</li>
            </ol>
          </div>

          <!-- iOS Safari Instructions -->
          <div class="p-3 rounded-3 border border-secondary border-opacity-25 bg-dark bg-opacity-50">
            <h6 class="fw-bold text-warning mb-2"><i class="bi bi-apple me-1"></i> iPhone / iPad (Safari)</h6>
            <ol class="small text-slate-300 mb-0 ps-3">
              <li class="mb-1">Tekan tombol <strong>Share (Bagikan)</strong> <i class="bi bi-share text-primary"></i> di menu bawah Safari.</li>
              <li class="mb-1">Geser ke bawah dan pilih <strong>"Add to Home Screen" (Tambah ke Layar Utama)</strong> <i class="bi bi-plus-square text-primary"></i>.</li>
              <li>Tekan <strong>Add (Tambah)</strong> di pojok kanan atas.</li>
            </ol>
          </div>
        </div>
        <div class="modal-footer border-secondary border-opacity-25">
          <button type="button" id="modal-btn-install-direct" class="btn btn-warning fw-bold px-4 py-2" onclick="triggerPwaInstallDirect()">
            <i class="bi bi-download me-1"></i> Install Sekarang
          </button>
          <button type="button" class="btn btn-outline-light px-4 py-2" data-bs-dismiss="modal">Tutup</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // PWA Prompt Handler
    let deferredPwaPrompt = null;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPwaPrompt = e;

      // Show floating banner if not dismissed before
      if (!localStorage.getItem('pwa_banner_dismissed')) {
        const banner = document.getElementById('pwa-install-banner');
        if (banner) banner.style.display = 'block';
      }

      // Highlight install buttons
      const navBtn = document.getElementById('btn-install-pwa-nav');
      const heroBtn = document.getElementById('btn-install-pwa-hero');
      if (navBtn) navBtn.classList.add('shadow-lg');
      if (heroBtn) heroBtn.classList.add('shadow-lg');
    });

    function triggerPwaInstall() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then((choiceResult) => {
          if (choiceResult.outcome === 'accepted') {
            dismissPwaBanner();
          }
          deferredPwaPrompt = null;
        });
      } else {
        const modalEl = document.getElementById('pwaInstallModal');
        if (modalEl) {
          const bsModal = new bootstrap.Modal(modalEl);
          bsModal.show();
        }
      }
    }

    function triggerPwaInstallDirect() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then((choiceResult) => {
          if (choiceResult.outcome === 'accepted') {
            dismissPwaBanner();
            const modalEl = document.getElementById('pwaInstallModal');
            if (modalEl) {
              const instance = bootstrap.Modal.getInstance(modalEl);
              if (instance) instance.hide();
            }
          }
          deferredPwaPrompt = null;
        });
      }
    }

    function dismissPwaBanner() {
      const banner = document.getElementById('pwa-install-banner');
      if (banner) banner.style.display = 'none';
      localStorage.setItem('pwa_banner_dismissed', 'true');
    }

    window.addEventListener('appinstalled', () => {
      dismissPwaBanner();
      deferredPwaPrompt = null;
    });

    // Defer service worker registration
    if ('serviceWorker' in navigator) {
      setTimeout(() => {
        navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).catch(() => {});
      }, 1500);
    }

    // Auto-focus input on page load if user is near top
    window.addEventListener('load', () => {
      if (window.scrollY < 400) {
        const phoneInput = document.getElementById('phone');
        if (phoneInput && !('ontouchstart' in window)) {
          phoneInput.focus();
        }
      }
    });

    // Highlight active nav item on scroll
    const sections = document.querySelectorAll('section[id], header[id]');
    const navLinks = document.querySelectorAll('.nav-link');

    window.addEventListener('scroll', () => {
      let current = '';
      sections.forEach(section => {
        const sectionTop = section.offsetTop - 100;
        if (pageYOffset >= sectionTop) {
          current = section.getAttribute('id');
        }
      });

      navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === `#${current}`) {
          link.classList.add('active');
        }
      });
    });
  </script>
</body>

</html>
