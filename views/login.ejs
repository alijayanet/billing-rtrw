              <div class="stat-number"><i class="bi bi-speedometer2 text-info me-1"></i> <%= settings.portal_stat_1_val || '100%' %></div>
              <div class="stat-label"><%= settings.portal_stat_1_label || 'Fiber Optic' %></div>
            </div>
            <div class="stat-item">
              <div class="stat-number"><i class="bi bi-infinity text-success me-1"></i> <%= settings.portal_stat_2_val || 'No FUP' %></div>
              <div class="stat-label"><%= settings.portal_stat_2_label || 'Bebas Kuota' %></div>
            </div>
            <div class="stat-item">
              <div class="stat-number"><i class="bi bi-shield-lock-fill text-warning me-1"></i> <%= settings.portal_stat_3_val || '99.9%' %></div>
              <div class="stat-label"><%= settings.portal_stat_3_label || 'Uptime SLA' %></div>
            </div>
            <div class="stat-item">
              <div class="stat-number"><i class="bi bi-headset text-primary me-1"></i> <%= settings.portal_stat_4_val || '24/7' %></div>
              <div class="stat-label"><%= settings.portal_stat_4_label || 'Bantuan CS' %></div>
            </div>
          </div>
        </div>

        <!-- Right Column: Portal Pelanggan Login Box -->
        <div class="col-lg-5 login-card-container" id="login-section">
          <div class="glass-card shadow-2xl">
            <div class="login-card-header">
              <div class="d-inline-flex align-items-center justify-content-center bg-dark bg-opacity-50 border border-secondary border-opacity-25 rounded-circle p-3 mb-2" style="width:70px; height:70px;">
                <img src="/img/logo.png" alt="Logo" style="width:40px; height:40px; object-fit:contain;" onerror="this.src='/favicon.ico'; this.onerror=null;">
              </div>
              <h4 class="fw-bold mb-1 text-white"><%= t('customer.portal_title', 'Portal Pelanggan') %></h4>
              <p class="small text-white opacity-75 mb-0"><%= settings.company_header || 'Portal Pelanggan' %></p>
            </div>

            <div class="login-card-body">
              <form method="POST" action="/customer/login">
                <div class="form-floating">
                  <input type="text" class="form-control" id="phone" name="phone" placeholder="<%= t('customer.id_tag_placeholder', 'Masukkan ID/Tag Pelanggan') %>" required autofocus>
                  <label for="phone">
                    <i class="bi bi-person-badge me-2"></i><%= t('customer.id_tag', 'ID/Tag Pelanggan / No. HP') %>
                  </label>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3 small" style="color: #cbd5e1;">
                  <span><i class="bi bi-info-circle me-1"></i> Masukkan ID pelanggan / HP</span>
                  <% if (settings.company_phone) { %>
                    <a href="https://wa.me/<%= String(settings.company_phone).replace(/D/g,'') %>?text=<%= encodeURIComponent('Halo CS ' + (settings.company_header || 'Alijaya') + ', saya lupa ID/Tag Pelanggan saya. Mohon bantuannya.') %>" target="_blank" rel="noopener" class="text-decoration-none fw-semibold" style="color:#a5b4fc">
                      Lupa ID?
                    </a>
                  <% } %>
                </div>

                <% if (settings.login_otp_enabled) { %>
                  <div class="alert alert-info py-2 px-3 mb-3 small border-0 bg-info bg-opacity-15 text-info rounded-3 text-center fw-semibold">
                    <i class="bi bi-whatsapp me-1"></i> <%= t('customer.otp_sent_via_wa', 'Kode OTP akan dikirim via WhatsApp') %>
                  </div>
                <% } %>

                <button type="submit" class="btn btn-submit-login">
                  <i class="bi bi-box-arrow-in-right me-2"></i><%= t('customer.sign_in', 'Masuk Ke Portal') %>
                </button>
              </form>

              <% if (error) { %>
                <div class="alert alert-danger mt-3 py-2 px-3 text-center small rounded-3 border-danger border-opacity-25 fw-semibold">
                  <i class="bi bi-exclamation-triangle me-2"></i>
                  <%= error === 'Nomor HP tidak valid atau belum terdaftar.' ? 'ID/Tag tidak valid atau belum terdaftar.' : error %>
                </div>
              <% } %>

              <!-- Fast Tool Shortcuts -->
              <div class="quick-tools-grid">
                <a href="/customer/check-billing" class="btn-quick-tool">
                  <i class="bi bi-receipt text-info fs-5"></i> Cek Tagihan
                </a>
                <a href="/customer/voucher" class="btn-quick-tool">
                  <i class="bi bi-ticket-perforated text-warning fs-5"></i> Beli Voucher
                </a>
              </div>

              <div class="text-center mt-4 pt-2 border-top border-secondary border-opacity-20">
                <p class="mb-0 small" style="color: #cbd5e1;">
                  <%= t('customer.not_subscribed', 'Belum berlangganan?') %>
                  <a href="/customer/register" class="fw-bold text-decoration-none ms-1" style="color: #a5b4fc;">
                    <%= t('customer.register_new', 'Daftar Pemasangan Baru') %> <i class="bi bi-arrow-right"></i>
                  </a>
                </p>
              </div>

            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Internet Packages Section -->
  <section class="section-padding" id="packages">
    <div class="container">
      <div class="text-center">
        <span class="section-title-badge"><i class="bi bi-wifi me-1"></i> Pilihan Paket Internet</span>
        <h2 class="section-title">Paket & Tarif Layanan Kami</h2>
        <p class="section-subtitle">
          Pilih kecepatan koneksi yang sesuai dengan kebutuhan aktivitas digital Anda, dari penggunaan rumah hingga kantor.
        </p>
      </div>

      <% const pkgs = (typeof packages !== 'undefined' && Array.isArray(packages)) ? packages : []; %>
      <% if (pkgs.length === 0) { %>
        <div class="glass-card text-center p-5 max-w-lg mx-auto">
          <i class="bi bi-info-circle fs-1 text-info mb-3 d-block"></i>
          <h5 class="fw-bold text-white">Belum Ada Paket Dipublikasikan</h5>
          <p class="text-muted mb-0">Silakan hubungi customer service kami untuk informasi ketersediaan paket terkini.</p>
        </div>
      <% } else { %>
        <% const list = pkgs.slice().sort((a,b) => Number(a.price||0) - Number(b.price||0)); %>
        <div class="row g-4 justify-content-center">
          <% list.forEach((p, index) => { %>
            <div class="col-md-6 col-lg-4">
              <div class="glass-card pkg-card">
                <% if (index === Math.floor(list.length / 2)) { %>
                  <div class="pkg-badge-popular"><i class="bi bi-star-fill me-1"></i> Terpopuler</div>
                <% } %>

                <div class="pkg-speed-tag">
                  <i class="bi bi-speedometer2 me-1"></i>
                  <% if (Number(p.speed_down||0) > 0) { %>
                    <%= (Math.round(Number(p.speed_down||0)/1000) >= 1) ? Math.round(Number(p.speed_down||0)/1000) + ' Mbps' : Number(p.speed_down||0) + ' Kbps' %>
                  <% } else { %>
                    Speed High-Speed
                  <% } %>
                </div>

                <h3 class="pkg-name"><%= p.name %></h3>

                <div class="pkg-price">
                  Rp <%= Number(p.price||0).toLocaleString('id-ID') %>
                </div>
                <div class="pkg-period">per bulan (sudah termasuk PPN)</div>

                <ul class="pkg-features">
                  <li><i class="bi bi-check-circle-fill"></i> Unlimited Bandwidth tanpa FUP</li>
                  <li><i class="bi bi-check-circle-fill"></i> Koneksi Fiber Optic Dedicated</li>
                  <li><i class="bi bi-check-circle-fill"></i> Latency Rendah & Stabil</li>
                  <li><i class="bi bi-check-circle-fill"></i> Gratis Sewa Modem Router Wi-Fi</li>
                  <li><i class="bi bi-check-circle-fill"></i> Dukungan Teknisi 24/7</li>
                  <% if (p.description) { %>
                    <li style="border:none;"><i class="bi bi-info-circle-fill text-info"></i> <%= p.description %></li>
                  <% } %>
                </ul>

                <a href="/customer/register?package=<%= encodeURIComponent(p.name) %>" class="btn-pkg-action">
                  <i class="bi bi-cart-plus me-1"></i> Pilih Paket Ini
                </a>

                <% if (settings.company_phone) { %>
                  <a href="https://wa.me/<%= String(settings.company_phone).replace(/D/g,'') %>?text=<%= encodeURIComponent('Halo CS ' + (settings.company_header || 'Admin') + ', saya ingin bertanya & berlangganan Paket ' + p.name + ' (Rp ' + Number(p.price||0).toLocaleString('id-ID') + '/bln). Mohon infonya.') %>" target="_blank" rel="noopener" class="btn-pkg-wa">
                    <i class="bi bi-whatsapp"></i> Tanya via WhatsApp
                  </a>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>

