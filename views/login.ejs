<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= settings.company_header || 'Portal ISP' %> | <%= t('customer.login_title', 'Internet Fiber Optic & Portal Pelanggan') %></title>

  <!-- Preconnect to CDN for faster loading -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0f172a">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link rel="icon" href="/img/logo.png">

  <style>
    :root {
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --secondary: #3b82f6;
      --accent: #06b6d4;
      --bg-dark: #0f172a;
      --bg-card: rgba(30, 41, 59, 0.88);
      --bg-card-hover: rgba(30, 41, 59, 0.98);
      --border-color: rgba(148, 163, 184, 0.22);
      --text-light: #ffffff;
      --text-muted-custom: #cbd5e1;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(1200px 600px at 15% 10%, rgba(99, 102, 241, 0.22) 0%, rgba(15, 23, 42, 0) 60%),
        radial-gradient(900px 500px at 85% 40%, rgba(59, 130, 246, 0.18) 0%, rgba(15, 23, 42, 0) 55%),
        radial-gradient(800px 400px at 50% 85%, rgba(6, 182, 212, 0.15) 0%, rgba(15, 23, 42, 0) 50%);
      color: var(--text-light);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-tap-highlight-color: transparent;
      overflow-x: hidden;
    }

    /* Force high contrast text muted on dark backgrounds */
    .text-muted {
      color: #cbd5e1 !important;
    }
    
    .text-secondary {
      color: #94a3b8 !important;
    }

    /* Glassmorphism Classes */
    .glass-card {
      background: var(--bg-card);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border-color);
      border-radius: 20px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease, background 0.3s ease;
    }

    .glass-card:hover {
      background: var(--bg-card-hover);
      border-color: rgba(99, 102, 241, 0.45);
    }

    /* Navbar */
    .custom-navbar {
      background: rgba(15, 23, 42, 0.94);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-color);
      padding: 12px 0;
      transition: all 0.3s ease;
    }

    .navbar-brand img {
      height: 42px;
      width: auto;
      object-fit: contain;
    }

    .nav-link {
      color: #e2e8f0 !important;
      font-weight: 500;
      font-size: 0.95rem;
      padding: 6px 14px !important;
      border-radius: 8px;
      transition: all 0.2s ease;
    }

    .nav-link:hover, .nav-link.active {
      color: #ffffff !important;
      background: rgba(255, 255, 255, 0.12);
    }

    .btn-portal-access {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      color: #fff;
      font-weight: 600;
      border: none;
      border-radius: 12px;
      padding: 8px 18px;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
      transition: all 0.3s ease;
    }

    .btn-portal-access:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 22px rgba(99, 102, 241, 0.5);
      color: #fff;
    }

    /* Live Network Status Badge - High Contrast & Crisp */
    .net-badge-base {
      padding: 6px 14px;
      font-size: 0.85rem;
      letter-spacing: 0.2px;
      transition: all 0.3s ease;
    }
    .net-badge-normal {
      background: rgba(16, 185, 129, 0.16) !important;
      border: 1px solid rgba(52, 211, 153, 0.45) !important;
    }
    .net-badge-normal .net-label {
      color: #6ee7b7 !important; /* Hijau mint cerah, sangat kontras & terbaca */
      font-weight: 700 !important;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }
    .net-badge-normal .pulse-dot {
      background-color: #34d399 !important;
      box-shadow: 0 0 10px #34d399 !important;
    }

    .net-badge-warning {
      background: rgba(245, 158, 11, 0.16) !important;
      border: 1px solid rgba(251, 191, 36, 0.45) !important;
    }
    .net-badge-warning .net-label {
      color: #fde047 !important; /* Kuning cerah */
      font-weight: 700 !important;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }
    .net-badge-warning .pulse-dot {
      background-color: #facc15 !important;
      box-shadow: 0 0 10px #facc15 !important;
    }

    .net-badge-danger {
      background: rgba(239, 68, 68, 0.16) !important;
      border: 1px solid rgba(248, 113, 113, 0.45) !important;
    }
    .net-badge-danger .net-label {
      color: #fca5a5 !important; /* Merah muda cerah */
      font-weight: 700 !important;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }
    .net-badge-danger .pulse-dot {
      background-color: #f87171 !important;
      box-shadow: 0 0 10px #f87171 !important;
    }

    /* Live Network Pulse Dot */
    .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
      animation: pulseAnimation 2s infinite;
      flex-shrink: 0;
    }
    @keyframes pulseAnimation {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.25); opacity: 1; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }

    /* Announcement Banner */
    .portal-announcement-banner {
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      font-size: 0.92rem;
      position: relative;
      z-index: 1020;
    }

    /* Mobile Quick Actions Bar */
    .mobile-action-bar {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-bottom: 24px;
    }

    .mobile-action-item {
      background: rgba(30, 41, 59, 0.85);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 12px 6px;
      text-align: center;
      text-decoration: none;
      color: #ffffff;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }

    .mobile-action-item:hover, .mobile-action-item:active {
      background: rgba(99, 102, 241, 0.3);
      border-color: rgba(99, 102, 241, 0.6);
      color: #ffffff;
      transform: translateY(-2px);
    }

    .mobile-action-item i {
      font-size: 1.35rem;
    }

    .mobile-action-item span {
      font-size: 0.72rem;
      font-weight: 600;
      white-space: nowrap;
    }

    /* Hero Section */
    .hero-section {
      padding: 50px 0 80px;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(99, 102, 241, 0.2);
      border: 1px solid rgba(99, 102, 241, 0.4);
      color: #c7d2fe;
      padding: 6px 16px;
      border-radius: 30px;
      font-size: 0.88rem;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .hero-title {
      font-size: 2.8rem;
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 20px;
      color: #ffffff;
    }

    .hero-subtitle {
      font-size: 1.1rem;
      color: #cbd5e1 !important;
      line-height: 1.7;
      margin-bottom: 30px;
    }

    /* Stats / Highlights */
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 15px;
      margin-top: 30px;
    }

    .stat-item {
      background: rgba(30, 41, 59, 0.65);
      border: 1px solid var(--border-color);
      padding: 12px 16px;
      border-radius: 12px;
      text-align: center;
    }

    .stat-number {
      font-size: 1.25rem;
      font-weight: 700;
      color: #c7d2fe;
    }

    .stat-label {
      font-size: 0.8rem;
      color: #e2e8f0;
      font-weight: 500;
      margin-top: 2px;
    }

    /* Login Box Container */
    .login-card-header {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.3) 0%, rgba(59, 130, 246, 0.2) 100%);
      padding: 24px;
      border-bottom: 1px solid var(--border-color);
      text-align: center;
      border-top-left-radius: 20px;
      border-top-right-radius: 20px;
    }

    .login-card-body {
      padding: 28px 24px;
    }

    .form-floating {
      margin-bottom: 18px;
    }

    .form-control {
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid #475569;
      color: #ffffff;
      border-radius: 12px;
      padding: 14px 18px;
      font-size: 1rem;
      transition: all 0.3s ease;
    }

    .form-control:focus {
      background: rgba(15, 23, 42, 0.95);
      border-color: var(--primary);
      box-shadow: 0 0 0 0.25rem rgba(99, 102, 241, 0.3);
      color: #ffffff;
    }

    .form-floating > label {
      color: #cbd5e1;
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
      color: #c7d2fe;
    }

    .btn-submit-login {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      border: none;
      border-radius: 12px;
      padding: 14px;
      font-size: 1rem;
      font-weight: 600;
      color: #ffffff;
      width: 100%;
      transition: all 0.3s ease;
      box-shadow: 0 8px 20px rgba(99, 102, 241, 0.35);
    }

    .btn-submit-login:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(99, 102, 241, 0.5);
      color: #ffffff;
    }

    .quick-tools-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 18px;
    }

    .btn-quick-tool {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(148, 163, 184, 0.25);
      color: #f1f5f9;
      padding: 12px;
      border-radius: 12px;
      font-size: 0.92rem;
      font-weight: 600;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .btn-quick-tool:hover {
      background: rgba(99, 102, 241, 0.25);
      border-color: rgba(99, 102, 241, 0.6);
      color: #ffffff;
      transform: translateY(-2px);
    }

    /* Section Styling */
    .section-padding {
      padding: 70px 0;
    }

    .section-title-badge {
      display: inline-block;
      background: rgba(59, 130, 246, 0.2);
      border: 1px solid rgba(59, 130, 246, 0.4);
      color: #93c5fd;
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    .section-title {
      font-size: 2.2rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 15px;
    }

    .section-subtitle {
      color: #cbd5e1 !important;
      font-size: 1.05rem;
      max-width: 650px;
      margin: 0 auto 45px;
    }

    /* Package Cards */
    .pkg-card {
      padding: 30px 24px;
      height: 100%;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    .pkg-badge-popular {
      position: absolute;
      top: -14px;
      right: 20px;
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 4px 12px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
    }

    .pkg-speed-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(99, 102, 241, 0.2);
      color: #c7d2fe;
      padding: 4px 14px;
      border-radius: 8px;
      font-size: 0.88rem;
      font-weight: 700;
      margin-bottom: 15px;
      width: fit-content;
    }

    .pkg-name {
      font-size: 1.4rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 8px;
    }

    .pkg-price {
      font-size: 1.9rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 4px;
    }

    .pkg-period {
      font-size: 0.88rem;
      color: #cbd5e1;
      margin-bottom: 20px;
    }

    .pkg-features {
      list-style: none;
      padding: 0;
      margin: 0 0 25px 0;
      flex-grow: 1;
    }

    .pkg-features li {
      padding: 8px 0;
      border-bottom: 1px solid rgba(148, 163, 184, 0.15);
      font-size: 0.95rem;
      color: #e2e8f0;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .pkg-features li i {
      color: #10b981;
      font-size: 1.1rem;
    }

    .btn-pkg-action {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #ffffff;
      border-radius: 12px;
      padding: 12px;
      font-weight: 600;
      text-decoration: none;
      text-align: center;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .btn-pkg-action:hover {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      border-color: transparent;
      color: #ffffff;
      box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4);
    }

    .btn-pkg-wa {
      background: rgba(37, 211, 102, 0.15);
      border: 1px solid rgba(37, 211, 102, 0.35);
      color: #4ade80;
      border-radius: 12px;
      padding: 10px;
      font-weight: 600;
      font-size: 0.9rem;
      text-decoration: none;
      text-align: center;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-top: 8px;
    }

    .btn-pkg-wa:hover {
      background: #25d366;
      border-color: #25d366;
      color: #ffffff;
      box-shadow: 0 6px 18px rgba(37, 211, 102, 0.35);
    }

    /* Features Highlight Cards */
    .feature-box {
      padding: 28px 22px;
      height: 100%;
      border-radius: 18px;
    }

    .feature-icon-wrapper {
      width: 54px;
      height: 54px;
      border-radius: 14px;
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.3) 0%, rgba(6, 182, 212, 0.2) 100%);
      border: 1px solid rgba(99, 102, 241, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      color: #c7d2fe;
      margin-bottom: 20px;
    }

    .feature-title {
      font-size: 1.18rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 10px;
    }

    .feature-desc {
      color: #cbd5e1 !important;
      font-size: 0.94rem;
      line-height: 1.6;
      margin: 0;
    }

    /* Contact & Quick Service Info Cards */
    .info-card {
      padding: 24px;
      border-radius: 16px;
      display: flex;
      align-items: flex-start;
      gap: 16px;
      height: 100%;
      transition: all 0.3s ease;
    }

    .info-card h5 {
      color: #ffffff !important;
      font-weight: 700;
      font-size: 1.1rem;
    }

    .info-card p, .info-card .card-text-desc {
      color: #cbd5e1 !important;
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .info-card-link:hover .info-card {
      transform: translateY(-4px);
      background: rgba(30, 41, 59, 0.98);
      border-color: rgba(99, 102, 241, 0.5);
      box-shadow: 0 12px 30px rgba(99, 102, 241, 0.25);
    }

    .info-icon {
      font-size: 1.8rem;
      color: #c7d2fe;
      background: rgba(99, 102, 241, 0.2);
      border: 1px solid rgba(99, 102, 241, 0.3);
      width: 50px;
      height: 50px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    /* Floating WhatsApp Button */
    .floating-wa-btn {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #25d366;
      color: #ffffff !important;
      border-radius: 50px;
      padding: 12px 20px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.95rem;
      font-weight: 600;
      box-shadow: 0 10px 25px rgba(37, 211, 102, 0.4);
      z-index: 999;
      text-decoration: none;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .floating-wa-btn:hover {
      transform: translateY(-3px) scale(1.03);
      box-shadow: 0 14px 30px rgba(37, 211, 102, 0.55);
      color: #ffffff;
    }

    /* Social Media Pills */
    .social-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(30, 41, 59, 0.7);
      border: 1px solid var(--border-color);
      color: #e2e8f0;
      padding: 6px 14px;
      border-radius: 30px;
      font-size: 0.88rem;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .social-pill:hover {
      background: rgba(99, 102, 241, 0.25);
      border-color: rgba(99, 102, 241, 0.5);
      color: #ffffff;
      transform: translateY(-2px);
    }

    /* Footer */
    .site-footer {
      background: #070a12;
      border-top: 1px solid var(--border-color);
      padding: 60px 0 30px;
      margin-top: 60px;
    }

    .footer-brand img {
      height: 40px;
      margin-bottom: 15px;
    }

    .footer-links {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .footer-links li {
      margin-bottom: 10px;
    }

    .footer-links a {
      color: #cbd5e1;
      text-decoration: none;
      font-size: 0.94rem;
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: #c7d2fe;
    }

    .footer-bottom {
      border-top: 1px solid rgba(148, 163, 184, 0.15);
      margin-top: 40px;
      padding-top: 25px;
      font-size: 0.9rem;
      color: #cbd5e1;
    }

    /* Responsive Improvements */
    @media (max-width: 991.98px) {
      .hero-title {
        font-size: 2.2rem;
      }
      .hero-section {
        padding: 25px 0 50px;
      }
      .login-card-container {
        margin-top: 35px;
      }
      .section-title {
        font-size: 1.8rem;
      }
    }

    @media (max-width: 575.98px) {
      .hero-title {
        font-size: 1.8rem;
      }
      .login-card-body {
        padding: 20px 16px;
      }
      .quick-tools-grid {
        grid-template-columns: 1fr;
      }
      .hero-stats {
        grid-template-columns: 1fr 1fr;
      }
      .floating-wa-btn span {
        display: none;
      }
      .floating-wa-btn {
        padding: 12px 14px;
        border-radius: 50%;
      }
    }
  </style>
</head>

<body>

  <% 
    // Status Jaringan Dinamis
    const netStatus = settings.portal_network_status || 'normal';
    let netBadgeClass = 'net-badge-normal';
    let netDefaultText = 'Semua Layanan Jaringan Normal';
    if (netStatus === 'maintenance') {
      netBadgeClass = 'net-badge-warning';
      netDefaultText = 'Pemeliharaan Jaringan Terjadwal';
    } else if (netStatus === 'issue') {
      netBadgeClass = 'net-badge-danger';
      netDefaultText = 'Sedang Ada Kendala Teknis';
    }
    const netText = (settings.portal_network_status_text || '').trim() || netDefaultText;
  %>

  <!-- Header / Navbar Section -->
  <nav class="navbar navbar-expand-lg sticky-top custom-navbar">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="#">
        <img src="/img/logo.png" alt="Logo" onerror="this.style.display='none'">
        <span class="fw-bold fs-5 text-white"><%= settings.company_header || 'Portal ISP' %></span>
      </a>

      <!-- Network Status Badge in Navbar (Desktop) -->
      <div class="d-none d-lg-inline-flex align-items-center gap-2 rounded-pill net-badge-base ms-2 <%= netBadgeClass %>">
        <span class="pulse-dot"></span>
        <span class="net-label"><%= netText %></span>
      </div>

      <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
        <i class="bi bi-list fs-2"></i>
      </button>

      <div class="collapse navbar-collapse" id="navbarContent">
        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
          <li class="nav-item">
            <a class="nav-link active" href="#hero"><i class="bi bi-house-door me-1"></i> Beranda</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#packages"><i class="bi bi-wifi me-1"></i> Paket & Tarif</a>
          </li>
          <li class="nav-item">
