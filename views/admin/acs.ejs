<!DOCTYPE html>
<html lang="<%= (typeof lang !== 'undefined' ? lang : 'id') %>">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
    <title>GenieACS Pro | <%= company %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .stats-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:20px; margin-bottom:30px; }
        .stat-card { background:var(--card-bg); border:1px solid var(--border); border-radius:18px; padding:24px; display:flex; align-items:center; gap:20px; cursor:pointer; transition:all 0.3s; position:relative; overflow:hidden; }
        .stat-card:hover { transform:translateY(-5px); border-color:var(--primary); background:var(--sidebar-bg); }
        .stat-card::after { content:''; position:absolute; left:0; top:0; height:100%; width:4px; background:var(--card-color); }
        .stat-icon { width:52px; height:52px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:24px; background:var(--sub-bg); color:var(--card-color); }
        .stat-info h3 { font-size:28px; font-weight:800; margin:0; line-height:1; }
        .stat-info p { font-size:13px; color:var(--muted); margin:8px 0 0; }

        .acs-box { background:var(--card-bg); border:1px solid var(--border); border-radius:22px; overflow:hidden; }
        .tab-bar { display:flex; background:var(--sub-bg); border-bottom:1px solid var(--border); }
        .tab-bar button { padding:18px 25px; background:none; border:none; color:var(--muted); font-weight:600; cursor:pointer; transition:all 0.3s; border-bottom:3px solid transparent; display:flex; align-items:center; gap:8px; font-size:14px; }
        .tab-bar button.active { color:var(--primary); border-bottom-color:var(--primary); background:rgba(59,130,246,0.05); }

        .tab-pane { padding:20px 16px; display:none; animation:fadeIn 0.4s ease; }
        .tab-pane.active { display:block; }
        @keyframes fadeIn { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }

        .table-container { width:100%; overflow-x:auto; }
        table { width:100%; border-collapse:collapse; }
        th { background:var(--sub-bg); color:var(--muted); font-weight:700; font-size:11px; text-transform:uppercase; letter-spacing:0.5px; padding:10px 8px; text-align:left; white-space:nowrap; }
        td { padding:8px 8px; border-bottom:1px solid var(--border); font-size:12px; color:var(--text); vertical-align:middle; }
        tr:hover td { background:var(--hover-bg); }

        .status-badge { padding:3px 8px; border-radius:12px; font-size:10px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:4px; text-transform:uppercase; min-width:38px; }
        .status-up { background:rgba(16,185,129,0.12); color:#10B981; border:1px solid rgba(16,185,129,0.25); }
        .status-down { background:rgba(239,68,68,0.12); color:#EF4444; border:1px solid rgba(239,68,68,0.25); }

        .btn-action { width:28px; height:28px; border-radius:6px; display:inline-flex; align-items:center; justify-content:center; border:1px solid var(--border); background:var(--sub-bg); color:var(--muted); cursor:pointer; transition:all 0.2s; font-size:11px; }
        .btn-action:hover { background:var(--primary); color:white; border-color:var(--primary); transform:scale(1.08); }
        .btn-action.danger:hover { background:var(--danger); border-color:var(--danger); }
        .btn-action:disabled { opacity:0.5; cursor:not-allowed; }
        .btn-action:disabled:hover { background:var(--sub-bg); color:var(--muted); border-color:var(--border); transform:none; }

        .acs-server-tag { display:inline-flex; align-items:center; gap:4px; padding:2px 7px; border-radius:5px; font-size:10px; font-weight:600; background:rgba(59,130,246,0.1); color:var(--primary); border:1px solid rgba(59,130,246,0.2); white-space:nowrap; }
        .acs-server-tag.offline { background:rgba(239,68,68,0.1); color:#EF4444; border-color:rgba(239,68,68,0.2); }

        .modal-overlay { position:fixed; inset:0; background:var(--overlay-bg); backdrop-filter:blur(6px); display:none; align-items:center; justify-content:center; z-index:2000; padding:20px; }
        .modal-card { background:var(--sidebar-bg); border:1px solid var(--border); border-radius:24px; width:100%; max-width:500px; padding:30px; }

        .device-link { text-decoration: none; display: block; transition: all 0.2s; }
        .device-link:hover { opacity: 0.8; }
        .device-link:hover div:first-child { text-decoration: underline; }

        .bind-tag { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 10px; border: 1px solid var(--border); border-radius: 10px; background: var(--card-bg); font-size: 12px; font-weight: 700; cursor: pointer; text-align: center; transition: all 0.2s; color: var(--text); }
        .bind-tag:hover { border-color: var(--primary); background: var(--hover-bg); }
        .bind-tag.active { background: var(--primary) !important; color: white !important; border-color: var(--primary) !important; box-shadow: 0 4px 12px rgba(59,130,246,0.2); }
    </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'acs_pro', company }) %>
<div class="mw">
    <div class="topbar">
        <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-hdd-network"></i> GenieACS Monitoring Pro</div>
        <div class="tb-right">
            <span class="adm-badge" style="font-size:12px;opacity:0.7;"><%= company %></span>
            <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? 'Kasir' : 'Admin' %></span>
            <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
        </div>
    </div>
    <div class="page">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:30px;">
            <h1 class="page-title" style="margin:0;">GenieACS Monitoring</h1>
            <button class="btn btn-p" onclick="syncAllACS()">
                <i class="fas fa-sync-alt"></i> Sync All ACS
            </button>
        </div>

        <div class="stats-grid">
            <div class="stat-card" style="--card-color: var(--primary)">
                <div class="stat-icon"><i class="fas fa-microchip"></i></div>
                <div class="stat-info">
                    <h3><%= devices.length %></h3>
                    <p>Total Devices</p>
                </div>
            </div>
            <div class="stat-card" style="--card-color: #10B981">
                <div class="stat-icon"><i class="fas fa-wifi"></i></div>
                <div class="stat-info">
                    <h3><%= devices.filter(d => d.isOnline).length %></h3>
                    <p>Online</p>
                </div>
            </div>
        </div>

        <div class="acs-box">
            <div class="tab-bar">
                <button class="active" onclick="switchTab('devices', this)"><i class="fas fa-desktop"></i> Devices</button>
                <button onclick="switchTab('servers', this)"><i class="fas fa-server"></i> ACS Servers</button>
            </div>

            <div id="tab-devices" class="tab-pane active">
                <form action="/admin/acs/search" method="GET" class="srow">
                    <div class="sinput" style="max-width:340px">
                        <i class="bi bi-search"></i>
                        <input class="fc" name="q" value="<%= (typeof searchQuery !== 'undefined' && searchQuery) ? searchQuery : '' %>" placeholder="Cari SN, Pelanggan, PPPoE, SSID, IP...">
                    </div>
                    <select class="fs" id="acsFilter" name="acs" style="width:200px" onchange="this.form.submit()">
                        <option value="all">All ACS Servers</option>
                        <% acsServers.forEach(s => { %>
                            <option value="<%= s.id %>" <%= String(selectedAcsId) === String(s.id) ? 'selected' : '' %>><%= s.name %></option>
                        <% }); %>
                    </select>
                    <button class="btn btn-g btn-sm" type="submit"><i class="bi bi-search"></i> Cari</button>
                    <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                        <a href="/admin/acs<%= selectedAcsId ? '?acs=' + selectedAcsId : '' %>" class="btn btn-g btn-sm"><i class="bi bi-x"></i> Reset</a>
                    <% } %>
                </form>
                
                <!-- Bulk Actions Panel -->
                <div id="bulkActionsPanel" style="display: none; background: rgba(59,130,246,0.05); border: 1px solid rgba(59,130,246,0.15); padding: 12px 20px; border-radius: 12px; margin-bottom: 20px; align-items: center; justify-content: space-between;">
                    <div style="font-size: 13px; font-weight: 600; color: var(--text);">
                        <span id="selectedCount">0</span> perangkat terpilih
                    </div>
                    <div style="display: flex; gap: 10px;">
                        <button class="btn btn-p btn-sm" onclick="bulkSummon()" style="background: var(--primary);"><i class="fas fa-sync-alt"></i> Summon Terpilih</button>
                        <button class="btn btn-d btn-sm" onclick="bulkDelete()" style="background: var(--danger);"><i class="fas fa-trash"></i> Hapus Terpilih</button>
                    </div>
                </div>

                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th style="width: 32px;"><input type="checkbox" id="selectAllDevices" onchange="toggleSelectAll(this)"></th>
                                <th style="white-space:nowrap;">Perangkat</th>
                                <th>Pelanggan</th>
                                <th style="white-space:nowrap;">PPPoE</th>
                                <th style="white-space:nowrap;">IP WAN</th>
                                <th style="white-space:nowrap;">Wi-Fi (SSID)</th>
                                <th style="white-space:nowrap;">Redaman (RX)</th>
                                <th style="white-space:nowrap;">Uptime</th>
                                <th style="text-align:center; white-space:nowrap;">Status</th>
                                <th style="white-space:nowrap;">Server</th>
                                <th style="text-align:center; width:125px; white-space:nowrap;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (devices.length === 0) { %>
                            <tr>
                                <td colspan="11" class="text-center text-muted" style="padding: 30px;">
                                    <i class="bi bi-inbox" style="font-size: 28px; display:block; margin-bottom: 8px;"></i>
                                    Tidak ada perangkat ONU ditemukan.
                                </td>
                            </tr>
                            <% } %>
                            <% devices.forEach(d => { %>
                            <tr>
                                <td>
                                    <input type="checkbox" class="device-checkbox" data-id="<%= d.id %>" data-acs="<%= d.acs_server_id || selectedAcsId %>" onchange="updateBulkPanel()">
                                </td>
                                <td>
                                    <% 
                                      let devName = '-';
                                      if (d.model && d.model !== '-') {
                                        devName = (d.manufacturer && d.manufacturer !== '-' && !d.model.toLowerCase().includes(d.manufacturer.toLowerCase()) ? d.manufacturer + ' ' : '') + d.model;
                                      } else if (d.manufacturer && d.manufacturer !== '-') {
                                        devName = d.manufacturer;
                                      } else if (d.sn && d.sn !== '-') {
                                        devName = d.sn;
                                      }
                                    %>
                                    <a href="/admin/acs/device/<%= encodeURIComponent(d.id) %>?acsId=<%= d.acs_server_id || selectedAcsId %>" class="device-link" title="SN: <%= d.sn %> (<%= d.manufacturer %> <%= d.model %>)">
                                        <div style="font-weight:700; color:var(--primary); font-size:12px; white-space:nowrap;"><%= devName %></div>
                                    </a>
                                </td>
                                <td>
                                    <% if (d.customer_name && d.customer_name !== '-') { %>
                                        <div style="font-weight:700; color:var(--text); font-size:12px; max-width:130px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="<%= d.customer_name %>">
                                            <% if (d.customer_id) { %>
                                                <a href="/admin/customers?q=<%= encodeURIComponent(d.customer_name) %>" style="color:inherit; text-decoration:none;" title="Lihat Data Pelanggan">
                                                    <i class="bi bi-person-fill text-primary me-1"></i><%= d.customer_name %>
                                                </a>
                                            <% } else { %>
                                                <i class="bi bi-person-fill text-primary me-1"></i><%= d.customer_name %>
                                            <% } %>
                                        </div>
                                    <% } else { %>
                                        <span class="text-muted" style="font-size:11px;">-</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (d.pppoe_user && d.pppoe_user !== '-') { %>
                                        <code style="font-weight:600; font-size:11px; max-width:105px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:inline-block;" title="<%= d.pppoe_user %>"><%= d.pppoe_user %></code>
                                    <% } else { %>
                                        <span class="text-muted" style="font-size:11px;">-</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% const devIp = d.ip || d.pppoe_ip; %>
                                    <% if (devIp && devIp !== '-' && devIp !== '0.0.0.0') { %>
                                        <code style="color:var(--text); font-size:11px; white-space:nowrap;"><%= devIp %></code>
                                    <% } else { %>
                                        <span class="text-muted" style="font-size:11px;">-</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% 
                                      const strSsid = (typeof d.wlan_ssid === 'object' && d.wlan_ssid !== null) ? String(d.wlan_ssid._value || '') : String(d.wlan_ssid || '');
                                      const strCustName = (typeof d.customer_name === 'object' && d.customer_name !== null) ? String(d.customer_name.name || d.customer_name._value || '') : String(d.customer_name || '');
                                      const strPppoe = (typeof d.pppoe_user === 'object' && d.pppoe_user !== null) ? String(d.pppoe_user._value || '') : String(d.pppoe_user || '');

                                      const safeSsid = (strSsid && strSsid !== '-' && strSsid !== '[object Object]') ? strSsid.replace(/'/g, "\\'") : '';
                                      const safeCustName = (strCustName && strCustName !== '-' && strCustName !== '[object Object]') ? strCustName.replace(/'/g, "\\'") : '';
                                      const safePppoe = (strPppoe && strPppoe !== '-' && strPppoe !== '[object Object]') ? strPppoe.replace(/'/g, "\\'") : '';
                                      const hasSsid = (strSsid && strSsid !== '-' && strSsid !== '[object Object]');
                                    %>
                                    <% if (hasSsid) { %>
                                        <div style="font-weight:600; font-size:11px; color:var(--text); max-width:115px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="Klik untuk ubah SSID / Password WiFi (<%= strSsid %>)">
                                            <a href="javascript:void(0)" onclick="openWifiModal('<%= d.id %>', '<%= safeSsid %>', '<%= d.sn %>', '<%= safeCustName %>', '<%= safePppoe %>')" style="color:inherit; text-decoration:none; display:inline-flex; align-items:center; gap:3px;">
                                                <i class="bi bi-wifi text-primary"></i>
                                                <span><%= strSsid %></span>
                                                <i class="bi bi-pencil-square text-primary" style="font-size:10px; margin-left:2px;" title="Ubah Wi-Fi"></i>
                                            </a>
                                        </div>
                                        <% if (d.connected_clients !== null && d.connected_clients !== undefined) { %>
                                            <span style="font-size:10px; color:var(--muted);"><i class="bi bi-people me-1"></i><%= d.connected_clients %> klien</span>
                                        <% } %>
                                    <% } else { %>
                                        <button type="button" class="btn btn-g btn-sm" style="padding:2px 6px; font-size:10px; font-weight:600;" onclick="openWifiModal('<%= d.id %>', '', '<%= d.sn %>', '<%= safeCustName %>', '<%= safePppoe %>')" title="Atur SSID & Password">
                                            <i class="bi bi-wifi me-1"></i>Set Wi-Fi
                                        </button>
                                    <% } %>
                                </td>
                                <td>
                                    <% 
                                      let rxText = d.rx_power;
                                      let isLos = (rxText === 'LOS' || rxText === '0' || rxText === '0.00');
                                      const rxNum = parseFloat(rxText);
                                      let rxColor = 'var(--text)';
                                      let rxIcon = 'bi-reception-4';
                                      if (!isLos && !isNaN(rxNum)) {
                                        if (rxNum >= -24 && rxNum <= -13) {
                                          rxColor = '#10b981'; // Bagus (Hijau)
                                          rxIcon = 'bi-reception-4';
                                        } else if (rxNum < -24 && rxNum >= -27) {
                                          rxColor = '#f59e0b'; // Sedang / Waspada (Kuning/Orange)
                                          rxIcon = 'bi-reception-2';
                                        } else {
                                          rxColor = '#ef4444'; // Buruk / Kritis (Merah)
                                          rxIcon = 'bi-reception-1';
                                        }
                                      }
                                    %>
                                    <% if (isLos) { %>
                                        <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); font-weight:700; font-size:10px; padding:2px 5px;">
                                            <i class="bi bi-exclamation-triangle me-1"></i>LOS
                                        </span>
                                    <% } else if (rxText && rxText !== '-') { %>
                                        <span style="font-weight:700; font-size:11px; white-space:nowrap; color:<%= rxColor %>;">
                                            <i class="bi <%= rxIcon %> me-1"></i><%= rxText %> dBm
                                        </span>
                                    <% } else { %>
                                        <span class="text-muted" style="font-size:11px;">-</span>
                                    <% } %>
                                </td>
                                <td>
                                    <span style="font-size:11px; color:var(--muted); white-space:nowrap;"><%= d.uptime || '-' %></span>
                                </td>
                                <td style="text-align: center;">
                                    <span class="status-badge <%= d.isOnline ? 'status-up' : 'status-down' %>">
                                        <%= d.isOnline ? 'ON' : 'OFF' %>
                                    </span>
                                </td>
                                <td><span class="acs-server-tag"><%= d.acs_server_name %></span></td>
                                <td style="text-align: center;">
                                    <div style="display:inline-flex; align-items:center; gap:4px; white-space:nowrap;">
                                        <button class="btn-action" onclick="refreshDevice('<%= d.id %>')" title="Summon / Refresh Device"><i class="fas fa-sync"></i></button>
                                        <button class="btn-action" onclick="openAddWanModal('<%= d.id %>', '<%= d.acs_server_id || selectedAcsId %>', '<%= d.sn %>', '<%= d.manufacturer || "" %>', '<%= d.model || "" %>')" title="Add WAN All-in-One"><i class="fas fa-network-wired"></i></button>
                                        <a href="/admin/acs/device/<%= encodeURIComponent(d.id) %>?acsId=<%= d.acs_server_id || selectedAcsId %>" class="btn-action" title="Detail Perangkat"><i class="fas fa-eye"></i></a>
                                        <button class="btn-action danger" onclick="deleteDevice('<%= d.id %>', '<%= d.acs_server_id || selectedAcsId %>')" title="Hapus Perangkat"><i class="fas fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div id="tab-servers" class="tab-pane">
                <div style="display:flex; justify-content:space-between; margin-bottom:20px;">
                    <h3>ACS Servers</h3>
                    <button class="btn btn-p btn-sm" onclick="openAddServerModal()"><i class="bi bi-plus-lg"></i> Add ACS Server</button>
                </div>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>URL</th>
                                <th>Location</th>
                                <th>Devices</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% acsServers.forEach(s => { %>
                            <tr>
                                <td><%= s.name %></td>
                                <td><code><%= s.url %></code></td>
                                <td><%= s.location %></td>
                                <td><%= s.device_count %></td>
                                <td>
                                    <% if (String(s.id) === 'builtin') { %>
                                        <div style="display:flex;align-items:center;gap:8px">
                                            <span style="display:inline-flex;align-items:center;gap:4px;background:#e0e7ff;color:#3730a3;font-size:11px;padding:3px 8px;border-radius:4px;font-weight:600;"><i class="bi bi-shield-check"></i> Built-in (Aktif)</span>
                                        </div>
                                    <% } else if (String(s.id) !== 'legacy') { %>
                                        <div style="display:flex;align-items:center;gap:8px">
                                            <button
                                                class="btn-action"
                                                type="button"
                                                onclick="openEditServerModal(this)"
                                                title="Edit"
                                                data-id="<%= s.id %>"
                                                data-name="<%= s.name %>"
                                                data-url="<%= s.url %>"
                                                data-username="<%= s.username || '' %>"
                                                data-location="<%= s.location || '' %>"
                                            >
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn-action danger" type="button" onclick="deleteServer('<%= s.id %>')" title="Hapus">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    <% } else { %>
                                        <div style="display:flex;align-items:center;gap:8px">
                                            <button
                                                class="btn-action"
                                                type="button"
                                                onclick="openEditLegacyAcsModal()"
                                                title="Edit Default ACS"
                                            >
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn-action danger" type="button" disabled title="Default ACS tidak bisa dihapus">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    <% } %>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <footer style="margin-top: 30px; padding: 20px; text-align: center; color: var(--muted); font-size: 12px; border-top: 1px solid var(--border);">
            &copy; <%= new Date().getFullYear() %> <%= (typeof settings !== 'undefined' ? settings.company_header : 'ALIJAYA NET') %> - GenieACS Pro
        </footer>
    </div>
</div>

<!-- Modal Kelola Wi-Fi ONU (SSID & Password Terpisah) -->
<div class="mo" id="wifiModal">
  <div class="mb" style="max-width:480px">
    <div class="mh">
      <span class="mt"><i class="bi bi-wifi text-primary me-2"></i>Kelola Wi-Fi ONU</span>
      <button class="mc" onclick="closeModal('wifiModal')">&times;</button>
    </div>
    <div class="mbody">
      <div style="background:var(--sub-bg); padding:10px 14px; border-radius:10px; margin-bottom:15px; border:1px solid var(--border); font-size:12px;">
        <div style="display:flex; justify-content:space-between; margin-bottom:3px;">
          <span style="color:var(--muted)">Pelanggan:</span>
          <strong id="modalWifiCustomer" style="color:var(--text);">-</strong>
        </div>
        <div style="display:flex; justify-content:space-between; margin-bottom:3px;">
          <span style="color:var(--muted)">PPPoE User:</span>
          <code id="modalWifiPppoe" style="color:var(--primary); font-weight:700;">-</code>
        </div>
        <div style="display:flex; justify-content:space-between;">
          <span style="color:var(--muted)">SN / Device ID:</span>
          <span id="modalWifiDeviceSn" style="font-family:monospace; font-size:11px; color:var(--muted);">-</span>
        </div>
      </div>

      <input type="hidden" id="modalWifiDeviceId">
      <input type="hidden" id="modalWifiPppoeUser">

      <!-- Form 1: Ubah Nama WiFi (SSID) -->
      <div style="background:var(--card-bg); border:1px solid var(--border); border-radius:12px; padding:14px; margin-bottom:14px;">
        <label style="display:block; font-size:12px; font-weight:700; margin-bottom:6px; color:var(--text);">
          <i class="bi bi-broadcast text-primary me-1"></i>Nama Wi-Fi (SSID)
        </label>
        <div style="display:flex; gap:8px;">
          <input type="text" id="modalWifiSsid" class="fc" placeholder="Nama WiFi (SSID) baru..." style="flex:1; font-size:13px;">
          <button type="button" id="btnSaveSsid" class="btn btn-p" onclick="submitChangeSsid()" style="font-size:12px; padding:8px 14px; white-space:nowrap;">
            <span class="btn-text"><i class="bi bi-check-lg me-1"></i>Simpan SSID</span>
            <span class="btn-loader" style="display:none;"><i class="fas fa-spinner fa-spin"></i></span>
          </button>
        </div>
        <div style="font-size:11px; color:var(--muted); margin-top:5px;">
          Minimal 2 karakter. Klik "Simpan SSID" untuk mengirim nama WiFi baru ke modem.
        </div>
      </div>

      <!-- Form 2: Ubah Sandi WiFi (Password) -->
      <div style="background:var(--card-bg); border:1px solid var(--border); border-radius:12px; padding:14px; margin-bottom:16px;">
        <label style="display:block; font-size:12px; font-weight:700; margin-bottom:6px; color:var(--text);">
          <i class="bi bi-key-fill text-warning me-1"></i>Sandi Wi-Fi (Password)
        </label>
        <div style="display:flex; gap:8px;">
          <div style="position:relative; flex:1;">
            <input type="password" id="modalWifiPassword" class="fc" placeholder="Sandi baru (min 8 karakter)..." style="width:100%; font-size:13px; padding-right:34px;">
            <i class="bi bi-eye" id="toggleWifiPass" onclick="toggleWifiPassVisibility()" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); cursor:pointer; color:var(--muted); font-size:14px;"></i>
          </div>
          <button type="button" id="btnSavePassword" class="btn btn-s" onclick="submitChangePassword()" style="font-size:12px; padding:8px 14px; white-space:nowrap; background:#10b981; color:white;">
            <span class="btn-text"><i class="bi bi-check-lg me-1"></i>Simpan Sandi</span>
            <span class="btn-loader" style="display:none;"><i class="fas fa-spinner fa-spin"></i></span>
          </button>
        </div>
        <div style="font-size:11px; color:var(--muted); margin-top:5px;">
          Minimal 8 karakter WPA2/WPA3. Klik "Simpan Sandi" untuk memperbarui password di modem.
        </div>
      </div>

      <div style="display:flex; justify-content:flex-end;">
        <button type="button" class="btn btn-g" onclick="closeModal('wifiModal')" style="font-size:12px; padding:8px 16px;">Tutup</button>
      </div>
    </div>
  </div>
</div>

<!-- Unified Add WAN All-in-One Modal -->
<div class="mo" id="addWanModal">
  <div class="mb" style="max-width:650px">
    <div class="mh">
      <span class="mt"><i class="fas fa-network-wired"></i> Provisioning All-in-One WAN</span>
      <button class="mc" onclick="closeModal('addWanModal')">&times;</button>
    </div>
    <div class="mbody" style="max-height: 70vh; overflow-y: auto; padding-right: 10px;">
      <form id="addWanForm" onsubmit="submitAddWanForm(event)">
        <input type="hidden" id="wanDeviceId" value="">
        <input type="hidden" id="wanAcsId" value="">
        
        <div style="background: var(--sub-bg); padding: 15px; border-radius: 12px; margin-bottom: 20px; border: 1px dashed var(--border);">
