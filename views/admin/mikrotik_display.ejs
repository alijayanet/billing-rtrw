<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= title %> | <%= company %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <style>
    :root, [data-theme="cyberpunk"] {
      --bg: #060813;
      --bg-surface: #0b0f1f;
      --card-bg: rgba(13, 18, 36, 0.78);
      --card-border: rgba(255, 255, 255, 0.08);
      --card-border-hover: rgba(59, 130, 246, 0.35);
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      
      --cyan: #00f2fe;
      --cyan-glow: rgba(0, 242, 254, 0.22);
      --emerald: #10b981;
      --emerald-glow: rgba(16, 185, 129, 0.22);
      --blue: #3b82f6;
      --blue-glow: rgba(59, 130, 246, 0.22);
      --purple: #8b5cf6;
      --purple-glow: rgba(139, 92, 246, 0.22);
      --amber: #f59e0b;
      --amber-glow: rgba(245, 158, 11, 0.22);
      --rose: #f43f5e;
      --rose-glow: rgba(244, 63, 94, 0.22);
      --tech-corner: #00f2fe;
    }

    [data-theme="matrix"] {
      --bg: #020d06;
      --bg-surface: #051a0d;
      --card-bg: rgba(6, 28, 15, 0.82);
      --card-border: rgba(0, 255, 102, 0.18);
      --card-border-hover: rgba(0, 255, 102, 0.45);
      --cyan: #00ff66;
      --cyan-glow: rgba(0, 255, 102, 0.22);
      --emerald: #39ff14;
      --emerald-glow: rgba(57, 255, 20, 0.22);
      --blue: #00e676;
      --blue-glow: rgba(0, 230, 118, 0.22);
      --purple: #10b981;
      --purple-glow: rgba(16, 185, 129, 0.22);
      --amber: #ffd700;
      --amber-glow: rgba(255, 215, 0, 0.22);
      --rose: #ff3366;
      --rose-glow: rgba(255, 51, 102, 0.22);
      --tech-corner: #00ff66;
    }

    [data-theme="sapphire"] {
      --bg: #03091e;
      --bg-surface: #06133d;
      --card-bg: rgba(9, 24, 66, 0.82);
      --card-border: rgba(0, 162, 255, 0.18);
      --card-border-hover: rgba(0, 162, 255, 0.45);
      --cyan: #00a2ff;
      --cyan-glow: rgba(0, 162, 255, 0.25);
      --emerald: #00f0ff;
      --emerald-glow: rgba(0, 240, 255, 0.25);
      --blue: #3b82f6;
      --blue-glow: rgba(59, 130, 246, 0.25);
      --purple: #818cf8;
      --purple-glow: rgba(129, 140, 248, 0.25);
      --amber: #f59e0b;
      --amber-glow: rgba(245, 158, 11, 0.22);
      --rose: #f43f5e;
      --rose-glow: rgba(244, 63, 94, 0.22);
      --tech-corner: #00a2ff;
    }

    [data-theme="amoled"] {
      --bg: #000000;
      --bg-surface: #0a0a0c;
      --card-bg: rgba(16, 16, 18, 0.90);
      --card-border: rgba(255, 255, 255, 0.12);
      --card-border-hover: rgba(0, 229, 255, 0.5);
      --cyan: #00e5ff;
      --cyan-glow: rgba(0, 229, 255, 0.25);
      --emerald: #30d158;
      --emerald-glow: rgba(48, 209, 88, 0.25);
      --blue: #0a84ff;
      --blue-glow: rgba(10, 132, 255, 0.25);
      --purple: #bf5af2;
      --purple-glow: rgba(191, 90, 242, 0.25);
      --amber: #ffd60a;
      --amber-glow: rgba(255, 214, 10, 0.25);
      --rose: #ff453a;
      --rose-glow: rgba(255, 69, 58, 0.25);
      --tech-corner: #00e5ff;
    }

    [data-theme="amber"] {
      --bg: #0d0a04;
      --bg-surface: #1a1408;
      --card-bg: rgba(36, 26, 10, 0.82);
      --card-border: rgba(255, 170, 0, 0.20);
      --card-border-hover: rgba(255, 170, 0, 0.5);
      --cyan: #ffaa00;
      --cyan-glow: rgba(255, 170, 0, 0.25);
      --emerald: #ffd700;
      --emerald-glow: rgba(255, 215, 0, 0.25);
      --blue: #f59e0b;
      --blue-glow: rgba(245, 158, 11, 0.25);
      --purple: #fbbf24;
      --purple-glow: rgba(251, 191, 36, 0.25);
      --amber: #f97316;
      --amber-glow: rgba(249, 115, 22, 0.25);
      --rose: #ef4444;
      --rose-glow: rgba(239, 68, 68, 0.25);
      --tech-corner: #ffaa00;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100vh;
      max-height: 100vh;
      overflow: hidden;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      background-image: 
        radial-gradient(circle at 15% 15%, rgba(0, 242, 254, 0.04) 0%, transparent 40%),
        radial-gradient(circle at 85% 20%, rgba(59, 130, 246, 0.04) 0%, transparent 45%),
        linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 32px 32px, 32px 32px;
      color: var(--text);
      -webkit-font-smoothing: antialiased;
    }

    /* ZERO-SCROLL NOC VIEWPORT CONTAINER */
    .noc-container {
      height: 100vh;
      max-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 8px 12px;
      gap: 8px;
      box-sizing: border-box;
      overflow: hidden;
      max-width: 1920px;
      margin: 0 auto;
    }

    /* TOP HEADER (COMPACT 40px) */
    .noc-header {
      height: 42px;
      min-height: 42px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      padding: 4px 14px;
      border-radius: 10px;
      backdrop-filter: blur(14px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
      flex-shrink: 0;
    }

    .brand-section {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-icon-box {
      width: 30px;
      height: 30px;
      border-radius: 7px;
      background: linear-gradient(135deg, rgba(0, 242, 254, 0.2), rgba(59, 130, 246, 0.2));
      border: 1px solid rgba(0, 242, 254, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      color: var(--cyan);
      box-shadow: 0 0 10px var(--cyan-glow);
    }

    .brand-titles {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }

    .brand-name {
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      background: linear-gradient(90deg, #ffffff, #67e8f9, #60a5fa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .brand-sub {
      font-size: 11px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .status-pulse {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 9px;
      font-weight: 700;
      color: var(--emerald);
      padding: 1px 6px;
      border-radius: 10px;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .pulse-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--emerald);
      box-shadow: 0 0 6px var(--emerald);
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0% { transform: scale(0.9); opacity: 0.7; }
      50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 10px var(--emerald); }
      100% { transform: scale(0.9); opacity: 0.7; }
    }

    /* CENTER CLOCK */
    .clock-section {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .digital-clock {
      font-family: 'JetBrains Mono', monospace;
      font-size: 17px;
      font-weight: 800;
      letter-spacing: 1px;
      color: #ffffff;
      text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
    }

    .digital-date {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-muted);
      border-left: 1px solid rgba(255, 255, 255, 0.1);
      padding-left: 8px;
    }

    /* CONTROLS RIGHT */
    .controls-section {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .ctrl-select-wrap {
      position: relative;
    }

    .ctrl-select {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
      color: #ffffff;
      padding: 4px 24px 4px 8px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 600;
      appearance: none;
      cursor: pointer;
      outline: none;
      transition: all 0.2s;
    }
    .ctrl-select:focus {
      border-color: var(--cyan);
      box-shadow: 0 0 0 2px var(--cyan-glow);
    }

    .ctrl-select-icon {
      position: absolute;
      right: 7px;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
      font-size: 9px;
      color: var(--text-muted);
    }

    .btn-noc {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--card-border);
      color: #ffffff;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
    }
    .btn-noc:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.25);
      color: var(--cyan);
    }

    .btn-noc.active {
      background: var(--blue-glow);
      border-color: var(--blue);
      color: #93c5fd;
    }

    /* FANRUAN SCI-FI TECH CORNERS */
    .tech-frame {
      position: relative;
    }
    .tech-frame::before {
      content: '';
      position: absolute;
      top: -1px;
      left: -1px;
      width: 7px;
      height: 7px;
      border-top: 2px solid var(--tech-corner);
      border-left: 2px solid var(--tech-corner);
      pointer-events: none;
      z-index: 3;
      border-top-left-radius: 4px;
      transition: border-color 0.3s;
    }
    .tech-frame::after {
      content: '';
      position: absolute;
      bottom: -1px;
      right: -1px;
      width: 7px;
      height: 7px;
      border-bottom: 2px solid var(--tech-corner);
      border-right: 2px solid var(--tech-corner);
      pointer-events: none;
      z-index: 3;
      border-bottom-right-radius: 4px;
      transition: border-color 0.3s;
    }

    /* KPI MICRO SPARKLINE BAR */
    .kpi-sparkline {
      height: 2.5px;
      width: 100%;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 2px;
      overflow: hidden;
      margin: 2px 0 1px 0;
      position: relative;
    }
    .spark-fill {
      height: 100%;
      width: 0%;
      border-radius: 2px;
      transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.3s;
    }
    .spark-fill.cyan { background: linear-gradient(90deg, transparent, var(--cyan)); box-shadow: 0 0 6px var(--cyan); }
    .spark-fill.emerald { background: linear-gradient(90deg, transparent, var(--emerald)); box-shadow: 0 0 6px var(--emerald); }
    .spark-fill.blue { background: linear-gradient(90deg, transparent, var(--blue)); box-shadow: 0 0 6px var(--blue); }
    .spark-fill.purple { background: linear-gradient(90deg, transparent, var(--purple)); box-shadow: 0 0 6px var(--purple); }
    .spark-fill.amber { background: linear-gradient(90deg, transparent, var(--amber)); box-shadow: 0 0 6px var(--amber); }

    /* TOP KPI BAR (5 SLIM CARDS, STRICTLY 1 ROW) */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 8px;
      flex-shrink: 0;
    }

    .kpi-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 6px 12px;
      backdrop-filter: blur(14px);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1px;
      height: 60px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .kpi-card:hover {
      border-color: var(--card-border-hover);
      box-shadow: 0 0 12px rgba(0, 242, 254, 0.15);
    }

    .kpi-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2.5px;
    }

    .kpi-card.cyan::before { background: linear-gradient(90deg, var(--cyan), transparent); }
    .kpi-card.emerald::before { background: linear-gradient(90deg, var(--emerald), transparent); }
    .kpi-card.blue::before { background: linear-gradient(90deg, var(--blue), transparent); }
    .kpi-card.purple::before { background: linear-gradient(90deg, var(--purple), transparent); }
    .kpi-card.amber::before { background: linear-gradient(90deg, var(--amber), transparent); }

    .kpi-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
    }

    .kpi-head i { font-size: 13px; }
    .kpi-card.cyan .kpi-head i { color: var(--cyan); }
    .kpi-card.emerald .kpi-head i { color: var(--emerald); }
    .kpi-card.blue .kpi-head i { color: var(--blue); }
    .kpi-card.purple .kpi-head i { color: var(--purple); }
    .kpi-card.amber .kpi-head i { color: var(--amber); }

    .kpi-value-row {
      display: flex;
      align-items: baseline;
      gap: 5px;
    }

    .kpi-value {
      font-family: 'JetBrains Mono', monospace;
      font-size: 20px;
      font-weight: 800;
      line-height: 1;
      color: #ffffff;
    }
    .kpi-unit {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-muted);
    }

    .kpi-sub {
      font-size: 10px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: space-between;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .badge-pill {
      font-size: 9px;
      font-weight: 700;
      padding: 1px 5px;
      border-radius: 5px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
      white-space: nowrap;
    }

    /* MAIN BODY 3-COLUMNS (ZERO SCROLL, FILL REMAINING HEIGHT) */
    .noc-main {
      display: grid;
      grid-template-columns: 240px 1fr 250px;
      gap: 8px;
      flex: 1;
      min-height: 0;
      overflow: hidden;
    }

    .col-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 10px 12px;
      backdrop-filter: blur(14px);
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-height: 0;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
      overflow: hidden;
    }

    .card-title-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--text-muted);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      padding-bottom: 6px;
      flex-shrink: 0;
      gap: 6px;
    }

    .card-title-bar > div:first-child {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .card-title-bar i {
      color: var(--cyan);
      font-size: 13px;
      margin-right: 5px;
    }

    /* FANRUAN 3D DONUT RING GAUGES (LEFT COL) */
    .gauges-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      flex-shrink: 0;
    }

    .gauge-box {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 6px 4px;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
    }

    .gauge-svg-wrap {
      width: 80px;
      height: 80px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .gauge-svg {
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
    }

    .gauge-bg-ticks {
      fill: none;
      stroke: rgba(255, 255, 255, 0.07);
      stroke-width: 2;
      stroke-dasharray: 2 4;
    }

    .gauge-bg {
      fill: none;
      stroke: rgba(255, 255, 255, 0.06);
      stroke-width: 6;
    }

    .gauge-bar {
      fill: none;
      stroke-width: 6;
      stroke-linecap: round;
      transition: stroke-dashoffset 0.8s cubic-bezier(0.16, 1, 0.3, 1), stroke 0.3s;
    }

    .gauge-label-center {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .gauge-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: 16px;
      font-weight: 800;
      line-height: 1;
    }

    .gauge-status-pill {
      font-size: 7.5px;
      font-weight: 800;
      letter-spacing: 0.5px;
      padding: 1px 4px;
      border-radius: 3px;
      margin-top: 2px;
      text-transform: uppercase;
      background: rgba(16, 185, 129, 0.12);
      color: var(--emerald);
      border: 1px solid rgba(16, 185, 129, 0.3);
      font-family: 'JetBrains Mono', monospace;
    }

    .gauge-title {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .gauge-detail {
      font-size: 9px;
      color: var(--text-dim);
      font-family: 'JetBrains Mono', monospace;
      margin-top: 1px;
    }

    /* STAT PROGRESS BAR BOX */
    .stat-bar-box {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 8px 10px;
      display: flex;
      flex-direction: column;
      gap: 5px;
      flex-shrink: 0;
    }

    .stat-bar-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      font-weight: 600;
    }

    .ratio-bar {
      height: 6px;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 3px;
      overflow: hidden;
      position: relative;
    }

    .ratio-fill {
      height: 100%;
      border-radius: 3px;
      transition: width 0.6s ease;
    }

    .ratio-fill.blue { background: linear-gradient(90deg, #3b82f6, #00f2fe); }
    .ratio-fill.emerald { background: linear-gradient(90deg, #10b981, #34d399); }
    .ratio-fill.purple { background: linear-gradient(90deg, #8b5cf6, #c084fc); }

    .ratio-labels {
      display: flex;
      justify-content: space-between;
      font-size: 10px;
      color: var(--text-muted);
      font-family: 'JetBrains Mono', monospace;
    }

    /* ROUTER INFO LIST */
    .vitals-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 8px 10px;
      flex-shrink: 0;
    }

    .vital-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
    }

    .vital-key {
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .vital-val {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      color: #ffffff;
      font-size: 11px;
    }

    /* CENTER COLUMN: WAVE CHART + INTERFACES */
    .center-section {
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-height: 0;
      flex: 1;
      overflow: hidden;
    }

    .chart-box {
      flex: 1.25;
      min-height: 160px;
      display: flex;
      flex-direction: column;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 10px 12px;
      overflow: hidden;
    }

    .chart-controls {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .chart-canvas-wrap {
      flex: 1;
      min-height: 110px;
      position: relative;
      width: 100%;
      margin-top: 6px;
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.04);
      border-radius: 8px;
      padding: 4px;
    }

    .chart-canvas-wrap canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100% !important;
      height: 100% !important;
    }

    .interfaces-box {
      flex: 1;
      min-height: 120px;
      display: flex;
      flex-direction: column;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 8px 12px;
      overflow: hidden;
    }

    .iface-filter-tabs {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .tab-pill {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--card-border);
      color: var(--text-muted);
      font-size: 10px;
      font-weight: 600;
      padding: 2px 7px;
      border-radius: 5px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .tab-pill:hover, .tab-pill.active {
      background: rgba(0, 242, 254, 0.15);
      border-color: var(--cyan);
      color: #ffffff;
    }

    .iface-table-wrap {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      margin-top: 6px;
    }

    .iface-table-wrap::-webkit-scrollbar {
      width: 5px;
    }
    .iface-table-wrap::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.2);
    }
    .iface-table-wrap::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.15);
      border-radius: 3px;
    }

    .noc-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 11px;
      text-align: left;
    }

    .noc-table th {
      position: sticky;
      top: 0;
      background: #090e1f;
      color: var(--text-muted);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 9.5px;
      letter-spacing: 0.5px;
      padding: 4px 6px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      z-index: 2;
    }

    .noc-table td {
      padding: 4px 6px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.03);
      vertical-align: middle;
    }

    .noc-table tr:hover {
      background: rgba(255, 255, 255, 0.02);
    }

    .iface-name-col {
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: 600;
      font-family: 'JetBrains Mono', monospace;
    }

    .link-led {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .link-led.up {
      background: var(--emerald);
      box-shadow: 0 0 6px var(--emerald);
    }
    .link-led.down {
      background: var(--rose);
      box-shadow: 0 0 6px var(--rose);
    }

    .rate-pill {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      font-size: 10px;
    }
    .rate-pill.rx { color: var(--cyan); }
    .rate-pill.tx { color: var(--emerald); }

    /* AI VOICE FLOATING HUD */
    .ai-voice-hud {
      position: fixed;
      bottom: 12px;
      right: 14px;
      background: rgba(11, 15, 31, 0.94);
      border: 1px solid rgba(0, 242, 254, 0.35);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), 0 0 20px rgba(0, 242, 254, 0.2);
      border-radius: 30px;
      padding: 5px 12px 5px 6px;
      display: none;
      align-items: center;
      gap: 9px;
      z-index: 1000;
      backdrop-filter: blur(14px);
      animation: hudSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      max-width: 440px;
    }
    .ai-voice-hud.active {
      display: flex;
    }
    @keyframes hudSlideUp {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .ai-orb-btn {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: linear-gradient(135deg, #00f2fe, #3b82f6);
      border: none;
      color: #060813;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
      box-shadow: 0 0 10px rgba(0, 242, 254, 0.5);
      flex-shrink: 0;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .ai-orb-btn:hover {
      transform: scale(1.08);
    }
    .ai-orb-btn.listening {
      background: linear-gradient(135deg, #f43f5e, #f59e0b);
      box-shadow: 0 0 16px rgba(244, 63, 94, 0.8);
      animation: micPulse 0.9s infinite alternate;
    }
    @keyframes micPulse {
      from { transform: scale(1); }
      to { transform: scale(1.18); }
    }
    .ai-hud-content {
      display: flex;
      flex-direction: column;
      min-width: 140px;
      max-width: 250px;
      overflow: hidden;
    }
    .ai-hud-title {
      font-size: 9px;
      font-weight: 700;
      color: var(--cyan);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .ai-hud-msg {
      font-size: 11px;
      color: #ffffff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-weight: 500;
    }
    .ai-wave-bars {
      display: flex;
      align-items: center;
      gap: 2.5px;
      height: 14px;
    }
    .ai-wave-bars span {
      width: 2.5px;
      height: 4px;
      background: var(--cyan);
      border-radius: 2px;
      transition: height 0.15s ease;
    }
    .ai-voice-hud.speaking .ai-wave-bars span {
      animation: soundwave 0.6s ease-in-out infinite alternate;
    }
    .ai-voice-hud.speaking .ai-wave-bars span:nth-child(1) { animation-delay: 0.1s; }
    .ai-voice-hud.speaking .ai-wave-bars span:nth-child(2) { animation-delay: 0.25s; }
    .ai-voice-hud.speaking .ai-wave-bars span:nth-child(3) { animation-delay: 0.15s; }
    .ai-voice-hud.speaking .ai-wave-bars span:nth-child(4) { animation-delay: 0.3s; }
    @keyframes soundwave {
      0% { height: 3px; }
      100% { height: 14px; }
    }

    /* BOTTOM TELEMETRY TICKER BAR */
    .noc-ticker-bar {
      height: 24px;
      min-height: 24px;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 2px 10px;
      font-size: 10px;
      backdrop-filter: blur(14px);
      flex-shrink: 0;
      gap: 10px;
      overflow: hidden;
    }
    .ticker-badge {
      display: flex;
      align-items: center;
      gap: 5px;
      font-weight: 800;
      font-family: 'JetBrains Mono', monospace;
      color: var(--cyan);
      letter-spacing: 0.5px;
      flex-shrink: 0;
      border-right: 1px solid rgba(255, 255, 255, 0.1);
      padding-right: 10px;
    }
    .ticker-track {
      flex: 1;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      color: var(--text-muted);
      font-family: 'JetBrains Mono', monospace;
    }
    .ticker-time {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 5px;
      color: var(--emerald);
      font-weight: 700;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
    }
    .spin-slow {
      animation: spinSlow 4s linear infinite;
      display: inline-block;
    }
    @keyframes spinSlow {
      100% { transform: rotate(360deg); }
    }

    /* LOADING OVERLAY */
    .noc-overlay {
      position: fixed;
      inset: 0;
      background: #060813;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      z-index: 9999;
      transition: opacity 0.4s ease;
    }

    .noc-spinner {
      width: 44px;
      height: 44px;
      border: 3px solid rgba(0, 242, 254, 0.15);
      border-top-color: var(--cyan);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>

  <!-- LOADING OVERLAY -->
  <div id="loading-overlay" class="noc-overlay">
    <div class="noc-spinner"></div>
    <div style="font-size:12px; font-weight:700; letter-spacing:1px; color:#94a3b8; text-transform:uppercase;">
      Menghubungkan ke NOC Telemetry...
    </div>
  </div>

  <div class="noc-container">

    <!-- TOP HEADER -->
    <header class="noc-header tech-frame">
      <div class="brand-section">
        <div class="brand-icon-box">
          <i class="bi bi-broadcast"></i>
        </div>
        <div class="brand-titles">
          <div class="brand-name"><%= company %> NOC</div>
          <div class="brand-sub">
            <span class="status-pulse" id="header-pulse">
              <span class="pulse-dot"></span>
              <span id="header-pulse-text">OPERATIONAL</span>
            </span>
            <span id="board-model-badge" style="font-family:'JetBrains Mono';font-size:10px;color:var(--text-dim)">
              <i class="bi bi-hdd-network"></i> Router MikroTik
            </span>
          </div>
        </div>
      </div>

      <!-- CENTER DIGITAL CLOCK -->
      <div class="clock-section">
        <div class="digital-clock" id="live-clock">--:--:-- WIB</div>
        <div class="digital-date" id="live-date">Memuat tanggal...</div>
      </div>

      <!-- CONTROLS -->
      <div class="controls-section">
        <!-- Theme Selector (FanRuan Style) -->
        <div class="ctrl-select-wrap">
          <select id="theme-selector" class="ctrl-select" onchange="switchTheme(this.value)" title="Pilih Tema Visual NOC">
            <option value="cyberpunk" selected>🎨 Cyberpunk</option>
            <option value="matrix">🟢 Matrix</option>
            <option value="sapphire">🔷 Sapphire</option>
            <option value="amoled">⚫ AMOLED</option>
            <option value="amber">🟠 Amber</option>
          </select>
          <i class="bi bi-chevron-down ctrl-select-icon"></i>
        </div>

        <!-- Router Selector -->
        <div class="ctrl-select-wrap">
          <select id="router-select" class="ctrl-select" onchange="switchRouter()">
            <% routers.forEach(r => { %>
              <option value="<%= r.id %>"><%= r.name %></option>
            <% }) %>
          </select>
          <i class="bi bi-chevron-down ctrl-select-icon"></i>
        </div>

        <!-- Refresh Interval Selector -->
        <div class="ctrl-select-wrap">
          <select id="refresh-interval-select" class="ctrl-select" onchange="updatePollInterval()">
            <option value="1500">1.5s (Turbo)</option>
            <option value="2500" selected>2.5s (Normal)</option>
            <option value="5000">5s (Eco)</option>
          </select>
          <i class="bi bi-chevron-down ctrl-select-icon"></i>
        </div>

        <!-- Auto-cycle if > 1 router -->
        <% if (routers && routers.length > 1) { %>
        <button id="cycle-toggle-btn" class="btn-noc" onclick="toggleAutoCycle()" title="Rotasi router otomatis setiap 20 detik">
          <i class="bi bi-arrow-repeat"></i>
          <span id="cycle-btn-text">Rotasi</span>
        </button>
        <% } %>

        <!-- AI Voice Assistant & Announcer Toggle -->
        <button id="ai-voice-toggle-btn" class="btn-noc" onclick="toggleNocVoice()" title="Aktifkan AI Voice Announcer & Asisten Suara Interaktif">
          <i class="bi bi-mic" id="ai-voice-btn-icon"></i>
          <span id="ai-voice-btn-text">AI Voice</span>
        </button>

        <!-- Audio Alert Toggle -->
        <button id="audio-toggle-btn" class="btn-noc" onclick="toggleAudioAlert()" title="Bunyi alarm jika link interface down">
          <i class="bi bi-volume-mute" id="audio-btn-icon"></i>
          <span id="audio-btn-text">Audio</span>
        </button>

        <!-- Download APK Android TV -->
        <a href="/alijaya-noc-tv-v1.0.0.apk" class="btn-noc" download title="Download APK Khusus Android TV / STB" style="border-color: rgba(0,242,254,0.4); color: var(--cyan);">
          <i class="bi bi-tv"></i>
          <span>APK TV</span>
        </a>

        <!-- Fullscreen Button -->
        <button class="btn-noc" onclick="toggleFullscreen()" title="Masuk Mode Layar Penuh (F11)">
          <i class="bi bi-fullscreen" id="fs-icon"></i>
          <span id="fs-text">Fullscreen</span>
        </button>

        <!-- Exit Link -->
        <% if (typeof isPublicNoc === 'undefined' || !isPublicNoc) { %>
        <a href="/admin/mikrotik" class="btn-noc" title="Kembali ke Admin Portal">
          <i class="bi bi-box-arrow-left"></i>
        </a>
        <% } %>
      </div>
    </header>

    <!-- TOP KPI TELEMETRY BAR (5 SLIM CARDS, STRICTLY 1 ROW) -->
    <section class="kpi-grid">
      <!-- 1. Download -->
      <div class="kpi-card cyan tech-frame">
        <div class="kpi-head">
          <span id="kpi-rx-label">Download Traffic (RX)</span>
          <i class="bi bi-arrow-down-circle"></i>
        </div>
        <div class="kpi-value-row">
          <span class="kpi-value" id="kpi-rx-val">0.0</span>
          <span class="kpi-unit" id="kpi-rx-unit">Mbps</span>
        </div>
        <div class="kpi-sparkline">
          <div class="spark-fill cyan" id="rx-spark-fill"></div>
        </div>
        <div class="kpi-sub">
          <span id="kpi-rx-interface"><i class="bi bi-hdd-network"></i> WAN: ether1-ISP</span>
          <span class="badge-pill" id="kpi-rx-peak">Peak: 0.0 Mbps</span>
        </div>
      </div>

      <!-- 2. Upload -->
      <div class="kpi-card emerald tech-frame">
        <div class="kpi-head">
          <span id="kpi-tx-label">Upload Traffic (TX)</span>
          <i class="bi bi-arrow-up-circle"></i>
        </div>
        <div class="kpi-value-row">
          <span class="kpi-value" id="kpi-tx-val">0.0</span>
          <span class="kpi-unit" id="kpi-tx-unit">Mbps</span>
        </div>
        <div class="kpi-sparkline">
          <div class="spark-fill emerald" id="tx-spark-fill"></div>
        </div>
        <div class="kpi-sub">
          <span id="kpi-total-bandwidth"><i class="bi bi-activity"></i> Total: 0.0 Mbps</span>
          <span class="badge-pill" id="kpi-tx-peak">Peak: 0.0 Mbps</span>
        </div>
      </div>

      <!-- 3. PPPoE -->
      <div class="kpi-card blue tech-frame">
        <div class="kpi-head">
          <span>PPPoE Subscribers</span>
          <i class="bi bi-ethernet"></i>
        </div>
        <div class="kpi-value-row">
          <span class="kpi-value" id="kpi-pppoe-online">0</span>
          <span class="kpi-unit" id="kpi-pppoe-total">/ 0 Total</span>
        </div>
        <div class="kpi-sparkline">
          <div class="spark-fill blue" id="pppoe-spark-fill"></div>
        </div>
        <div class="kpi-sub">
          <span id="kpi-pppoe-offline"><i class="bi bi-circle-fill" style="color:var(--rose);font-size:6px"></i> 0 Offline</span>
          <span class="badge-pill" id="kpi-pppoe-ratio" style="color:var(--cyan)">100% Active</span>
        </div>
      </div>

      <!-- 4. Hotspot -->
      <div class="kpi-card purple tech-frame">
        <div class="kpi-head">
          <span>Hotspot Vouchers</span>
          <i class="bi bi-wifi"></i>
        </div>
        <div class="kpi-value-row">
          <span class="kpi-value" id="kpi-hotspot-active">0</span>
          <span class="kpi-unit" id="kpi-hotspot-total">/ 0 Vouchers</span>
        </div>
        <div class="kpi-sparkline">
          <div class="spark-fill purple" id="hotspot-spark-fill"></div>
        </div>
        <div class="kpi-sub">
          <span><i class="bi bi-people"></i> Sesi Aktif</span>
          <span class="badge-pill" style="color:var(--purple)">RADIUS / API</span>
        </div>
      </div>

      <!-- 5. Hardware Vitals -->
      <div class="kpi-card amber tech-frame">
        <div class="kpi-head">
          <span>Hardware & TR-069</span>
          <i class="bi bi-cpu"></i>
        </div>
        <div class="kpi-value-row">
          <span class="kpi-value" id="kpi-temp-val">--</span>
          <span class="kpi-unit" id="kpi-temp-unit">°C</span>
          <span style="font-size:13px;color:var(--text-muted);margin:0 2px">•</span>
          <span class="kpi-value" id="kpi-volt-val" style="font-size:17px">--</span>
          <span class="kpi-unit">V</span>
        </div>
        <div class="kpi-sparkline">
          <div class="spark-fill amber" id="temp-spark-fill"></div>
        </div>
        <div class="kpi-sub">
          <span id="kpi-ont-summary"><i class="bi bi-modem"></i> ONT: 0 Online</span>
          <span class="badge-pill" id="kpi-optical-alert" style="color:var(--emerald)">Fiber OK</span>
        </div>
      </div>
    </section>

    <!-- MAIN 3-COLUMNS (FITS 100% IN VIEWPORT) -->
    <main class="noc-main">

      <!-- LEFT COLUMN: HARDWARE RADIAL GAUGES & SPECS -->
      <div class="col-card tech-frame">
        <div class="card-title-bar">
          <div><i class="bi bi-speedometer2"></i> System Hardware</div>
          <span class="badge-pill" id="router-uptime-badge">Up: --</span>
        </div>

        <!-- 2 Radial Gauges (FanRuan 3D Donut Style) -->
        <div class="gauges-container">
          <!-- CPU Gauge -->
          <div class="gauge-box tech-frame">
            <div class="gauge-svg-wrap">
              <svg class="gauge-svg" viewBox="0 0 80 80">
                <circle class="gauge-bg-ticks" cx="40" cy="40" r="35"></circle>
                <circle class="gauge-bg" cx="40" cy="40" r="31"></circle>
                <circle class="gauge-bar" id="cpu-gauge-bar" cx="40" cy="40" r="31" stroke="var(--emerald)" stroke-dasharray="194.8" stroke-dashoffset="194.8"></circle>
              </svg>
              <div class="gauge-label-center">
                <span class="gauge-num" id="cpu-gauge-num" style="color:var(--emerald)">0%</span>
                <span class="gauge-status-pill" id="cpu-status-pill">OPTIMAL</span>
              </div>
            </div>
            <div class="gauge-title">CPU Load</div>
            <div class="gauge-detail" id="cpu-detail-text">-- Cores</div>
          </div>

          <!-- Memory Gauge -->
          <div class="gauge-box tech-frame">
            <div class="gauge-svg-wrap">
              <svg class="gauge-svg" viewBox="0 0 80 80">
                <circle class="gauge-bg-ticks" cx="40" cy="40" r="35"></circle>
                <circle class="gauge-bg" cx="40" cy="40" r="31"></circle>
                <circle class="gauge-bar" id="mem-gauge-bar" cx="40" cy="40" r="31" stroke="var(--cyan)" stroke-dasharray="194.8" stroke-dashoffset="194.8"></circle>
              </svg>
              <div class="gauge-label-center">
                <span class="gauge-num" id="mem-gauge-num" style="color:var(--cyan)">0%</span>
                <span class="gauge-status-pill" id="mem-status-pill">NORMAL</span>
              </div>
            </div>
            <div class="gauge-title">Memory RAM</div>
            <div class="gauge-detail" id="mem-detail-text">-- MB Free</div>
          </div>
        </div>

        <!-- HDD Storage Progress Bar -->
        <div class="stat-bar-box">
          <div class="stat-bar-header">
            <span style="color:var(--text-muted);font-size:10px"><i class="bi bi-hdd"></i> Storage / Disk</span>
            <span id="hdd-percent-text" style="font-family:'JetBrains Mono';font-size:10px;color:#ffffff">0%</span>
          </div>
          <div class="ratio-bar">
            <div class="ratio-fill blue" id="hdd-fill" style="width: 0%"></div>
          </div>
          <div class="ratio-labels">
            <span id="hdd-free-val">Free: --</span>
            <span id="hdd-total-val">Total: --</span>
          </div>
        </div>

        <!-- Router Vitals List -->
        <div class="vitals-list">
          <div class="vital-item">
            <span class="vital-key"><i class="bi bi-cpu"></i> Board</span>
            <span class="vital-val" id="vital-board-name">--</span>
          </div>
          <div class="vital-item">
            <span class="vital-key"><i class="bi bi-terminal"></i> RouterOS</span>
            <span class="vital-val" id="vital-version">--</span>
          </div>
          <div class="vital-item">
            <span class="vital-key"><i class="bi bi-lightning-charge"></i> CPU Freq</span>
            <span class="vital-val" id="vital-cpu-freq">-- MHz</span>
          </div>
          <div class="vital-item">
            <span class="vital-key"><i class="bi bi-thermometer-half"></i> Suhu Board</span>
            <span class="vital-val" id="vital-temp">-- °C</span>
          </div>
          <div class="vital-item">
            <span class="vital-key"><i class="bi bi-plug"></i> Voltase</span>
            <span class="vital-val" id="vital-voltage">-- V</span>
          </div>
        </div>

        <!-- Host Server Box -->
        <div class="vitals-list" style="margin-top:auto">
          <div class="vital-item">
            <span class="vital-key"><i class="bi bi-server"></i> Node.js</span>
            <span class="vital-val" id="vital-node-ver">v22.23.5</span>
          </div>
          <div class="vital-item">
            <span class="vital-key"><i class="bi bi-memory"></i> Host RAM</span>
            <span class="vital-val" id="vital-server-ram">-- MB</span>
          </div>
        </div>
      </div>

      <!-- CENTER COLUMN: WAVE CHART + INTERFACES MATRIX -->
      <div class="center-section">

        <!-- Real-Time Traffic Throughput Wave Chart -->
        <div class="chart-box tech-frame">
          <div class="card-title-bar">
            <div><i class="bi bi-activity"></i> Real-time Traffic Throughput Wave</div>
            <div class="chart-controls">
              <!-- Interface Selector -->
              <div class="ctrl-select-wrap">
                <select id="interface-chart-selector" class="ctrl-select" onchange="switchChartInterface()">
                  <option value="__WAN__" selected>⭐ WAN (Trafik Utama Internet)</option>
                  <option value="__ALL__">🌐 Semua Interface (Akumulasi Total)</option>
                </select>
                <i class="bi bi-chevron-down ctrl-select-icon"></i>
              </div>
              <span class="badge-pill" id="chart-max-rate" style="color:var(--cyan)">Max: 0.0 Mbps</span>
            </div>
          </div>

          <div class="chart-canvas-wrap">
            <canvas id="traffic-live-chart"></canvas>
          </div>
        </div>

        <!-- Active Interfaces Matrix Table -->
        <div class="interfaces-box tech-frame">
          <div class="card-title-bar">
            <div><i class="bi bi-diagram-3"></i> Network Interfaces Live Telemetry</div>
            <div class="iface-filter-tabs">
              <button class="tab-pill active" id="tab-btn-phy" onclick="setIfaceFilter('wan_phy')">Physical & VLAN</button>
