<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= title %> | <%= company %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <style>
    :root {
      --bg: #060813;
      --bg-surface: #0b0f1f;
      --card-bg: rgba(13, 18, 36, 0.72);
      --card-border: rgba(255, 255, 255, 0.08);
      --card-border-hover: rgba(59, 130, 246, 0.3);
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      
      --cyan: #00f2fe;
      --cyan-glow: rgba(0, 242, 254, 0.22);
      --emerald: #10b981;
      --emerald-glow: rgba(16, 185, 129, 0.22);
      --blue: #3b82f6;
      --blue-glow: rgba(59, 130, 246, 0.22);
      --purple: #8b5cf6;
      --purple-glow: rgba(139, 92, 246, 0.22);
      --amber: #f59e0b;
      --amber-glow: rgba(245, 158, 11, 0.22);
      --rose: #f43f5e;
      --rose-glow: rgba(244, 63, 94, 0.22);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      background-image: 
        radial-gradient(circle at 15% 15%, rgba(0, 242, 254, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 85% 20%, rgba(59, 130, 246, 0.05) 0%, transparent 45%),
        radial-gradient(circle at 50% 85%, rgba(139, 92, 246, 0.04) 0%, transparent 50%),
        linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 100% 100%, 36px 36px, 36px 36px;
      color: var(--text);
      overflow-x: hidden;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    .noc-container {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      padding: 12px 16px;
      gap: 12px;
      max-width: 1920px;
      margin: 0 auto;
    }

    /* TOP HEADER */
    .noc-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      padding: 10px 18px;
      border-radius: 14px;
      backdrop-filter: blur(16px);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
      flex-wrap: wrap;
      gap: 12px;
    }

    .brand-section {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-icon-box {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: linear-gradient(135deg, rgba(0, 242, 254, 0.2), rgba(59, 130, 246, 0.2));
      border: 1px solid rgba(0, 242, 254, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      color: var(--cyan);
      box-shadow: 0 0 16px var(--cyan-glow);
    }

    .brand-titles {
      display: flex;
      flex-direction: column;
    }

    .brand-name {
      font-size: 17px;
      font-weight: 800;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      background: linear-gradient(90deg, #ffffff, #67e8f9, #60a5fa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .brand-sub {
      font-size: 11px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .status-pulse {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 10px;
      font-weight: 700;
      color: var(--emerald);
      padding: 2px 8px;
      border-radius: 12px;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--emerald);
      box-shadow: 0 0 8px var(--emerald);
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0% { transform: scale(0.9); opacity: 0.7; }
      50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 12px var(--emerald); }
      100% { transform: scale(0.9); opacity: 0.7; }
    }

    /* CENTER CLOCK */
    .clock-section {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .digital-clock {
      font-family: 'JetBrains Mono', monospace;
      font-size: 22px;
      font-weight: 800;
      letter-spacing: 1.5px;
      color: #ffffff;
      text-shadow: 0 0 12px rgba(255, 255, 255, 0.35);
    }

    .digital-date {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-muted);
      letter-spacing: 0.5px;
    }

    /* CONTROLS RIGHT */
    .controls-section {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .ctrl-select-wrap {
      position: relative;
    }

    .ctrl-select {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
      color: #ffffff;
      padding: 6px 30px 6px 12px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      appearance: none;
      cursor: pointer;
      outline: none;
      transition: all 0.2s;
    }
    .ctrl-select:focus {
      border-color: var(--cyan);
      box-shadow: 0 0 0 2px var(--cyan-glow);
    }

    .ctrl-select-icon {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
      font-size: 10px;
      color: var(--text-muted);
    }

    .btn-noc {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--card-border);
      color: #ffffff;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
    }
    .btn-noc:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.25);
      color: var(--cyan);
    }

    .btn-noc.active {
      background: var(--blue-glow);
      border-color: var(--blue);
      color: #93c5fd;
    }

    /* TOP KPI BAR (5 NEON CARDS) */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 12px;
    }

    .kpi-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 14px 16px;
      backdrop-filter: blur(14px);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: 4px;
      transition: transform 0.2s, border-color 0.2s;
    }
    .kpi-card:hover {
      border-color: var(--card-border-hover);
      transform: translateY(-2px);
    }

    .kpi-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
    }

    .kpi-card.cyan::before { background: linear-gradient(90deg, var(--cyan), transparent); }
    .kpi-card.emerald::before { background: linear-gradient(90deg, var(--emerald), transparent); }
    .kpi-card.blue::before { background: linear-gradient(90deg, var(--blue), transparent); }
    .kpi-card.purple::before { background: linear-gradient(90deg, var(--purple), transparent); }
    .kpi-card.amber::before { background: linear-gradient(90deg, var(--amber), transparent); }

    .kpi-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--text-muted);
    }

    .kpi-head i { font-size: 16px; }
    .kpi-card.cyan .kpi-head i { color: var(--cyan); text-shadow: 0 0 10px var(--cyan); }
    .kpi-card.emerald .kpi-head i { color: var(--emerald); text-shadow: 0 0 10px var(--emerald); }
    .kpi-card.blue .kpi-head i { color: var(--blue); text-shadow: 0 0 10px var(--blue); }
    .kpi-card.purple .kpi-head i { color: var(--purple); text-shadow: 0 0 10px var(--purple); }
    .kpi-card.amber .kpi-head i { color: var(--amber); text-shadow: 0 0 10px var(--amber); }

    .kpi-value-row {
      display: flex;
      align-items: baseline;
      gap: 6px;
      margin-top: 2px;
    }

    .kpi-value {
      font-family: 'JetBrains Mono', monospace;
      font-size: 24px;
      font-weight: 800;
      line-height: 1.1;
      color: #ffffff;
    }
    .kpi-unit {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-muted);
    }

    .kpi-sub {
      font-size: 11px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 4px;
    }

    .badge-pill {
      font-size: 10px;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
    }

    /* MAIN BODY 3-COLUMNS */
    .noc-main {
      display: grid;
      grid-template-columns: 280px 1fr 300px;
      gap: 12px;
      flex: 1;
      min-height: 0;
    }

    .col-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 16px;
      backdrop-filter: blur(14px);
      display: flex;
      flex-direction: column;
      gap: 14px;
      min-height: 0;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
    }

    .card-title-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--text-muted);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      padding-bottom: 10px;
    }

    .card-title-bar i {
      color: var(--cyan);
      font-size: 15px;
      margin-right: 6px;
    }

    /* RADIAL GAUGES (LEFT COL) */
    .gauges-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .gauge-box {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 12px 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
    }

    .gauge-svg-wrap {
      width: 100px;
      height: 100px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .gauge-svg {
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
    }

    .gauge-bg {
      fill: none;
      stroke: rgba(255, 255, 255, 0.06);
      stroke-width: 8;
    }

    .gauge-bar {
      fill: none;
      stroke-width: 8;
      stroke-linecap: round;
      transition: stroke-dashoffset 0.8s ease, stroke 0.3s;
    }

    .gauge-label-center {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .gauge-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: 20px;
      font-weight: 800;
      line-height: 1;
    }

    .gauge-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-top: 6px;
    }

    .gauge-detail {
      font-size: 10px;
      color: var(--text-dim);
      font-family: 'JetBrains Mono', monospace;
      margin-top: 2px;
    }

    /* ROUTER INFO LIST */
    .vitals-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 12px;
    }

    .vital-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
    }

    .vital-key {
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .vital-val {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      color: #ffffff;
    }

    /* CENTER CHART & INTERFACES */
    .center-section {
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-height: 0;
    }

    .chart-box {
      flex: 1.2;
      display: flex;
      flex-direction: column;
      min-height: 280px;
    }

    .chart-controls {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .chart-canvas-wrap {
      flex: 1;
      position: relative;
      margin-top: 8px;
      background: rgba(0, 0, 0, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.04);
      border-radius: 10px;
      padding: 8px;
    }

    .interfaces-box {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 220px;
    }

    .iface-table-wrap {
      flex: 1;
      overflow-y: auto;
      margin-top: 8px;
    }

    .noc-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      text-align: left;
    }

    .noc-table th {
      position: sticky;
      top: 0;
      background: #0d1224;
      padding: 8px 12px;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--text-muted);
      border-bottom: 1px solid var(--card-border);
      z-index: 2;
    }

    .noc-table td {
      padding: 8px 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      vertical-align: middle;
      font-family: 'Inter', sans-serif;
    }

    .noc-table tbody tr:hover {
      background: rgba(255, 255, 255, 0.03);
    }

    .iface-name-col {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      color: #ffffff;
      font-family: 'JetBrains Mono', monospace;
    }

    .link-led {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--text-dim);
    }
    .link-led.up {
      background: var(--emerald);
      box-shadow: 0 0 8px var(--emerald);
    }
    .link-led.down {
      background: var(--rose);
      box-shadow: 0 0 8px var(--rose);
    }

    .rate-pill {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      font-size: 11px;
      padding: 3px 8px;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .rate-pill.rx {
      color: var(--cyan);
      background: rgba(0, 242, 254, 0.08);
      border: 1px solid rgba(0, 242, 254, 0.2);
    }
    .rate-pill.tx {
      color: var(--emerald);
      background: rgba(16, 185, 129, 0.08);
      border: 1px solid rgba(16, 185, 129, 0.2);
    }

    /* RIGHT COLUMN WIDGETS */
    .stat-bar-box {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .stat-bar-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      font-weight: 700;
    }

    .ratio-bar {
      height: 8px;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 4px;
      overflow: hidden;
      display: flex;
    }

    .ratio-fill {
      height: 100%;
      transition: width 0.6s ease;
    }

    .ratio-fill.blue { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
    .ratio-fill.purple { background: linear-gradient(90deg, #8b5cf6, #c084fc); }
    .ratio-fill.emerald { background: linear-gradient(90deg, #10b981, #34d399); }

    .ratio-labels {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      color: var(--text-muted);
    }

    /* OVERLAY SPINNER */
    .noc-overlay {
      position: fixed;
      inset: 0;
      background: rgba(6, 8, 19, 0.95);
      z-index: 99999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      transition: opacity 0.4s ease;
    }
    .noc-spinner {
      width: 48px;
      height: 48px;
      border: 3px solid rgba(0, 242, 254, 0.15);
      border-top: 3px solid var(--cyan);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      box-shadow: 0 0 16px var(--cyan-glow);
    }
    @keyframes spin { 100% { transform: rotate(360deg); } }

    /* RESPONSIVE */
    @media (max-width: 1200px) {
      .kpi-grid { grid-template-columns: repeat(3, 1fr); }
      .noc-main { grid-template-columns: 1fr; }
    }
    @media (max-width: 768px) {
      .kpi-grid { grid-template-columns: 1fr 1fr; }
      .noc-header { flex-direction: column; text-align: center; }
      .brand-section, .controls-section { justify-content: center; }
    }
  </style>
</head>
<body>

  <!-- LOADING OVERLAY -->
  <div id="loading-overlay" class="noc-overlay">
    <div class="noc-spinner"></div>
    <div style="font-size:13px; font-weight:700; letter-spacing:1px; color:#94a3b8; text-transform:uppercase;">
      Menghubungkan ke NOC Telemetry...
    </div>
  </div>

  <div class="noc-container">

    <!-- TOP HEADER -->
    <header class="noc-header">
      <div class="brand-section">
        <div class="brand-icon-box">
          <i class="bi bi-broadcast-pin"></i>
        </div>
        <div class="brand-titles">
          <div class="brand-name">
            <%= company %> NOC WALLBOARD
            <span class="status-pulse" id="header-pulse">
              <span class="pulse-dot"></span>
              <span id="header-pulse-text">OPERATIONAL</span>
            </span>
          </div>
          <div class="brand-sub">
            <span id="board-model-badge"><i class="bi bi-hdd-network"></i> MikroTik Router</span>
            <span>•</span>
            <span id="server-env-badge"><i class="bi bi-cpu"></i> Server OK</span>
          </div>
        </div>
      </div>

      <!-- CENTER DIGITAL CLOCK -->
      <div class="clock-section">
        <div class="digital-clock" id="live-clock">--:--:--</div>
        <div class="digital-date" id="live-date">Memuat tanggal...</div>
      </div>

      <!-- CONTROLS -->
      <div class="controls-section">
        <!-- Router Selector -->
        <div class="ctrl-select-wrap">
          <select id="router-select" class="ctrl-select" onchange="switchRouter()">
            <% routers.forEach(r => { %>
              <option value="<%= r.id %>"><%= r.name %></option>
            <% }) %>
          </select>
          <i class="bi bi-chevron-down ctrl-select-icon"></i>
        </div>

        <!-- Refresh Interval Selector -->
        <div class="ctrl-select-wrap">
          <select id="refresh-interval-select" class="ctrl-select" onchange="updatePollInterval()">
            <option value="1000">1s (Turbo)</option>
            <option value="2500" selected>2.5s (Normal)</option>
            <option value="5000">5s (Eco)</option>
          </select>
          <i class="bi bi-chevron-down ctrl-select-icon"></i>
        </div>

        <!-- Auto Cycle Routers Toggle -->
        <% if (routers && routers.length > 1) { %>
        <button id="cycle-toggle-btn" class="btn-noc" onclick="toggleAutoCycle()" title="Rotasi router otomatis setiap 20 detik">
          <i class="bi bi-arrow-repeat"></i>
          <span id="cycle-btn-text">Rotasi: OFF</span>
        </button>
        <% } %>

        <!-- Audio Alert Toggle -->
        <button id="audio-toggle-btn" class="btn-noc" onclick="toggleAudioAlert()" title="Bunyi alarm jika link interface terputus">
          <i class="bi bi-volume-mute" id="audio-btn-icon"></i>
          <span id="audio-btn-text">Audio</span>
        </button>

        <!-- Fullscreen Button -->
        <button class="btn-noc" onclick="toggleFullscreen()" title="Masuk Mode Layar Penuh">
          <i class="bi bi-fullscreen" id="fs-icon"></i>
          <span id="fs-text">Fullscreen</span>
        </button>

        <!-- Exit Link -->
        <% if (typeof isPublicNoc === 'undefined' || !isPublicNoc) { %>
        <a href="/admin/mikrotik" class="btn-noc" title="Kembali ke Admin Portal">
          <i class="bi bi-box-arrow-left"></i>
        </a>
        <% } %>
      </div>
    </header>

    <!-- TOP KPI TELEMETRY BAR (5 NEON CARDS) -->
    <section class="kpi-grid">
      <!-- 1. Download -->
      <div class="kpi-card cyan">
        <div class="kpi-head">
          <span>Download Traffic (RX)</span>
          <i class="bi bi-arrow-down-circle"></i>
        </div>
        <div class="kpi-value-row">
          <span class="kpi-value" id="kpi-rx-val">0.0</span>
          <span class="kpi-unit" id="kpi-rx-unit">Mbps</span>
        </div>
        <div class="kpi-sub">
          <span id="kpi-rx-interface"><i class="bi bi-hdd-network"></i> All Interfaces</span>
          <span class="badge-pill" id="kpi-rx-peak">Peak: 0.0 Mbps</span>
        </div>
      </div>

      <!-- 2. Upload -->
      <div class="kpi-card emerald">
