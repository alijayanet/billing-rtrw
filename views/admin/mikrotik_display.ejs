  <!-- Chart.js 4.4 -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>

  <script>
    'use strict';

    // Global State
    let pollInterval = null;
    let pollIntervalMs = 2500;
    let trafficChart = null;
    let selectedInterface = '__ALL__';
    let isAutoCycleEnabled = false;
    let cycleTimer = null;
    let isAudioAlertEnabled = false;
    let previousTrafficSamples = {}; // { ifaceName: { bytesIn, bytesOut, time } }
    let peakRxRate = 0;
    let peakTxRate = 0;
    let maxHistoricalRate = 0;
    let chartHistory = {
      labels: [],
      rx: [],
      tx: []
    };
    const MAX_CHART_POINTS = 30;

    // Web Audio Synthesizer for Outage Alerts
    let audioCtx = null;
    function playBeepAlert(freq = 660, duration = 0.25) {
      if (!isAudioAlertEnabled) return;
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (_) {}
    }

    // On DOM Ready
    document.addEventListener('DOMContentLoaded', () => {
      startClock();
      initChart();
      loadData();
      startPolling();
    });

    // High-Tech Digital Clock
    function startClock() {
      const clockEl = document.getElementById('live-clock');
      const dateEl = document.getElementById('live-date');
      const days = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];

      function tick() {
        const now = new Date();
        const h = String(now.getHours()).padStart(2, '0');
        const m = String(now.getMinutes()).padStart(2, '0');
        const s = String(now.getSeconds()).padStart(2, '0');
        clockEl.textContent = `${h}:${m}:${s} WIB`;

        const dayName = days[now.getDay()];
        const d = now.getDate();
        const monthName = months[now.getMonth()];
        const y = now.getFullYear();
        dateEl.textContent = `${dayName}, ${d} ${monthName} ${y}`;
      }
      tick();
      setInterval(tick, 1000);
    }

    // Initialize Chart.js with Neon Glowing Gradient
    function initChart() {
      const ctx = document.getElementById('traffic-live-chart').getContext('2d');

      const rxGradient = ctx.createLinearGradient(0, 0, 0, 260);
      rxGradient.addColorStop(0, 'rgba(0, 242, 254, 0.28)');
      rxGradient.addColorStop(1, 'rgba(0, 242, 254, 0.00)');

      const txGradient = ctx.createLinearGradient(0, 0, 0, 260);
      txGradient.addColorStop(0, 'rgba(16, 185, 129, 0.28)');
      txGradient.addColorStop(1, 'rgba(16, 185, 129, 0.00)');

      trafficChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: [],
          datasets: [
            {
              label: 'Download (RX)',
              data: [],
              borderColor: '#00f2fe',
              backgroundColor: rxGradient,
              borderWidth: 2.5,
              fill: true,
              tension: 0.35,
              pointRadius: 0,
              pointHoverRadius: 5,
              pointHoverBackgroundColor: '#00f2fe'
            },
            {
              label: 'Upload (TX)',
              data: [],
              borderColor: '#10b981',
              backgroundColor: txGradient,
              borderWidth: 2.5,
              fill: true,
              tension: 0.35,
              pointRadius: 0,
              pointHoverRadius: 5,
              pointHoverBackgroundColor: '#10b981'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: 300 },
          plugins: {
            legend: {
              position: 'top',
              align: 'end',
              labels: {
                color: '#94a3b8',
                boxWidth: 12,
                font: { family: 'Inter', size: 11, weight: '600' }
              }
            },
            tooltip: {
              mode: 'index',
              intersect: false,
              backgroundColor: 'rgba(11, 15, 31, 0.95)',
              borderColor: 'rgba(255, 255, 255, 0.1)',
              borderWidth: 1,
              titleColor: '#f8fafc',
              bodyColor: '#cbd5e1',
              titleFont: { family: 'JetBrains Mono', size: 11 },
              bodyFont: { family: 'JetBrains Mono', size: 12 },
              callbacks: {
                label: function(context) {
                  return ` ${context.dataset.label}: ${context.parsed.y.toFixed(2)} Mbps`;
                }
              }
            }
          },
          scales: {
            x: {
              grid: { color: 'rgba(255, 255, 255, 0.03)' },
              ticks: { color: '#64748b', font: { family: 'JetBrains Mono', size: 10 } }
            },
            y: {
              beginAtZero: true,
              grid: { color: 'rgba(255, 255, 255, 0.03)' },
              ticks: {
                color: '#64748b',
                font: { family: 'JetBrains Mono', size: 10 },
                callback: function(v) { return v.toFixed(1) + ' M'; }
              }
            }
          }
        }
      });
    }

    // Format Byte values nicely
    function formatSpeed(bps) {
      if (bps >= 1000 * 1000 * 1000) {
        return { val: (bps / (1000 * 1000 * 1000)).toFixed(2), unit: 'Gbps' };
      }
      if (bps >= 1000 * 1000) {
        return { val: (bps / (1000 * 1000)).toFixed(2), unit: 'Mbps' };
      }
      if (bps >= 1000) {
        return { val: (bps / 1000).toFixed(1), unit: 'kbps' };
      }
      return { val: bps.toFixed(0), unit: 'bps' };
    }

    function formatBytes(bytes) {
      if (!bytes || bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return (bytes / Math.pow(k, i)).toFixed(1) + ' ' + sizes[i];
    }

    // Set SVG Gauge Arc Value
    function setGaugeArc(circleId, percent) {
      const el = document.getElementById(circleId);
      if (!el) return;
      const circumference = 251.2; // 2 * PI * 40
      const offset = circumference - (Math.min(100, Math.max(0, percent)) / 100) * circumference;
      el.style.strokeDashoffset = offset;
    }

    // Polling Manager
    function startPolling() {
      if (pollInterval) clearInterval(pollInterval);
      pollInterval = setInterval(loadData, pollIntervalMs);
    }

    function updatePollInterval() {
      const select = document.getElementById('refresh-interval-select');
      pollIntervalMs = Number(select.value) || 2500;
      startPolling();
    }

    // Router Selector & Switcher
    function switchRouter() {
      previousTrafficSamples = {};
      chartHistory = { labels: [], rx: [], tx: [] };
      peakRxRate = 0;
      peakTxRate = 0;
      maxHistoricalRate = 0;
      if (trafficChart) {
        trafficChart.data.labels = [];
        trafficChart.data.datasets[0].data = [];
        trafficChart.data.datasets[1].data = [];
        trafficChart.update();
      }
      const overlay = document.getElementById('loading-overlay');
      overlay.style.opacity = '1';
      overlay.style.pointerEvents = 'auto';
      loadData();
    }

    // Auto-Cycle Routers Toggle (every 20s)
    function toggleAutoCycle() {
      isAutoCycleEnabled = !isAutoCycleEnabled;
      const btn = document.getElementById('cycle-toggle-btn');
      const text = document.getElementById('cycle-btn-text');
      if (isAutoCycleEnabled) {
        btn.classList.add('active');
        text.textContent = 'Rotasi: ON';
        cycleTimer = setInterval(() => {
          const select = document.getElementById('router-select');
          let nextIndex = select.selectedIndex + 1;
          if (nextIndex >= select.options.length) nextIndex = 0;
          select.selectedIndex = nextIndex;
          switchRouter();
        }, 20000);
      } else {
        btn.classList.remove('active');
        text.textContent = 'Rotasi: OFF';
        if (cycleTimer) clearInterval(cycleTimer);
      }
    }

    // Audio Alert Toggle
    function toggleAudioAlert() {
      isAudioAlertEnabled = !isAudioAlertEnabled;
      const btn = document.getElementById('audio-toggle-btn');
      const icon = document.getElementById('audio-btn-icon');
      const text = document.getElementById('audio-btn-text');
      if (isAudioAlertEnabled) {
        btn.classList.add('active');
        icon.className = 'bi bi-volume-up';
        text.textContent = 'Audio: ON';
        playBeepAlert(880, 0.15); // Test beep
      } else {
        btn.classList.remove('active');
        icon.className = 'bi bi-volume-mute';
        text.textContent = 'Audio';
      }
    }

    // Toggle Fullscreen Mode
    function toggleFullscreen() {
      const icon = document.getElementById('fs-icon');
      const text = document.getElementById('fs-text');
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().then(() => {
          icon.className = 'bi bi-fullscreen-exit';
          text.textContent = 'Exit Screen';
        }).catch(err => console.error(err));
      } else {
        document.exitFullscreen().then(() => {
          icon.className = 'bi bi-fullscreen';
          text.textContent = 'Fullscreen';
        });
      }
    }

    // Switch Interface for Live Traffic Chart
    function switchChartInterface() {
      selectedInterface = document.getElementById('interface-chart-selector').value;
      chartHistory = { labels: [], rx: [], tx: [] };
      if (trafficChart) {
        trafficChart.data.labels = [];
        trafficChart.data.datasets[0].data = [];
        trafficChart.data.datasets[1].data = [];
        trafficChart.update();
      }
    }

    // Main Data Fetcher
    async function loadData() {
      const routerId = document.getElementById('router-select').value;
      const now = Date.now();

      try {
        // Fetch from either /api/noc/data or /admin/api/mikrotik/monitoring-display-data
        const url = `/api/noc/data?routerId=${encodeURIComponent(routerId)}`;
        const res = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();

        // Hide overlay on success
        const overlay = document.getElementById('loading-overlay');
        overlay.style.opacity = '0';
        overlay.style.pointerEvents = 'none';

        // Update Pulse status
        document.getElementById('header-pulse-text').textContent = data.warning ? 'DEGRADED' : 'OPERATIONAL';
        document.getElementById('header-pulse').style.color = data.warning ? 'var(--amber)' : 'var(--emerald)';

        // 1. Hardware Vitals (Router)
        const r = data.router || {};
        document.getElementById('board-model-badge').innerHTML = `<i class="bi bi-hdd-network"></i> ${r.boardName || 'MikroTik'} (${r.version || ''})`;
        document.getElementById('vital-board-name').textContent = r.boardName || '-';
        document.getElementById('vital-version').textContent = r.version || '-';
        document.getElementById('vital-cpu-freq').textContent = `${r.cpuFrequency || '-'} MHz (${r.cpuCount || 1} Cores)`;
        document.getElementById('router-uptime-badge').textContent = `Up: ${r.uptime || '-'}`;

        // Voltage & Temp
        if (r.temperature !== null && r.temperature !== undefined) {
          document.getElementById('kpi-temp-val').textContent = r.temperature;
          document.getElementById('vital-temp').textContent = `${r.temperature} °C`;
          if (r.temperature >= 60) document.getElementById('kpi-temp-val').style.color = 'var(--rose)';
          else if (r.temperature >= 50) document.getElementById('kpi-temp-val').style.color = 'var(--amber)';
          else document.getElementById('kpi-temp-val').style.color = '#ffffff';
        } else {
          document.getElementById('kpi-temp-val').textContent = '--';
          document.getElementById('vital-temp').textContent = '-';
        }

        if (r.voltage !== null && r.voltage !== undefined) {
          document.getElementById('kpi-volt-val').textContent = r.voltage;
          document.getElementById('vital-voltage').textContent = `${r.voltage} V`;
        } else {
          document.getElementById('kpi-volt-val').textContent = '--';
          document.getElementById('vital-voltage').textContent = '-';
        }

        // CPU Radial Arc
        const cpuVal = Math.round(r.cpuLoad || 0);
        document.getElementById('cpu-gauge-num').textContent = `${cpuVal}%`;
        document.getElementById('cpu-detail-text').textContent = `${r.cpuCount || 1} Cores @ ${r.cpuFrequency || 0}MHz`;
        setGaugeArc('cpu-gauge-bar', cpuVal);
        const cpuBar = document.getElementById('cpu-gauge-bar');
        const cpuNum = document.getElementById('cpu-gauge-num');
        if (cpuVal >= 80) {
          cpuBar.setAttribute('stroke', 'var(--rose)');
          cpuNum.style.color = 'var(--rose)';
        } else if (cpuVal >= 50) {
          cpuBar.setAttribute('stroke', 'var(--amber)');
          cpuNum.style.color = 'var(--amber)';
        } else {
          cpuBar.setAttribute('stroke', 'var(--emerald)');
          cpuNum.style.color = 'var(--emerald)';
        }

        // Memory Radial Arc
        const memPercent = Math.round(r.memoryPercent || 0);
        const freeMb = Math.round((r.freeMemory || 0) / (1024 * 1024));
        const totalMb = Math.round((r.totalMemory || 0) / (1024 * 1024));
        document.getElementById('mem-gauge-num').textContent = `${memPercent}%`;
        document.getElementById('mem-detail-text').textContent = `${freeMb} MB / ${totalMb} MB`;
        setGaugeArc('mem-gauge-bar', memPercent);

        // HDD Storage
        const hddPercent = Math.round(r.hddPercent || 0);
        const freeHddMb = Math.round((r.freeHdd || 0) / (1024 * 1024));
        const totalHddMb = Math.round((r.totalHdd || 0) / (1024 * 1024));
        document.getElementById('hdd-percent-text').textContent = `${hddPercent}%`;
        document.getElementById('hdd-fill').style.width = `${hddPercent}%`;
        document.getElementById('hdd-free-val').textContent = `Free: ${freeHddMb} MB`;
        document.getElementById('hdd-total-val').textContent = `Total: ${totalHddMb} MB`;

        // Host Server Info
        if (data.server) {
          document.getElementById('vital-node-ver').textContent = data.server.nodeVersion || '-';
          document.getElementById('vital-server-ram').textContent = `${data.server.hostMemoryUsedMb || '-'} / ${data.server.hostMemoryTotalMb || '-'} MB (${data.server.hostMemPercent || 0}%)`;
        }

        // 2. Traffic Calculations & Live Interfaces Matrix
        const ifaces = data.interfaces || [];
        document.getElementById('iface-count-badge').textContent = `${ifaces.length} Interfaces`;

        // Populate Interface Selector dropdown if empty or router changed
        const selector = document.getElementById('interface-chart-selector');
        if (selector.options.length <= 1) {
          ifaces.forEach(i => {
            const opt = document.createElement('option');
            opt.value = i.name;
            opt.textContent = `${i.name} (${i.type})`;
            selector.appendChild(opt);
          });
        }

        // Calculate Speeds
        let totalCurrentRxBps = 0;
        let totalCurrentTxBps = 0;
        let selectedIfaceRxBps = 0;
        let selectedIfaceTxBps = 0;

        const tableBody = document.getElementById('interfaces-tbody');
        let tableRowsHtml = '';

        ifaces.forEach(i => {
          const prev = previousTrafficSamples[i.name];
          let rxSpeedBps = 0;
          let txSpeedBps = 0;

          if (prev && prev.time < now) {
            const deltaSec = (now - prev.time) / 1000;
            if (deltaSec > 0 && deltaSec < 15) {
              const deltaRx = i.bytesIn >= prev.bytesIn ? (i.bytesIn - prev.bytesIn) : i.bytesIn;
              const deltaTx = i.bytesOut >= prev.bytesOut ? (i.bytesOut - prev.bytesOut) : i.bytesOut;
              rxSpeedBps = (deltaRx * 8) / deltaSec;
              txSpeedBps = (deltaTx * 8) / deltaSec;
            }
          }

          previousTrafficSamples[i.name] = {
            bytesIn: i.bytesIn,
            bytesOut: i.bytesOut,
            running: i.running,
            time: now
          };

          // Check if link went down for audio alert
          if (prev && prev.running && !i.running && !i.disabled) {
            playBeepAlert(440, 0.4); // Warning tone
          }

          if (i.running && !i.disabled) {
            totalCurrentRxBps += rxSpeedBps;
            totalCurrentTxBps += txSpeedBps;
          }

          if (selectedInterface === i.name) {
            selectedIfaceRxBps = rxSpeedBps;
            selectedIfaceTxBps = txSpeedBps;
          }

          const rxFormatted = formatSpeed(rxSpeedBps);
          const txFormatted = formatSpeed(txSpeedBps);
          const totalAccumulated = formatBytes(i.bytesIn + i.bytesOut);

          tableRowsHtml += `
            <tr>
              <td>
                <div class="iface-name-col">
                  <span class="link-led ${i.running ? 'up' : 'down'}" title="${i.running ? 'Link UP' : 'Link DOWN'}"></span>
                  <span>${i.name}</span>
                  ${i.comment ? `<span style="font-size:10px;color:var(--text-dim)">[${i.comment}]</span>` : ''}
                </div>
              </td>
              <td><span class="badge-pill">${i.type}</span></td>
              <td>
                <span style="font-size:10px;font-weight:700;color:${i.running ? 'var(--emerald)' : 'var(--rose)'}">
                  ${i.running ? 'RUNNING' : (i.disabled ? 'DISABLED' : 'DOWN')}
                </span>
              </td>
              <td style="text-align:right">
                <span class="rate-pill rx">↓ ${rxFormatted.val} ${rxFormatted.unit}</span>
              </td>
              <td style="text-align:right">
                <span class="rate-pill tx">↑ ${txFormatted.val} ${txFormatted.unit}</span>
              </td>
              <td style="text-align:right;font-family:'JetBrains Mono';font-size:11px;color:var(--text-muted)">
                ${totalAccumulated}
              </td>
            </tr>
          `;
        });

        tableBody.innerHTML = tableRowsHtml;

        // Chart & KPI values
        const chartRxBps = selectedInterface === '__ALL__' ? totalCurrentRxBps : selectedIfaceRxBps;
        const chartTxBps = selectedInterface === '__ALL__' ? totalCurrentTxBps : selectedIfaceTxBps;

        const rxFormattedTotal = formatSpeed(chartRxBps);
        const txFormattedTotal = formatSpeed(chartTxBps);
        const combinedBps = chartRxBps + chartTxBps;
        const combinedFormatted = formatSpeed(combinedBps);

        document.getElementById('kpi-rx-val').textContent = rxFormattedTotal.val;
        document.getElementById('kpi-rx-unit').textContent = rxFormattedTotal.unit;
        document.getElementById('kpi-tx-val').textContent = txFormattedTotal.val;
        document.getElementById('kpi-tx-unit').textContent = txFormattedTotal.unit;
        document.getElementById('kpi-total-bandwidth').innerHTML = `<i class="bi bi-activity"></i> Total: ${combinedFormatted.val} ${combinedFormatted.unit}`;
        document.getElementById('kpi-rx-interface').innerHTML = `<i class="bi bi-hdd-network"></i> ${selectedInterface === '__ALL__' ? 'All Interfaces' : selectedInterface}`;

        // Peak tracking
        const currentRxMbps = chartRxBps / (1000 * 1000);
        const currentTxMbps = chartTxBps / (1000 * 1000);
        if (currentRxMbps > peakRxRate) peakRxRate = currentRxMbps;
        if (currentTxMbps > peakTxRate) peakTxRate = currentTxMbps;
        document.getElementById('kpi-rx-peak').textContent = `Peak: ${peakRxRate.toFixed(1)} Mbps`;
        document.getElementById('kpi-tx-peak').textContent = `Peak: ${peakTxRate.toFixed(1)} Mbps`;

        // Update Chart
        const timeLabel = new Date().toTimeString().slice(3, 8);
        chartHistory.labels.push(timeLabel);
        chartHistory.rx.push(Number(currentRxMbps.toFixed(2)));
        chartHistory.tx.push(Number(currentTxMbps.toFixed(2)));

        if (chartHistory.labels.length > MAX_CHART_POINTS) {
          chartHistory.labels.shift();
          chartHistory.rx.shift();
          chartHistory.tx.shift();
        }

        const currentMax = Math.max(...chartHistory.rx, ...chartHistory.tx, 1);
        if (currentMax > maxHistoricalRate) maxHistoricalRate = currentMax;
        document.getElementById('chart-max-rate').textContent = `Max: ${maxHistoricalRate.toFixed(1)} Mbps`;

        if (trafficChart) {
          trafficChart.data.labels = chartHistory.labels;
          trafficChart.data.datasets[0].data = chartHistory.rx;
          trafficChart.data.datasets[1].data = chartHistory.tx;
          trafficChart.update('none'); // non-blocking update
        }

        // 3. Subscribers & Infrastructure (Right Column)
        const cl = data.clients || {};
        const pppoe = cl.pppoe || {};
        const hotspot = cl.hotspot || {};
        const acs = data.acs || {};
        const billing = cl.billing || {};

        // Top KPI
        document.getElementById('kpi-pppoe-online').textContent = pppoe.active || 0;
        document.getElementById('kpi-pppoe-total').textContent = `/ ${pppoe.total || 0} Total`;
        document.getElementById('kpi-pppoe-offline').innerHTML = `<i class="bi bi-circle-fill" style="color:${(pppoe.offline || 0) > 0 ? 'var(--rose)' : 'var(--text-dim)'};font-size:7px"></i> ${pppoe.offline || 0} Offline`;
        document.getElementById('kpi-pppoe-ratio').textContent = `${pppoe.activePercent || 0}% Active`;

        document.getElementById('kpi-hotspot-active').textContent = hotspot.active || 0;
        document.getElementById('kpi-hotspot-total').textContent = `/ ${hotspot.total || 0} Vouchers`;

        document.getElementById('kpi-ont-summary').innerHTML = `<i class="bi bi-modem"></i> ONT: ${acs.online || 0} Online`;
        if ((acs.critical || 0) > 0) {
          document.getElementById('kpi-optical-alert').textContent = `${acs.critical} Kritis!`;
          document.getElementById('kpi-optical-alert').style.color = 'var(--rose)';
        } else {
          document.getElementById('kpi-optical-alert').textContent = 'Fiber OK';
          document.getElementById('kpi-optical-alert').style.color = 'var(--emerald)';
        }

        // Right Column Bars
        document.getElementById('pppoe-ratio-num').textContent = `${pppoe.activePercent || 0}%`;
        document.getElementById('pppoe-bar-fill').style.width = `${pppoe.activePercent || 0}%`;
        document.getElementById('pppoe-bar-online').textContent = `Online: ${pppoe.active || 0}`;
        document.getElementById('pppoe-bar-offline').textContent = `Offline: ${pppoe.offline || 0}`;

        const hotspotPercent = (hotspot.total > 0) ? Math.round(((hotspot.active || 0) / hotspot.total) * 100) : 0;
        document.getElementById('hotspot-ratio-num').textContent = `${hotspotPercent}%`;
        document.getElementById('hotspot-bar-fill').style.width = `${hotspotPercent}%`;
        document.getElementById('hotspot-bar-active').textContent = `Active: ${hotspot.active || 0}`;
        document.getElementById('hotspot-bar-total').textContent = `Vouchers: ${hotspot.total || 0}`;

        const ontPercent = (acs.total > 0) ? Math.round(((acs.online || 0) / acs.total) * 100) : 0;
        document.getElementById('ont-ratio-num').textContent = `${ontPercent}%`;
        document.getElementById('ont-bar-fill').style.width = `${ontPercent}%`;
        document.getElementById('ont-bar-online').textContent = `Online: ${acs.online || 0} / ${acs.total || 0}`;
        document.getElementById('ont-bar-critical').textContent = `Kritis: ${acs.critical || 0}`;

        // Customer & Security
        document.getElementById('cust-active-val').textContent = `${billing.active || 0} Pelanggan`;
        document.getElementById('cust-suspended-val').textContent = `${billing.suspended || 0} Pelanggan`;
        document.getElementById('client-total-badge').textContent = `${(pppoe.active || 0) + (hotspot.active || 0)} Sesi Aktif`;
        document.getElementById('sec-blocked-val').textContent = `${data.security ? (data.security.blockedCount || 0) : 0} Kali`;

      } catch (err) {
        console.error('NOC Load Error:', err);
        document.getElementById('header-pulse-text').textContent = 'DISCONNECTED';
        document.getElementById('header-pulse').style.color = 'var(--rose)';
      }
    }
  </script>
</body>
</html>
