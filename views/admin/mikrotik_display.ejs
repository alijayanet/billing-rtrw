<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= title %> | <%= company %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <style>
    :root {
      --bg: #060813;
      --bg-surface: #0b0f1f;
      --card-bg: rgba(13, 18, 36, 0.78);
      --card-border: rgba(255, 255, 255, 0.08);
      --card-border-hover: rgba(59, 130, 246, 0.35);
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      
      --cyan: #00f2fe;
      --cyan-glow: rgba(0, 242, 254, 0.22);
      --emerald: #10b981;
      --emerald-glow: rgba(16, 185, 129, 0.22);
      --blue: #3b82f6;
      --blue-glow: rgba(59, 130, 246, 0.22);
      --purple: #8b5cf6;
      --purple-glow: rgba(139, 92, 246, 0.22);
      --amber: #f59e0b;
      --amber-glow: rgba(245, 158, 11, 0.22);
      --rose: #f43f5e;
      --rose-glow: rgba(244, 63, 94, 0.22);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100vh;
      max-height: 100vh;
      overflow: hidden;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      background-image: 
        radial-gradient(circle at 15% 15%, rgba(0, 242, 254, 0.04) 0%, transparent 40%),
        radial-gradient(circle at 85% 20%, rgba(59, 130, 246, 0.04) 0%, transparent 45%),
        linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 32px 32px, 32px 32px;
      color: var(--text);
      -webkit-font-smoothing: antialiased;
    }

    /* ZERO-SCROLL NOC VIEWPORT CONTAINER */
    .noc-container {
      height: 100vh;
      max-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 8px 12px;
      gap: 8px;
      box-sizing: border-box;
      overflow: hidden;
      max-width: 1920px;
      margin: 0 auto;
    }

    /* TOP HEADER (COMPACT 40px) */
    .noc-header {
      height: 42px;
      min-height: 42px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      padding: 4px 14px;
      border-radius: 10px;
      backdrop-filter: blur(14px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
      flex-shrink: 0;
    }

    .brand-section {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-icon-box {
      width: 30px;
      height: 30px;
      border-radius: 7px;
      background: linear-gradient(135deg, rgba(0, 242, 254, 0.2), rgba(59, 130, 246, 0.2));
      border: 1px solid rgba(0, 242, 254, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      color: var(--cyan);
      box-shadow: 0 0 10px var(--cyan-glow);
    }

    .brand-titles {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }

    .brand-name {
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      background: linear-gradient(90deg, #ffffff, #67e8f9, #60a5fa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .brand-sub {
      font-size: 11px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .status-pulse {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 9px;
      font-weight: 700;
      color: var(--emerald);
      padding: 1px 6px;
      border-radius: 10px;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .pulse-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--emerald);
      box-shadow: 0 0 6px var(--emerald);
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0% { transform: scale(0.9); opacity: 0.7; }
      50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 10px var(--emerald); }
      100% { transform: scale(0.9); opacity: 0.7; }
    }

    /* CENTER CLOCK */
    .clock-section {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .digital-clock {
      font-family: 'JetBrains Mono', monospace;
      font-size: 17px;
      font-weight: 800;
      letter-spacing: 1px;
      color: #ffffff;
      text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
    }

    .digital-date {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-muted);
      border-left: 1px solid rgba(255, 255, 255, 0.1);
      padding-left: 8px;
    }

    /* CONTROLS RIGHT */
    .controls-section {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .ctrl-select-wrap {
      position: relative;
    }

    .ctrl-select {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
      color: #ffffff;
      padding: 4px 24px 4px 8px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 600;
      appearance: none;
      cursor: pointer;
      outline: none;
      transition: all 0.2s;
    }
    .ctrl-select:focus {
      border-color: var(--cyan);
      box-shadow: 0 0 0 2px var(--cyan-glow);
    }

    .ctrl-select-icon {
      position: absolute;
      right: 7px;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
      font-size: 9px;
      color: var(--text-muted);
    }

    .btn-noc {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--card-border);
      color: #ffffff;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
    }
    .btn-noc:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.25);
      color: var(--cyan);
    }

    .btn-noc.active {
      background: var(--blue-glow);
      border-color: var(--blue);
      color: #93c5fd;
    }

    /* TOP KPI BAR (5 SLIM CARDS, STRICTLY 1 ROW) */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 8px;
      flex-shrink: 0;
    }

    .kpi-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 6px 12px;
      backdrop-filter: blur(14px);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1px;
      height: 58px;
      transition: border-color 0.2s;
    }
    .kpi-card:hover {
      border-color: var(--card-border-hover);
    }

    .kpi-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2.5px;
    }

    .kpi-card.cyan::before { background: linear-gradient(90deg, var(--cyan), transparent); }
    .kpi-card.emerald::before { background: linear-gradient(90deg, var(--emerald), transparent); }
    .kpi-card.blue::before { background: linear-gradient(90deg, var(--blue), transparent); }
    .kpi-card.purple::before { background: linear-gradient(90deg, var(--purple), transparent); }
    .kpi-card.amber::before { background: linear-gradient(90deg, var(--amber), transparent); }

    .kpi-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
    }

    .kpi-head i { font-size: 13px; }
    .kpi-card.cyan .kpi-head i { color: var(--cyan); }
    .kpi-card.emerald .kpi-head i { color: var(--emerald); }
    .kpi-card.blue .kpi-head i { color: var(--blue); }
    .kpi-card.purple .kpi-head i { color: var(--purple); }
    .kpi-card.amber .kpi-head i { color: var(--amber); }

    .kpi-value-row {
      display: flex;
      align-items: baseline;
      gap: 5px;
    }

    .kpi-value {
      font-family: 'JetBrains Mono', monospace;
      font-size: 20px;
      font-weight: 800;
      line-height: 1;
      color: #ffffff;
    }
    .kpi-unit {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-muted);
    }

    .kpi-sub {
      font-size: 10px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: space-between;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .badge-pill {
      font-size: 9px;
      font-weight: 700;
      padding: 1px 5px;
      border-radius: 5px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
      white-space: nowrap;
    }

    /* MAIN BODY 3-COLUMNS (ZERO SCROLL, FILL REMAINING HEIGHT) */
    .noc-main {
      display: grid;
      grid-template-columns: 240px 1fr 250px;
      gap: 8px;
      flex: 1;
      min-height: 0;
      overflow: hidden;
    }

    .col-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 10px 12px;
      backdrop-filter: blur(14px);
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-height: 0;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
      overflow: hidden;
    }

    .card-title-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--text-muted);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      padding-bottom: 6px;
      flex-shrink: 0;
      gap: 6px;
    }

    .card-title-bar > div:first-child {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .card-title-bar i {
      color: var(--cyan);
      font-size: 13px;
      margin-right: 5px;
    }

    /* RADIAL GAUGES (LEFT COL) */
    .gauges-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      flex-shrink: 0;
    }

    .gauge-box {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 8px 4px;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
    }

    .gauge-svg-wrap {
      width: 72px;
      height: 72px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .gauge-svg {
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
    }

    .gauge-bg {
      fill: none;
      stroke: rgba(255, 255, 255, 0.06);
      stroke-width: 6;
    }

    .gauge-bar {
      fill: none;
      stroke-width: 6;
      stroke-linecap: round;
      transition: stroke-dashoffset 0.8s ease, stroke 0.3s;
    }

    .gauge-label-center {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .gauge-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: 16px;
      font-weight: 800;
      line-height: 1;
    }

    .gauge-title {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-top: 4px;
    }

    .gauge-detail {
      font-size: 9px;
      color: var(--text-dim);
      font-family: 'JetBrains Mono', monospace;
      margin-top: 1px;
    }

    /* STAT PROGRESS BAR BOX */
    .stat-bar-box {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 8px 10px;
      display: flex;
      flex-direction: column;
      gap: 5px;
      flex-shrink: 0;
    }

    .stat-bar-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      font-weight: 600;
    }

    .ratio-bar {
      height: 6px;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 3px;
      overflow: hidden;
      position: relative;
    }

    .ratio-fill {
      height: 100%;
      border-radius: 3px;
      transition: width 0.6s ease;
    }

    .ratio-fill.blue { background: linear-gradient(90deg, #3b82f6, #00f2fe); }
    .ratio-fill.emerald { background: linear-gradient(90deg, #10b981, #34d399); }
    .ratio-fill.purple { background: linear-gradient(90deg, #8b5cf6, #c084fc); }

    .ratio-labels {
      display: flex;
      justify-content: space-between;
      font-size: 10px;
      color: var(--text-muted);
      font-family: 'JetBrains Mono', monospace;
    }

    /* ROUTER INFO LIST */
    .vitals-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 8px 10px;
      flex-shrink: 0;
    }

    .vital-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
    }

    .vital-key {
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .vital-val {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      color: #ffffff;
      font-size: 11px;
    }

    /* CENTER COLUMN: WAVE CHART + INTERFACES */
    .center-section {
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-height: 0;
      flex: 1;
      overflow: hidden;
    }

    .chart-box {
      flex: 1.25;
      min-height: 160px;
      display: flex;
      flex-direction: column;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 10px 12px;
      overflow: hidden;
    }

    .chart-controls {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .chart-canvas-wrap {
      flex: 1;
      min-height: 110px;
      position: relative;
      width: 100%;
      margin-top: 6px;
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.04);
      border-radius: 8px;
      padding: 4px;
    }

    .chart-canvas-wrap canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100% !important;
      height: 100% !important;
    }

    .interfaces-box {
      flex: 1;
      min-height: 120px;
      display: flex;
      flex-direction: column;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 8px 12px;
      overflow: hidden;
    }

    .iface-filter-tabs {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .tab-pill {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--card-border);
      color: var(--text-muted);
      font-size: 10px;
      font-weight: 600;
      padding: 2px 7px;
      border-radius: 5px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .tab-pill:hover, .tab-pill.active {
      background: rgba(0, 242, 254, 0.15);
      border-color: var(--cyan);
      color: #ffffff;
    }

    .iface-table-wrap {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      margin-top: 6px;
    }

    .iface-table-wrap::-webkit-scrollbar {
      width: 5px;
    }
    .iface-table-wrap::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.2);
    }
    .iface-table-wrap::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.15);
      border-radius: 3px;
    }

    .noc-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 11px;
      text-align: left;
    }

    .noc-table th {
      position: sticky;
      top: 0;
      background: #090e1f;
      color: var(--text-muted);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 9.5px;
      letter-spacing: 0.5px;
      padding: 4px 6px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      z-index: 2;
    }

    .noc-table td {
      padding: 4px 6px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.03);
      vertical-align: middle;
    }

    .noc-table tr:hover {
      background: rgba(255, 255, 255, 0.02);
    }

    .iface-name-col {
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: 600;
      font-family: 'JetBrains Mono', monospace;
    }

    .link-led {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .link-led.up {
      background: var(--emerald);
      box-shadow: 0 0 6px var(--emerald);
    }
    .link-led.down {
      background: var(--rose);
      box-shadow: 0 0 6px var(--rose);
    }

    .rate-pill {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      font-size: 10px;
    }
    .rate-pill.rx { color: var(--cyan); }
    .rate-pill.tx { color: var(--emerald); }

    /* LOADING OVERLAY */
    .noc-overlay {
      position: fixed;
      inset: 0;
      background: #060813;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      z-index: 9999;
      transition: opacity 0.4s ease;
    }

    .noc-spinner {
      width: 44px;
      height: 44px;
      border: 3px solid rgba(0, 242, 254, 0.15);
      border-top-color: var(--cyan);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>

  <!-- LOADING OVERLAY -->
  <div id="loading-overlay" class="noc-overlay">
    <div class="noc-spinner"></div>
    <div style="font-size:12px; font-weight:700; letter-spacing:1px; color:#94a3b8; text-transform:uppercase;">
      Menghubungkan ke NOC Telemetry...
    </div>
  </div>

  <div class="noc-container">

    <!-- TOP HEADER -->
    <header class="noc-header">
      <div class="brand-section">
        <div class="brand-icon-box">
          <i class="bi bi-broadcast"></i>
        </div>
        <div class="brand-titles">
          <div class="brand-name"><%= company %> NOC</div>
          <div class="brand-sub">
            <span class="status-pulse" id="header-pulse">
              <span class="pulse-dot"></span>
              <span id="header-pulse-text">OPERATIONAL</span>
            </span>
            <span id="board-model-badge" style="font-family:'JetBrains Mono';font-size:10px;color:var(--text-dim)">
              <i class="bi bi-hdd-network"></i> Router MikroTik
            </span>
          </div>
        </div>
      </div>

      <!-- CENTER DIGITAL CLOCK -->
      <div class="clock-section">
        <div class="digital-clock" id="live-clock">--:--:-- WIB</div>
        <div class="digital-date" id="live-date">Memuat tanggal...</div>
      </div>

      <!-- CONTROLS -->
      <div class="controls-section">
        <!-- Router Selector -->
        <div class="ctrl-select-wrap">
          <select id="router-select" class="ctrl-select" onchange="switchRouter()">
            <% routers.forEach(r => { %>
              <option value="<%= r.id %>"><%= r.name %></option>
            <% }) %>
          </select>
          <i class="bi bi-chevron-down ctrl-select-icon"></i>
        </div>

        <!-- Refresh Interval Selector -->
        <div class="ctrl-select-wrap">
          <select id="refresh-interval-select" class="ctrl-select" onchange="updatePollInterval()">
            <option value="1500">1.5s (Turbo)</option>
            <option value="2500" selected>2.5s (Normal)</option>
            <option value="5000">5s (Eco)</option>
          </select>
          <i class="bi bi-chevron-down ctrl-select-icon"></i>
        </div>

        <!-- Auto-cycle if > 1 router -->
        <% if (routers && routers.length > 1) { %>
        <button id="cycle-toggle-btn" class="btn-noc" onclick="toggleAutoCycle()" title="Rotasi router otomatis setiap 20 detik">
          <i class="bi bi-arrow-repeat"></i>
          <span id="cycle-btn-text">Rotasi</span>
        </button>
        <% } %>

        <!-- Audio Alert Toggle -->
        <button id="audio-toggle-btn" class="btn-noc" onclick="toggleAudioAlert()" title="Bunyi alarm jika link interface down">
          <i class="bi bi-volume-mute" id="audio-btn-icon"></i>
          <span id="audio-btn-text">Audio</span>
        </button>

        <!-- Fullscreen Button -->
        <button class="btn-noc" onclick="toggleFullscreen()" title="Masuk Mode Layar Penuh (F11)">
          <i class="bi bi-fullscreen" id="fs-icon"></i>
          <span id="fs-text">Fullscreen</span>
        </button>

        <!-- Exit Link -->
