  <!-- Local Chart.js 4.4 with CDN Fallback -->
  <script src="/js/chart.umd.js"></script>
  <script>
    if (typeof Chart === 'undefined') {
      document.write('<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"><\/script>');
    }
  </script>

  <script>
    'use strict';

    // Global State
    let pollInterval = null;
    let pollIntervalMs = 2500;
    let trafficChart = null;
    let selectedInterface = '__WAN__';
    let currentIfaceFilter = 'wan_phy'; // 'wan_phy', 'all', 'pppoe'
    let isAutoCycleEnabled = false;
    let cycleTimer = null;
    let isAudioAlertEnabled = false;
    let peakRxRate = 0;
    let peakTxRate = 0;
    let maxHistoricalRate = 0;
    let lastKnownWanName = 'ether1-ISP';
    let latestInterfacesData = [];

    // AI Voice & Announcer State
    let isNocVoiceEnabled = false;
    let isAiVoiceSpeaking = false;
    let aiVoiceAudio = new Audio();
    let speechRecognizer = null;
    let isListeningVoice = false;
    let lastAnnouncerState = {
      downIfaces: new Set(),
      lastCpuAlertTime: 0,
      lastCriticalAcs: 0,
      lastBlockedCount: 0,
      lastBriefingHour: -1
    };

    let chartHistory = {
      labels: [],
      rx: [],
      tx: []
    };
    const MAX_CHART_POINTS = 30;

    // Toggle AI Voice ON / OFF
    function toggleNocVoice(forceState) {
      if (typeof forceState === 'boolean') {
        isNocVoiceEnabled = forceState;
      } else {
        isNocVoiceEnabled = !isNocVoiceEnabled;
      }

      const btn = document.getElementById('ai-voice-toggle-btn');
      const icon = document.getElementById('ai-voice-btn-icon');
      const text = document.getElementById('ai-voice-btn-text');
      const hud = document.getElementById('ai-voice-hud');

      if (isNocVoiceEnabled) {
        btn.classList.add('active');
        icon.className = 'bi bi-mic-fill';
        icon.style.color = 'var(--cyan)';
        text.textContent = 'Voice: ON';
        hud.classList.add('active');
        document.getElementById('ai-hud-msg').textContent = 'AI Voice aktif • Siap memantau';
        speakNocVoice('Asisten Suara NOC Alijaya Net aktif. Sistem siap memantau jaringan.');
      } else {
        btn.classList.remove('active');
        icon.className = 'bi bi-mic';
        icon.style.color = '';
        text.textContent = 'AI Voice';
        hud.classList.remove('active');
        stopNocVoice();
      }
    }

    // Speak AI Voice Announcement or Response
    function speakNocVoice(text, onComplete) {
      if (!isNocVoiceEnabled) return;
      stopNocVoice();

      isAiVoiceSpeaking = true;
      const hud = document.getElementById('ai-voice-hud');
      const hudMsg = document.getElementById('ai-hud-msg');
      if (hud) hud.classList.add('speaking', 'active');
      if (hudMsg) hudMsg.textContent = text;

      // Try Google TTS via server endpoint first
      const ttsUrl = `/api/noc/ai-voice/tts?text=${encodeURIComponent(text)}`;
      aiVoiceAudio.src = ttsUrl;
      aiVoiceAudio.play().then(() => {
        aiVoiceAudio.onended = () => {
          finishNocVoiceSpeech(onComplete);
        };
      }).catch(err => {
        // Fallback to browser SpeechSynthesis
        speakWithBrowserSpeech(text, onComplete);
      });
    }

    function speakWithBrowserSpeech(text, onComplete) {
      if (!window.speechSynthesis) {
        finishNocVoiceSpeech(onComplete);
        return;
      }
      try {
        window.speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(text);
        u.lang = 'id-ID';
        u.rate = 1.05;
        u.pitch = 1.0;
        const voices = window.speechSynthesis.getVoices() || [];
        const idVoice = voices.find(v => v.lang.startsWith('id') || v.name.toLowerCase().includes('indonesia'));
        if (idVoice) u.voice = idVoice;

        u.onend = () => finishNocVoiceSpeech(onComplete);
        u.onerror = () => finishNocVoiceSpeech(onComplete);
        window.speechSynthesis.speak(u);
      } catch (e) {
        finishNocVoiceSpeech(onComplete);
      }
    }

    function finishNocVoiceSpeech(onComplete) {
      isAiVoiceSpeaking = false;
      const hud = document.getElementById('ai-voice-hud');
      if (hud) hud.classList.remove('speaking');
      if (typeof onComplete === 'function') onComplete();
    }

    function stopNocVoice() {
      try {
        aiVoiceAudio.pause();
        aiVoiceAudio.currentTime = 0;
      } catch (_) {}
      if (window.speechSynthesis) {
        window.speechSynthesis.cancel();
      }
      isAiVoiceSpeaking = false;
      const hud = document.getElementById('ai-voice-hud');
      if (hud) hud.classList.remove('speaking');
    }

    // Voice Command / Speech Recognition
    function startNocVoiceRecognition() {
      if (!isNocVoiceEnabled) {
        toggleNocVoice(true);
      }
      stopNocVoice();

      const SpeechRec = window.webkitSpeechRecognition || window.SpeechRecognition;
      if (!SpeechRec) {
        speakNocVoice('Peramban Anda tidak mendukung input suara.');
        return;
      }

      try {
        if (speechRecognizer) {
          speechRecognizer.abort();
        }
        speechRecognizer = new SpeechRec();
        speechRecognizer.lang = 'id-ID';
        speechRecognizer.continuous = false;
        speechRecognizer.interimResults = false;

        const orb = document.getElementById('ai-orb-btn');
        const hudMsg = document.getElementById('ai-hud-msg');

        speechRecognizer.onstart = () => {
          isListeningVoice = true;
          if (orb) orb.classList.add('listening');
          if (hudMsg) hudMsg.textContent = 'Mendengarkan suara Anda...';
        };

        speechRecognizer.onresult = async (event) => {
          const transcript = event.results[0][0].transcript.trim();
          if (hudMsg) hudMsg.textContent = `"${transcript}"`;
          await handleNocVoiceCommand(transcript);
        };

        speechRecognizer.onerror = (event) => {
          console.warn('Speech error:', event.error);
          if (orb) orb.classList.remove('listening');
          isListeningVoice = false;
          if (hudMsg) hudMsg.textContent = 'Tidak mendengar suara. Coba lagi.';
        };

        speechRecognizer.onend = () => {
          if (orb) orb.classList.remove('listening');
          isListeningVoice = false;
        };

        speechRecognizer.start();
      } catch (e) {
        console.error('Speech recognition error:', e);
      }
    }

    // Handle Quick Local Voice Commands & AI Queries
    async function handleNocVoiceCommand(text) {
      const lower = text.toLowerCase();
      const hudMsg = document.getElementById('ai-hud-msg');

      // 1. Quick Local Commands
      if (lower.includes('layar penuh') || lower.includes('fullscreen')) {
        toggleFullscreen();
        speakNocVoice('Mengubah mode layar penuh.');
        return;
      }
      if (lower.includes('rotasi') || lower.includes('carousel')) {
        toggleAutoCycle();
        speakNocVoice(isAutoCycleEnabled ? 'Rotasi router diaktifkan.' : 'Rotasi router dimatikan.');
        return;
      }
      if (lower.includes('semua interface') || lower.includes('semua antarmuka')) {
        setIfaceFilter('all');
        speakNocVoice('Menampilkan semua antarmuka jaringan.');
        return;
      }
      if (lower.includes('physical') || lower.includes('fisik') || lower.includes('vlan')) {
        setIfaceFilter('wan_phy');
        speakNocVoice('Menampilkan antarmuka fisik dan vlan.');
        return;
      }
      if (lower.includes('pppoe')) {
        setIfaceFilter('pppoe');
        speakNocVoice('Menampilkan sesi dinamis pe pe po e.');
        return;
      }
      if (lower.includes('matikan suara') || lower.includes('diam') || lower.includes('bisu')) {
        toggleNocVoice(false);
        return;
      }

      // 2. Query to AI Backend
      if (hudMsg) hudMsg.textContent = 'Meminta jawaban AI...';
      try {
        const res = await fetch('/api/noc/ai-voice/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: text })
        });
        const result = await res.json();
        if (result.ok && (result.speechText || result.text)) {
          const toSpeak = result.speechText || result.text;
          speakNocVoice(toSpeak);
        } else {
          speakNocVoice('Maaf, saya tidak dapat menemukan data tersebut saat ini.');
        }
      } catch (e) {
        console.error('AI voice ask error:', e);
        speakNocVoice('Gagal menghubungi asisten AI.');
      }
    }

    // Web Audio Synthesizer for Outage Alerts
    let audioCtx = null;
    function playBeepAlert(freq = 660, duration = 0.25) {
      if (!isAudioAlertEnabled) return;
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (_) {}
    }

    // FanRuan Visual Themes Switcher
    function switchTheme(theme) {
      if (!theme) theme = 'cyberpunk';
      document.documentElement.setAttribute('data-theme', theme);
      try {
        localStorage.setItem('noc_theme', theme);
      } catch (_) {}
      const sel = document.getElementById('theme-selector');
      if (sel && sel.value !== theme) sel.value = theme;

      // Update Chart Colors dynamically to match theme
      if (trafficChart) {
        const computed = getComputedStyle(document.documentElement);
        const cyan = computed.getPropertyValue('--cyan').trim() || '#00f2fe';
        const emerald = computed.getPropertyValue('--emerald').trim() || '#10b981';

        const canvas = document.getElementById('traffic-live-chart');
        if (canvas) {
          const ctx = canvas.getContext('2d');
          const rxGrad = ctx.createLinearGradient(0, 0, 0, 160);
          rxGrad.addColorStop(0, cyan + '50');
          rxGrad.addColorStop(1, cyan + '00');

          const txGrad = ctx.createLinearGradient(0, 0, 0, 160);
          txGrad.addColorStop(0, emerald + '50');
          txGrad.addColorStop(1, emerald + '00');

          trafficChart.data.datasets[0].borderColor = cyan;
          trafficChart.data.datasets[0].backgroundColor = rxGrad;
          trafficChart.data.datasets[0].pointHoverBackgroundColor = cyan;

          trafficChart.data.datasets[1].borderColor = emerald;
          trafficChart.data.datasets[1].backgroundColor = txGrad;
          trafficChart.data.datasets[1].pointHoverBackgroundColor = emerald;
          trafficChart.update('none');
        }
      }
    }

    // On DOM Ready
    document.addEventListener('DOMContentLoaded', () => {
      try {
        const savedTheme = localStorage.getItem('noc_theme') || 'cyberpunk';
        switchTheme(savedTheme);
      } catch (_) {}
      startClock();
      try {
        initChart();
      } catch (e) {
        console.error('Failed to init chart:', e);
      }
      loadData();
      startPolling();

      // Android TV Leanback detection: hide unnecessary desktop buttons on TV screen
      if (navigator.userAgent.includes('AlijayaNocTV')) {
        const apkBtn = document.querySelector('a[href*="noc-tv"]');
        if (apkBtn) apkBtn.style.display = 'none';
        const exitBtn = document.querySelector('a[href="/admin/mikrotik"]');
        if (exitBtn) exitBtn.style.display = 'none';
      }

      // TV Remote & Keyboard Shortcuts: 1..5 for Theme, V for Voice, A for Audio, R for Cycle, F for Fullscreen
      document.addEventListener('keydown', (e) => {
        if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT')) return;
        if (e.key === '1') switchTheme('cyberpunk');
        else if (e.key === '2') switchTheme('matrix');
        else if (e.key === '3') switchTheme('sapphire');
        else if (e.key === '4') switchTheme('amoled');
        else if (e.key === '5') switchTheme('amber');
        else if (e.key === 'v' || e.key === 'V') toggleNocVoice();
        else if (e.key === 'a' || e.key === 'A') toggleAudioAlert();
        else if (e.key === 'r' || e.key === 'R') toggleAutoCycle();
        else if (e.key === 'f' || e.key === 'F') toggleFullscreen();
      });
    });

    // High-Tech Digital Clock
    function startClock() {
      const clockEl = document.getElementById('live-clock');
      const dateEl = document.getElementById('live-date');
      const days = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];

      function tick() {
        const now = new Date();
        const h = String(now.getHours()).padStart(2, '0');
        const m = String(now.getMinutes()).padStart(2, '0');
        const s = String(now.getSeconds()).padStart(2, '0');
        clockEl.textContent = `${h}:${m}:${s} WIB`;

        const dayName = days[now.getDay()];
        const d = now.getDate();
        const monthName = months[now.getMonth()];
        const y = now.getFullYear();
        dateEl.textContent = `${dayName}, ${d} ${monthName} ${y}`;
      }
      tick();
      setInterval(tick, 1000);
    }

    // Initialize Chart.js with Neon Glowing Gradient
    function initChart() {
      if (typeof Chart === 'undefined') return;
      const canvasEl = document.getElementById('traffic-live-chart');
      if (!canvasEl) return;
      const ctx = canvasEl.getContext('2d');

      const rxGradient = ctx.createLinearGradient(0, 0, 0, 160);
      rxGradient.addColorStop(0, 'rgba(0, 242, 254, 0.32)');
      rxGradient.addColorStop(1, 'rgba(0, 242, 254, 0.00)');

      const txGradient = ctx.createLinearGradient(0, 0, 0, 160);
      txGradient.addColorStop(0, 'rgba(16, 185, 129, 0.32)');
      txGradient.addColorStop(1, 'rgba(16, 185, 129, 0.00)');

      trafficChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: [],
          datasets: [
            {
              label: 'Download (RX)',
              data: [],
              borderColor: '#00f2fe',
              backgroundColor: rxGradient,
              borderWidth: 2,
              fill: true,
              tension: 0.35,
              pointRadius: 1,
              pointHoverRadius: 5,
              pointHoverBackgroundColor: '#00f2fe'
            },
            {
              label: 'Upload (TX)',
              data: [],
              borderColor: '#10b981',
              backgroundColor: txGradient,
              borderWidth: 2,
              fill: true,
              tension: 0.35,
              pointRadius: 1,
              pointHoverRadius: 5,
              pointHoverBackgroundColor: '#10b981'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: 250 },
          plugins: {
            legend: {
              position: 'top',
              align: 'end',
              labels: {
                color: '#94a3b8',
                boxWidth: 10,
                font: { family: 'Inter', size: 10, weight: '600' }
              }
            },
            tooltip: {
              mode: 'index',
              intersect: false,
              backgroundColor: 'rgba(11, 15, 31, 0.95)',
              borderColor: 'rgba(255, 255, 255, 0.1)',
              borderWidth: 1,
              titleColor: '#f8fafc',
              bodyColor: '#cbd5e1',
              titleFont: { family: 'JetBrains Mono', size: 10 },
              bodyFont: { family: 'JetBrains Mono', size: 11 },
              callbacks: {
                label: function(context) {
                  return ` ${context.dataset.label}: ${context.parsed.y.toFixed(2)} Mbps`;
                }
              }
            }
          },
          scales: {
            x: {
              grid: { color: 'rgba(255, 255, 255, 0.03)' },
              ticks: { color: '#64748b', font: { family: 'JetBrains Mono', size: 9 }, maxTicksLimit: 12 }
            },
            y: {
              beginAtZero: true,
              grid: { color: 'rgba(255, 255, 255, 0.03)' },
              ticks: {
                color: '#64748b',
                font: { family: 'JetBrains Mono', size: 9 },
                callback: function(v) { return v.toFixed(0) + ' M'; }
              }
            }
          }
        }
      });
    }

    // Format Speed
    function formatSpeed(bps) {
      if (bps >= 1000 * 1000 * 1000) {
        return { val: (bps / (1000 * 1000 * 1000)).toFixed(2), unit: 'Gbps' };
      }
      if (bps >= 1000 * 1000) {
        return { val: (bps / (1000 * 1000)).toFixed(2), unit: 'Mbps' };
      }
      if (bps >= 1000) {
        return { val: (bps / 1000).toFixed(1), unit: 'kbps' };
      }
      return { val: Math.round(bps).toString(), unit: 'bps' };
    }

    function formatBytes(bytes) {
      if (!bytes || bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return (bytes / Math.pow(k, i)).toFixed(1) + ' ' + sizes[i];
    }

    // Set SVG Radial Arc (FanRuan 80x80 Donut Gauge, R=31)
    function setGaugeArc(circleId, percent) {
      const el = document.getElementById(circleId);
      if (!el) return;
      const circumference = 194.8; // 2 * PI * 31
      const offset = circumference - (Math.min(100, Math.max(0, percent)) / 100) * circumference;
      el.style.strokeDashoffset = offset;
    }

    // Polling Manager
    function startPolling() {
      if (pollInterval) clearInterval(pollInterval);
      pollInterval = setInterval(loadData, pollIntervalMs);
    }

    function updatePollInterval() {
      const select = document.getElementById('refresh-interval-select');
      pollIntervalMs = Number(select.value) || 2500;
      startPolling();
    }

    // Interface Filter Tab Switcher
    function setIfaceFilter(filter) {
      currentIfaceFilter = filter;
      document.getElementById('tab-btn-phy').classList.toggle('active', filter === 'wan_phy');
      document.getElementById('tab-btn-all').classList.toggle('active', filter === 'all');
      document.getElementById('tab-btn-ppp').classList.toggle('active', filter === 'pppoe');
      renderInterfaceTable();
    }

    // Router Selector & Switcher
    function switchRouter() {
      chartHistory = { labels: [], rx: [], tx: [] };
      peakRxRate = 0;
      peakTxRate = 0;
      maxHistoricalRate = 0;
      if (trafficChart) {
        trafficChart.data.labels = [];
        trafficChart.data.datasets[0].data = [];
        trafficChart.data.datasets[1].data = [];
        trafficChart.update();
      }
      const overlay = document.getElementById('loading-overlay');
      overlay.style.opacity = '1';
      overlay.style.pointerEvents = 'auto';
      loadData();
    }

    // Auto-Cycle Routers Toggle (every 20s)
    function toggleAutoCycle() {
      isAutoCycleEnabled = !isAutoCycleEnabled;
      const btn = document.getElementById('cycle-toggle-btn');
      const text = document.getElementById('cycle-btn-text');
      if (isAutoCycleEnabled) {
        btn.classList.add('active');
        text.textContent = 'Rotasi: ON';
        cycleTimer = setInterval(() => {
          const select = document.getElementById('router-select');
          let nextIndex = select.selectedIndex + 1;
          if (nextIndex >= select.options.length) nextIndex = 0;
          select.selectedIndex = nextIndex;
          switchRouter();
        }, 20000);
      } else {
        btn.classList.remove('active');
        text.textContent = 'Rotasi';
        if (cycleTimer) clearInterval(cycleTimer);
      }
    }

    // Audio Alert Toggle
    function toggleAudioAlert() {
      isAudioAlertEnabled = !isAudioAlertEnabled;
      const btn = document.getElementById('audio-toggle-btn');
      const icon = document.getElementById('audio-btn-icon');
      const text = document.getElementById('audio-btn-text');
      if (isAudioAlertEnabled) {
        btn.classList.add('active');
        icon.className = 'bi bi-volume-up';
        text.textContent = 'Audio: ON';
        playBeepAlert(880, 0.15);
      } else {
        btn.classList.remove('active');
        icon.className = 'bi bi-volume-mute';
        text.textContent = 'Audio';
      }
    }

    // Fullscreen Mode
    function toggleFullscreen() {
      const icon = document.getElementById('fs-icon');
      const text = document.getElementById('fs-text');
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().then(() => {
          icon.className = 'bi bi-fullscreen-exit';
          text.textContent = 'Exit Screen';
        }).catch(err => console.error(err));
      } else {
        document.exitFullscreen().then(() => {
          icon.className = 'bi bi-fullscreen';
          text.textContent = 'Fullscreen';
        });
      }
    }

    // Switch Interface for Live Traffic Chart
    function switchChartInterface() {
      selectedInterface = document.getElementById('interface-chart-selector').value;
      chartHistory = { labels: [], rx: [], tx: [] };
      peakRxRate = 0;
      peakTxRate = 0;
      maxHistoricalRate = 0;
      if (trafficChart) {
        trafficChart.data.labels = [];
        trafficChart.data.datasets[0].data = [];
        trafficChart.data.datasets[1].data = [];
        trafficChart.update();
      }
      loadData();
    }

    // Render Interface Table
    function renderInterfaceTable() {
      const tableBody = document.getElementById('interfaces-tbody');
      if (!tableBody) return;

      const ifaces = latestInterfacesData || [];
      let filtered = ifaces;
      if (currentIfaceFilter === 'wan_phy') {
        filtered = ifaces.filter(i => i.isWan || !i.isDynamic);
      } else if (currentIfaceFilter === 'pppoe') {
        filtered = ifaces.filter(i => i.isDynamic);
      }

      document.getElementById('iface-count-badge').textContent = `${filtered.length} / ${ifaces.length} Iface`;

      if (filtered.length === 0) {
        tableBody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text-dim);padding:14px">Tidak ada interface untuk filter ini.</td></tr>';
        return;
      }

      let rowsHtml = '';
      filtered.forEach(i => {
        const rxFormatted = formatSpeed(i.rxSpeedBps || 0);
        const txFormatted = formatSpeed(i.txSpeedBps || 0);
        const totalAccumulated = formatBytes((i.bytesIn || 0) + (i.bytesOut || 0));

        rowsHtml += `
          <tr>
            <td>
              <div class="iface-name-col">
                <span class="link-led ${i.running ? 'up' : 'down'}" title="${i.running ? 'Link UP' : 'Link DOWN'}"></span>
                <span style="${i.isWan ? 'color:var(--cyan);font-weight:700' : ''}">${i.name}</span>
                ${i.isWan ? '<span class="badge-pill" style="color:var(--cyan);border-color:var(--cyan)">WAN</span>' : ''}
                ${i.comment ? `<span style="font-size:9.5px;color:var(--text-dim)">[${i.comment}]</span>` : ''}
              </div>
            </td>
            <td><span class="badge-pill">${i.type}</span></td>
            <td>
              <span style="font-size:9.5px;font-weight:700;color:${i.running ? 'var(--emerald)' : 'var(--rose)'}">
                ${i.running ? 'UP' : (i.disabled ? 'DIS' : 'DOWN')}
              </span>
            </td>
            <td style="text-align:right">
              <span class="rate-pill rx">↓ ${rxFormatted.val} ${rxFormatted.unit}</span>
            </td>
            <td style="text-align:right">
              <span class="rate-pill tx">↑ ${txFormatted.val} ${txFormatted.unit}</span>
            </td>
            <td style="text-align:right;font-family:'JetBrains Mono';font-size:10px;color:var(--text-muted)">
              ${totalAccumulated}
            </td>
          </tr>
        `;
      });

      tableBody.innerHTML = rowsHtml;
    }

    // Main Data Fetcher
    async function loadData() {
      const routerId = document.getElementById('router-select').value;
      const now = Date.now();

      try {
        const url = `/api/noc/data?routerId=${encodeURIComponent(routerId)}&_t=${now}`;
        const res = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();

        // Hide overlay on success
        const overlay = document.getElementById('loading-overlay');
        overlay.style.opacity = '0';
        overlay.style.pointerEvents = 'none';

        // Update Pulse status
        document.getElementById('header-pulse-text').textContent = data.warning ? 'DEGRADED' : 'OPERATIONAL';
        document.getElementById('header-pulse').style.color = data.warning ? 'var(--amber)' : 'var(--emerald)';

        // 1. Hardware Vitals (Router)
        const r = data.router || {};
        document.getElementById('board-model-badge').innerHTML = `<i class="bi bi-hdd-network"></i> ${r.boardName || 'MikroTik'} (${r.version || ''})`;
        document.getElementById('vital-board-name').textContent = r.boardName || '-';
        document.getElementById('vital-version').textContent = r.version || '-';
        document.getElementById('vital-cpu-freq').textContent = `${r.cpuFrequency || '-'} MHz (${r.cpuCount || 1} Cores)`;
        document.getElementById('router-uptime-badge').textContent = `Up: ${r.uptime || '-'}`;

        // Voltage & Temp
        if (r.temperature !== null && r.temperature !== undefined) {
          document.getElementById('kpi-temp-val').textContent = r.temperature;
          document.getElementById('vital-temp').textContent = `${r.temperature} °C`;
          if (r.temperature >= 60) document.getElementById('kpi-temp-val').style.color = 'var(--rose)';
          else if (r.temperature >= 50) document.getElementById('kpi-temp-val').style.color = 'var(--amber)';
          else document.getElementById('kpi-temp-val').style.color = '#ffffff';
        } else {
          document.getElementById('kpi-temp-val').textContent = '--';
          document.getElementById('vital-temp').textContent = '-';
        }

        if (r.voltage !== null && r.voltage !== undefined) {
          document.getElementById('kpi-volt-val').textContent = r.voltage;
          document.getElementById('vital-voltage').textContent = `${r.voltage} V`;
        } else {
          document.getElementById('kpi-volt-val').textContent = '--';
          document.getElementById('vital-voltage').textContent = '-';
        }

        // CPU Radial Arc & Status Pill (FanRuan Donut)
        const cpuVal = Math.round(r.cpuLoad || 0);
        document.getElementById('cpu-gauge-num').textContent = `${cpuVal}%`;
        document.getElementById('cpu-detail-text').textContent = `${r.cpuCount || 1} Cores`;
        setGaugeArc('cpu-gauge-bar', cpuVal);
        const cpuBar = document.getElementById('cpu-gauge-bar');
        const cpuNum = document.getElementById('cpu-gauge-num');
        const cpuPill = document.getElementById('cpu-status-pill');
        if (cpuVal >= 90) {
          cpuBar.setAttribute('stroke', 'var(--rose)');
          cpuNum.style.color = 'var(--rose)';
          if (cpuPill) { cpuPill.textContent = 'CRITICAL'; cpuPill.style.color = 'var(--rose)'; }
        } else if (cpuVal >= 75) {
          cpuBar.setAttribute('stroke', 'var(--amber)');
          cpuNum.style.color = 'var(--amber)';
          if (cpuPill) { cpuPill.textContent = 'HIGH'; cpuPill.style.color = 'var(--amber)'; }
        } else if (cpuVal >= 50) {
          cpuBar.setAttribute('stroke', 'var(--cyan)');
          cpuNum.style.color = 'var(--cyan)';
          if (cpuPill) { cpuPill.textContent = 'NORMAL'; cpuPill.style.color = 'var(--cyan)'; }
        } else {
          cpuBar.setAttribute('stroke', 'var(--emerald)');
          cpuNum.style.color = 'var(--emerald)';
          if (cpuPill) { cpuPill.textContent = 'OPTIMAL'; cpuPill.style.color = 'var(--emerald)'; }
        }

        // Memory Radial Arc & Status Pill (FanRuan Donut)
        const memPercent = Math.round(r.memoryPercent || 0);
        const freeMb = Math.round((r.freeMemory || 0) / (1024 * 1024));
        const totalMb = Math.round((r.totalMemory || 0) / (1024 * 1024));
        document.getElementById('mem-gauge-num').textContent = `${memPercent}%`;
        document.getElementById('mem-detail-text').textContent = `${freeMb} MB Free`;
        setGaugeArc('mem-gauge-bar', memPercent);
        const memBar = document.getElementById('mem-gauge-bar');
        const memNum = document.getElementById('mem-gauge-num');
        const memPill = document.getElementById('mem-status-pill');
        if (memPercent >= 85) {
          memBar.setAttribute('stroke', 'var(--rose)');
          memNum.style.color = 'var(--rose)';
          if (memPill) { memPill.textContent = 'FULL'; memPill.style.color = 'var(--rose)'; }
        } else if (memPercent >= 70) {
          memBar.setAttribute('stroke', 'var(--amber)');
          memNum.style.color = 'var(--amber)';
          if (memPill) { memPill.textContent = 'WARNING'; memPill.style.color = 'var(--amber)'; }
        } else {
          memBar.setAttribute('stroke', 'var(--cyan)');
          memNum.style.color = 'var(--cyan)';
          if (memPill) { memPill.textContent = 'NORMAL'; memPill.style.color = 'var(--cyan)'; }
        }

        // HDD Storage
        const hddPercent = Math.round(r.hddPercent || 0);
        const freeHddMb = Math.round((r.freeHdd || 0) / (1024 * 1024));
        const totalHddMb = Math.round((r.totalHdd || 0) / (1024 * 1024));
        document.getElementById('hdd-percent-text').textContent = `${hddPercent}%`;
        document.getElementById('hdd-fill').style.width = `${hddPercent}%`;
        document.getElementById('hdd-free-val').textContent = `Free: ${freeHddMb} MB`;
        document.getElementById('hdd-total-val').textContent = `Total: ${totalHddMb} MB`;

        // Host Server Info
        if (data.server) {
          document.getElementById('vital-node-ver').textContent = data.server.nodeVersion || '-';
          document.getElementById('vital-server-ram').textContent = `${data.server.hostMemoryUsedMb || '-'} / ${data.server.hostMemoryTotalMb || '-'} MB (${data.server.hostMemPercent || 0}%)`;
        }

        // 2. Interfaces & Traffic
        const ifaces = data.interfaces || [];
        latestInterfacesData = ifaces;
        renderInterfaceTable();

        const tr = data.traffic || {};
        const wanName = tr.wanInterface || 'ether1-ISP';
        lastKnownWanName = wanName;

        // Populate Interface Selector dropdown if not populated
        const selector = document.getElementById('interface-chart-selector');
        if (selector.options.length <= 2) {
          // Update default label with exact WAN name
          selector.options[0].textContent = `⭐ WAN: ${wanName} (Trafik Utama Internet)`;
          selector.options[0].value = '__WAN__';
          
          ifaces.filter(i => !i.isDynamic).forEach(i => {
            if (i.name !== wanName) {
              const opt = document.createElement('option');
              opt.value = i.name;
              opt.textContent = `${i.name} (${i.type})`;
              selector.appendChild(opt);
            }
          });
        }

        // Determine current displayed RX & TX speed
        let currentRxBps = 0;
        let currentTxBps = 0;
        let ifaceLabel = `WAN: ${wanName}`;

        if (selectedInterface === '__WAN__') {
          currentRxBps = tr.wanRxBps || 0;
          currentTxBps = tr.wanTxBps || 0;
          ifaceLabel = `WAN: ${wanName}`;
          document.getElementById('kpi-rx-label').textContent = 'Download (RX) dari ISP';
          document.getElementById('kpi-tx-label').textContent = 'Upload (TX) ke ISP';
        } else if (selectedInterface === '__ALL__') {
          currentRxBps = tr.totalRxBps || 0;
          currentTxBps = tr.totalTxBps || 0;
          ifaceLabel = 'Semua Interface';
          document.getElementById('kpi-rx-label').textContent = 'Download Traffic (Total)';
          document.getElementById('kpi-tx-label').textContent = 'Upload Traffic (Total)';
        } else {
          const matchIface = ifaces.find(i => i.name === selectedInterface);
          if (matchIface) {
            currentRxBps = matchIface.rxSpeedBps || 0;
            currentTxBps = matchIface.txSpeedBps || 0;
            ifaceLabel = matchIface.name;
          }
          document.getElementById('kpi-rx-label').textContent = `Download: ${selectedInterface}`;
          document.getElementById('kpi-tx-label').textContent = `Upload: ${selectedInterface}`;
        }

        const rxFormatted = formatSpeed(currentRxBps);
        const txFormatted = formatSpeed(currentTxBps);
        const totalBps = currentRxBps + currentTxBps;
        const totalFormatted = formatSpeed(totalBps);

        document.getElementById('kpi-rx-val').textContent = rxFormatted.val;
        document.getElementById('kpi-rx-unit').textContent = rxFormatted.unit;
        document.getElementById('kpi-tx-val').textContent = txFormatted.val;
        document.getElementById('kpi-tx-unit').textContent = txFormatted.unit;
        document.getElementById('kpi-total-bandwidth').innerHTML = `<i class="bi bi-activity"></i> Total: ${totalFormatted.val} ${totalFormatted.unit}`;
        document.getElementById('kpi-rx-interface').innerHTML = `<i class="bi bi-hdd-network"></i> ${ifaceLabel}`;

        // Peak Tracking
        const currentRxMbps = currentRxBps / (1000 * 1000);
        const currentTxMbps = currentTxBps / (1000 * 1000);
        if (currentRxMbps > peakRxRate) peakRxRate = currentRxMbps;
        if (currentTxMbps > peakTxRate) peakTxRate = currentTxMbps;
        document.getElementById('kpi-rx-peak').textContent = `Peak: ${peakRxRate.toFixed(1)} Mbps`;
        document.getElementById('kpi-tx-peak').textContent = `Peak: ${peakTxRate.toFixed(1)} Mbps`;

        // Update Micro-Sparklines (FanRuan KPI)
        const rxSparkRatio = peakRxRate > 0 ? Math.min(100, Math.round((currentRxMbps / peakRxRate) * 100)) : 0;
        const rxSpark = document.getElementById('rx-spark-fill');
        if (rxSpark) rxSpark.style.width = `${rxSparkRatio}%`;

        const txSparkRatio = peakTxRate > 0 ? Math.min(100, Math.round((currentTxMbps / peakTxRate) * 100)) : 0;
        const txSpark = document.getElementById('tx-spark-fill');
        if (txSpark) txSpark.style.width = `${txSparkRatio}%`;

        // Update Chart Wave
        if (selectedInterface === '__WAN__' && tr.history && tr.history.length > 0 && chartHistory.labels.length === 0) {
          // Pre-populate chart with server history points on first load
          tr.history.forEach(pt => {
            chartHistory.labels.push(pt.label);
            chartHistory.rx.push(pt.rxMbps);
            chartHistory.tx.push(pt.txMbps);
          });
        } else {
          const timeLabel = new Date().toTimeString().slice(0, 8);
          chartHistory.labels.push(timeLabel);
          chartHistory.rx.push(Number(currentRxMbps.toFixed(2)));
          chartHistory.tx.push(Number(currentTxMbps.toFixed(2)));
        }

        while (chartHistory.labels.length > MAX_CHART_POINTS) {
          chartHistory.labels.shift();
          chartHistory.rx.shift();
          chartHistory.tx.shift();
        }

        const currentMax = Math.max(...chartHistory.rx, ...chartHistory.tx, 1);
        if (currentMax > maxHistoricalRate) maxHistoricalRate = currentMax;
        document.getElementById('chart-max-rate').textContent = `Max: ${maxHistoricalRate.toFixed(1)} Mbps`;

        if (trafficChart) {
          trafficChart.data.labels = chartHistory.labels;
          trafficChart.data.datasets[0].data = chartHistory.rx;
          trafficChart.data.datasets[1].data = chartHistory.tx;
          trafficChart.update('none');
        }

        // 3. Subscribers & Infrastructure (Right Column)
        const cl = data.clients || {};
        const pppoe = cl.pppoe || {};
        const hotspot = cl.hotspot || {};
        const acs = data.acs || {};
        const billing = cl.billing || {};

        document.getElementById('kpi-pppoe-online').textContent = pppoe.active || 0;
        document.getElementById('kpi-pppoe-total').textContent = `/ ${pppoe.total || 0} Total`;
        document.getElementById('kpi-pppoe-offline').innerHTML = `<i class="bi bi-circle-fill" style="color:${(pppoe.offline || 0) > 0 ? 'var(--rose)' : 'var(--text-dim)'};font-size:6px"></i> ${pppoe.offline || 0} Offline`;
        document.getElementById('kpi-pppoe-ratio').textContent = `${pppoe.activePercent || 0}% Active`;

        document.getElementById('kpi-hotspot-active').textContent = hotspot.active || 0;
        document.getElementById('kpi-hotspot-total').textContent = `/ ${hotspot.total || 0} Vouchers`;

        document.getElementById('kpi-ont-summary').innerHTML = `<i class="bi bi-modem"></i> ONT: ${acs.online || 0} Online`;
        if ((acs.critical || 0) > 0) {
          document.getElementById('kpi-optical-alert').textContent = `${acs.critical} Kritis!`;
          document.getElementById('kpi-optical-alert').style.color = 'var(--rose)';
        } else {
          document.getElementById('kpi-optical-alert').textContent = 'Fiber OK';
          document.getElementById('kpi-optical-alert').style.color = 'var(--emerald)';
        }

        document.getElementById('pppoe-ratio-num').textContent = `${pppoe.activePercent || 0}%`;
        document.getElementById('pppoe-bar-fill').style.width = `${pppoe.activePercent || 0}%`;
        document.getElementById('pppoe-bar-online').textContent = `Online: ${pppoe.active || 0}`;
        document.getElementById('pppoe-bar-offline').textContent = `Offline: ${pppoe.offline || 0}`;

        const hotspotPercent = (hotspot.total > 0) ? Math.round(((hotspot.active || 0) / hotspot.total) * 100) : 0;
        document.getElementById('hotspot-ratio-num').textContent = `${hotspotPercent}%`;
        document.getElementById('hotspot-bar-fill').style.width = `${hotspotPercent}%`;
        document.getElementById('hotspot-bar-active').textContent = `Active: ${hotspot.active || 0}`;
        document.getElementById('hotspot-bar-total').textContent = `Vouchers: ${hotspot.total || 0}`;

        const ontPercent = (acs.total > 0) ? Math.round(((acs.online || 0) / acs.total) * 100) : 0;
        document.getElementById('ont-ratio-num').textContent = `${ontPercent}%`;
        document.getElementById('ont-bar-fill').style.width = `${ontPercent}%`;
        document.getElementById('ont-bar-online').textContent = `Online: ${acs.online || 0} / ${acs.total || 0}`;
        document.getElementById('ont-bar-critical').textContent = `Kritis: ${acs.critical || 0}`;

        const ontServersBox = document.getElementById('ont-servers-breakdown');
        if (ontServersBox) {
          if (Array.isArray(acs.servers) && acs.servers.length > 0) {
            ontServersBox.innerHTML = acs.servers.map(s => {
              const label = String(s.name || 'ACS').replace('GenieACS API', 'GenieACS');
              return `<span style="background:rgba(255,255,255,0.05);padding:1px 5px;border-radius:3px;white-space:nowrap" title="${s.name}: ${s.online} Online / ${s.total} Total">
                <i class="bi bi-hdd-network" style="color:var(--cyan);font-size:7.5px"></i> ${label}: <b style="color:var(--text-light)">${s.online}/${s.total}</b>
              </span>`;
            }).join('');
            ontServersBox.style.display = 'flex';
          } else {
            ontServersBox.style.display = 'none';
          }
        }

        document.getElementById('cust-active-val').textContent = `${billing.active || 0} Pelanggan`;
        document.getElementById('cust-suspended-val').textContent = `${billing.suspended || 0} Pelanggan`;
        document.getElementById('client-total-badge').textContent = `${(pppoe.active || 0) + (hotspot.active || 0)} Sesi Aktif`;
        document.getElementById('sec-blocked-val').textContent = `${data.security ? (data.security.blockedCount || 0) : 0} Kali`;

        // Update Sparkline Fills for PPPoE, Hotspot, and Hardware
        const pppoeSpark = document.getElementById('pppoe-spark-fill');
        if (pppoeSpark) pppoeSpark.style.width = `${pppoe.activePercent || 0}%`;

        const hotspotSpark = document.getElementById('hotspot-spark-fill');
        if (hotspotSpark) hotspotSpark.style.width = `${hotspotPercent || 0}%`;

        const tempSpark = document.getElementById('temp-spark-fill');
        if (tempSpark) {
          const tempVal = r.temperature || 40;
          tempSpark.style.width = `${Math.min(100, Math.max(0, Math.round((tempVal / 80) * 100)))}%`;
        }

        // Update Bottom Telemetry Ticker
        const tickerMsg = document.getElementById('noc-ticker-msg');
        if (tickerMsg) {
          let tickerItems = [];
          if (data.warning) {
            tickerItems.push(`<span style="color:var(--amber)"><i class="bi bi-exclamation-triangle-fill"></i> PERINGATAN: ${data.warning}</span>`);
          }
          if ((acs.critical || 0) > 0) {
            tickerItems.push(`<span style="color:var(--rose)"><i class="bi bi-radioactive"></i> ALARM: ${acs.critical} Modem Fiber Redaman Kritis</span>`);
          }
          if (cpuVal >= 80) {
            tickerItems.push(`<span style="color:var(--rose)"><i class="bi bi-cpu-fill"></i> CPU LOAD TINGGI: ${cpuVal}%</span>`);
          }
          const downPhysical = ifaces.filter(i => !i.isDynamic && !i.disabled && !i.running);
          if (downPhysical.length > 0) {
            const downNames = downPhysical.map(i => i.name).join(', ');
            tickerItems.push(`<span style="color:var(--rose)"><i class="bi bi-x-octagon-fill"></i> LINK DOWN: ${downNames}</span>`);
          }
          if (tickerItems.length === 0) {
            tickerItems.push(`<span style="color:var(--emerald)"><i class="bi bi-shield-check"></i> Router ${r.boardName || 'MikroTik'} [${wanName}] Beroperasi Optimal</span>`);
            tickerItems.push(`<span style="color:var(--cyan)"><i class="bi bi-speedometer"></i> Throughput Internet: ↓${rxFormatted.val} ${rxFormatted.unit} / ↑${txFormatted.val} ${txFormatted.unit}</span>`);
            tickerItems.push(`<span style="color:var(--purple)"><i class="bi bi-people-fill"></i> ${pppoe.active || 0} PPPoE + ${hotspot.active || 0} Hotspot Sesi Aktif</span>`);
            if ((acs.online || 0) > 0) {
              tickerItems.push(`<span style="color:var(--emerald)"><i class="bi bi-modem-fill"></i> ${acs.online} ONT Fiber Online</span>`);
            }
          }
          tickerMsg.innerHTML = tickerItems.join(' &nbsp;•&nbsp; ');
        }
        const tickerTime = document.getElementById('noc-ticker-time');
        if (tickerTime) {
          tickerTime.innerHTML = `<i class="bi bi-arrow-repeat spin-slow"></i> AUTO-SYNC: ${(pollIntervalMs / 1000).toFixed(1)}s`;
        }

        // 4. Automated Smart Voice Announcer Trigger
        if (isNocVoiceEnabled && !isAiVoiceSpeaking && !isListeningVoice) {
          // A. Interface Link Down Alert (Physical only)
          ifaces.filter(i => !i.isDynamic && !i.disabled).forEach(i => {
            const wasDown = lastAnnouncerState.downIfaces.has(i.name);
            if (!i.running && !wasDown) {
              lastAnnouncerState.downIfaces.add(i.name);
              speakNocVoice(`Peringatan: Jalur antarmuka ${i.name} terputus!`);
            } else if (i.running && wasDown) {
              lastAnnouncerState.downIfaces.delete(i.name);
              speakNocVoice(`Pemberitahuan: Jalur antarmuka ${i.name} telah pulih normal.`);
            }
          });

          // B. High CPU Alert (> 85%)
          if (cpuVal >= 85 && (now - lastAnnouncerState.lastCpuAlertTime > 180000)) {
            lastAnnouncerState.lastCpuAlertTime = now;
            speakNocVoice(`Pemberitahuan darurat: Beban prosesor router tinggi mencapai ${cpuVal} persen.`);
          }

          // C. Critical Optical Power (LOS) Alert
          if ((acs.critical || 0) > lastAnnouncerState.lastCriticalAcs && (acs.critical || 0) > 0) {
            lastAnnouncerState.lastCriticalAcs = acs.critical;
            speakNocVoice(`Pemberitahuan: Terdeteksi ${acs.critical} perangkat modem dengan redaman optik kritis.`);
          }

          // D. Security Brute Force Blocked
          const blockedCount = data.security?.blockedCount || 0;
          if (blockedCount > lastAnnouncerState.lastBlockedCount && lastAnnouncerState.lastBlockedCount > 0) {
            lastAnnouncerState.lastBlockedCount = blockedCount;
            speakNocVoice('Peringatan keamanan: Serangan brute force baru saja diblokir otomatis oleh firewall.');
          } else {
            lastAnnouncerState.lastBlockedCount = blockedCount;
          }

          // E. Hourly Briefing (at minute 0)
          const curDate = new Date();
          if (curDate.getMinutes() === 0 && curDate.getHours() !== lastAnnouncerState.lastBriefingHour) {
            lastAnnouncerState.lastBriefingHour = curDate.getHours();
            const hStr = curDate.getHours();
            speakNocVoice(`Laporan berkala jam ${hStr}: Trafik download internet ${rxFormatted.val} ${rxFormatted.unit}, dengan ${pppoe.active || 0} pelanggan pe pe po e online.`);
          }
        }

      } catch (err) {
        console.error('NOC Load Error:', err);
        document.getElementById('header-pulse-text').textContent = 'DISCONNECTED';
        document.getElementById('header-pulse').style.color = 'var(--rose)';
      }
    }
  </script>
</body>
</html>
