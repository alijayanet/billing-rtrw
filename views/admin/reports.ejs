<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.nav.finance_report', 'Laporan Keuangan') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'reports', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-bar-chart-line"></i> <%= t('admin.nav.finance_report', 'Laporan Keuangan') %></div>
    <div class="tb-right" style="display:flex;gap:8px;align-items:center">
      <select class="fs" id="monthSelect" style="width:115px" onchange="filterReport()">
        <% const monthOptions = (lang === 'en')
            ? ['January','February','March','April','May','June','July','August','September','October','November','December']
            : ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
           for(let m=1; m<=12; m++){ %>
        <option value="<%= m %>" <%= (typeof filterMonth !== 'undefined' && filterMonth == m)?'selected':'' %>><%= monthOptions[m-1] %></option>
        <% } %>
      </select>
      <select class="fs" id="yearSelect" style="width:85px" onchange="filterReport()">
        <% for(let y=new Date().getFullYear(); y>=2023; y--){ %>
        <option value="<%= y %>" <%= filterYear==y?'selected':'' %>><%= y %></option>
        <% } %>
      </select>
      <a href="/admin/reports/export-csv?year=<%= filterYear %>" class="btn btn-g btn-sm" title="Export Excel (CSV)"><i class="bi bi-file-earmark-excel" style="color:#10b981"></i> Excel</a>
      <a href="/admin/reports/print?year=<%= filterYear %>" target="_blank" class="btn btn-g btn-sm" title="Print PDF"><i class="bi bi-printer" style="color:#3b82f6"></i> Print</a>
      <span class="adm-badge" style="font-size:12px;opacity:0.7;"><%= company %></span>
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">

    <% 
      const selMonthNames = (lang === 'en')
        ? ['January','February','March','April','May','June','July','August','September','October','November','December']
        : ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
      const selMonthLabel = (typeof filterMonth !== 'undefined' && filterMonth >= 1 && filterMonth <= 12) ? selMonthNames[filterMonth-1] : 'Bulan Berjalan';
    %>
    <!-- Big Stats -->
    <div class="stat-grid" style="grid-template-columns:repeat(4,1fr)">
      <div class="sc s"><i class="bi bi-cash-stack sc-icon"></i>
        <div class="sc-label"><%= t('admin.reports.total_revenue_year', 'Total Pendapatan') %> <%= filterYear %></div>
        <div class="sc-val" style="font-size:20px">Rp <%= totalRevenue.toLocaleString('id-ID') %></div>
      </div>
      <div class="sc p"><i class="bi bi-receipt sc-icon"></i>
        <div class="sc-label">Tagihan <%= selMonthLabel %></div>
        <div class="sc-val" style="font-size:20px">Rp <%= thisMonth.toLocaleString('id-ID') %></div>
      </div>
      <div class="sc d"><i class="bi bi-hourglass sc-icon"></i>
        <div class="sc-label"><%= t('admin.reports.pending_receivable', 'Piutang Belum Bayar') %></div>
        <div class="sc-val" style="font-size:20px">Rp <%= pendingAmount.toLocaleString('id-ID') %></div>
      </div>
      <div class="sc w"><i class="bi bi-people sc-icon"></i>
        <div class="sc-label"><%= t('admin.reports.active_customers_total', 'Total Pelanggan Aktif') %></div>
        <div class="sc-val"><%= activeCustomers %></div>
      </div>
    </div>

    <div class="stat-grid" style="grid-template-columns:repeat(3,1fr);margin-top:14px">
      <div class="sc p"><i class="bi bi-cash-stack sc-icon"></i>
        <div class="sc-label">Total Pemasukan (Kas Masuk) <%= filterYear %></div>
        <div class="sc-val" style="font-size:20px">Rp <%= (cashInYear || 0).toLocaleString('id-ID') %></div>
        <div class="sc-sub" style="font-size:11px"><%= selMonthLabel %>: Rp <%= (cashInThisMonth || 0).toLocaleString('id-ID') %><br><span style="color:var(--muted)">(Tagihan + Agent + Voucher + Lainnya)</span></div>
      </div>
      <div class="sc d"><i class="bi bi-wallet2 sc-icon"></i>
        <div class="sc-label">Total Pengeluaran (Kas Keluar) <%= filterYear %></div>
        <div class="sc-val" style="font-size:20px">-Rp <%= (expensesYear || 0).toLocaleString('id-ID') %></div>
        <div class="sc-sub"><%= selMonthLabel %>: Rp <%= (expensesMonth || 0).toLocaleString('id-ID') %></div>
      </div>
      <div class="sc s" style="background:rgba(16,185,129,0.15);border-color:rgba(16,185,129,0.3)"><i class="bi bi-piggy-bank-fill sc-icon" style="color:#10b981"></i>
        <div class="sc-label" style="color:#10b981">Laba Bersih (Net Profit) <%= filterYear %></div>
        <div class="sc-val" style="font-size:24px;color:#10b981">Rp <%= (netProfitYear || 0).toLocaleString('id-ID') %></div>
        <div class="sc-sub" style="color:#10b981"><%= selMonthLabel %>: Rp <%= (netProfitMonth || 0).toLocaleString('id-ID') %></div>
      </div>
    </div>

    <!-- Chart & Monthly Table -->
    <div style="display:grid;grid-template-columns:2fr 1fr;gap:18px">

      <!-- Bar Chart -->
      <div class="card">
        <div class="card-hd"><h6><i class="bi bi-bar-chart"></i> <%= t('admin.reports.monthly_revenue', 'Pendapatan Bulanan') %> <%= filterYear %></h6></div>
        <div class="card-bd">
          <canvas id="revenueChart" height="220"></canvas>
        </div>
      </div>

      <!-- Top Unpaid & Expenses Breakdown -->
      <div style="display:flex;flex-direction:column;gap:18px">
        <div class="card" style="flex:1">
          <div class="card-hd"><h6><i class="bi bi-exclamation-triangle"></i> <%= t('admin.reports.top_unpaid', 'Piutang Tertinggi') %></h6></div>
          <div class="card-bd" style="padding:0">
            <% if (topUnpaid.length===0) { %>
              <div class="text-center text-muted" style="padding:24px;font-size:13px"><%= t('admin.reports.all_paid', 'Semua pelanggan sudah lunas') %></div>
            <% } %>
            <% topUnpaid.slice(0,3).forEach(u=>{ %>
            <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center">
              <div>
                <div style="font-size:13px;font-weight:600"><%= u.name %></div>
                <div style="font-size:11px;color:var(--muted)"><%= u.phone %></div>
              </div>
              <span class="badge bd">Rp <%= u.total_unpaid.toLocaleString('id-ID') %></span>
            </div>
            <% }) %>
          </div>
        </div>

        <div class="card" style="flex:1">
          <div class="card-hd"><h6><i class="bi bi-pie-chart"></i> Rincian Pengeluaran (<%= filterYear %>)</h6></div>
          <div class="card-bd" style="padding:0">
            <% if (typeof expensesByCategory !== 'undefined' && expensesByCategory.length===0) { %>
              <div class="text-center text-muted" style="padding:24px;font-size:13px">Belum ada pengeluaran dicatat</div>
            <% } %>
            <% if(typeof expensesByCategory !== 'undefined') expensesByCategory.forEach(c=>{ %>
            <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center">
              <div style="font-size:13px;font-weight:600"><i class="bi bi-tag" style="color:var(--muted);margin-right:6px"></i> <%= c.category %></div>
              <span class="badge" style="background:rgba(239, 68, 68, 0.1);color:#ef4444">Rp <%= c.total.toLocaleString('id-ID') %></span>
            </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>

    <!-- Monthly Breakdown Table -->
    <div class="card">
      <div class="card-hd"><h6><i class="bi bi-table"></i> <%= t('admin.reports.monthly_breakdown', 'Rincian Per Bulan') %> <%= filterYear %></h6></div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th><%= t('admin.reports.table.month', 'Bulan') %></th>
              <th class="num">Kas Masuk Riil</th>
              <th class="num">Pengeluaran</th>
              <th class="num">Laba / (Rugi) Bersih</th>
              <th class="num"><%= t('admin.reports.table.paid', 'Tagihan Lunas') %></th>
              <th><%= t('admin.reports.table.pct', 'Kolektibilitas') %></th>
            </tr>
          </thead>
          <tbody>
          <% const mns = (lang === 'en')
            ? ['January','February','March','April','May','June','July','August','September','October','November','December']
            : ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
             let grandTotal=0, grandPaid=0, grandIncome=0, grandExpense=0, grandNet=0;
             monthlyData.forEach(m=>{ 
               grandTotal += m.total_invoices; 
               grandPaid += m.paid_count; 
               grandIncome += (m.income || 0);
               grandExpense += (m.expense || 0);
               grandNet += (m.net_profit || 0);
             }); %>
          <% if(monthlyData.length===0){ %>
            <tr><td colspan="6" class="text-center text-muted" style="padding:24px"><%= t('admin.reports.no_data_year_prefix', 'Belum ada data untuk tahun') %> <%= filterYear %></td></tr>
          <% } %>
          <% monthlyData.forEach(m=>{ 
               const pct = m.total_invoices > 0 ? Math.round(m.paid_count / m.total_invoices * 100) : 0; 
               const isSel = (typeof filterMonth !== 'undefined' && filterMonth == m.month);
          %>
            <tr style="<%= isSel ? 'background:rgba(59,130,246,0.08);font-weight:600;' : '' %>">
              <td class="fw6">
                <%= mns[m.month-1] %>
                <% if(isSel){ %><span class="badge" style="background:#3b82f6;color:#fff;font-size:10px;margin-left:4px">Dipilih</span><% } %>
              </td>
              <td class="num fw6" style="color:#0284c7">Rp <%= (m.income || 0).toLocaleString('id-ID') %></td>
              <td class="num fw6" style="color:#ef4444">-Rp <%= (m.expense || 0).toLocaleString('id-ID') %></td>
              <td class="num fw6" style="color:<%= (m.net_profit || 0) >= 0 ? '#10b981' : '#ef4444' %>">
                Rp <%= (m.net_profit || 0).toLocaleString('id-ID') %>
              </td>
              <td class="num"><%= m.paid_count %> / <%= m.total_invoices %></td>
              <td>
                <div style="display:flex;align-items:center;gap:8px">
                  <div style="flex:1;background:var(--bg3);border-radius:4px;height:6px;overflow:hidden">
                    <div <%- `style="width:${pct}%;height:100%;background:linear-gradient(90deg,#3fb950,#4ade80);border-radius:4px"` %>></div>
                  </div>
                  <span style="font-size:12px;color:var(--muted);width:32px"><%= pct %>%</span>
                </div>
              </td>
            </tr>
          <% }) %>
          </tbody>
          <tfoot>
            <tr style="font-weight:700;border-top:2px solid var(--border);background:var(--bg2,#f8fafc)">
              <td>TOTAL TAHUN <%= filterYear %></td>
              <td class="num" style="color:#0284c7">Rp <%= grandIncome.toLocaleString('id-ID') %></td>
              <td class="num" style="color:#ef4444">-Rp <%= grandExpense.toLocaleString('id-ID') %></td>
              <td class="num" style="color:<%= grandNet >= 0 ? '#10b981' : '#ef4444' %>">Rp <%= grandNet.toLocaleString('id-ID') %></td>
              <td class="num"><%= grandPaid %> / <%= grandTotal %></td>
              <td><%= grandTotal > 0 ? Math.round(grandPaid / grandTotal * 100) : 0 %>%</td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <!-- Recent Payments -->
    <div class="card">
      <div class="card-hd"><h6><i class="bi bi-clock-history"></i> <%= t('admin.reports.recent_payments', 'Pembayaran Terakhir') %></h6></div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th><%= t('admin.reports.table.customer', 'Pelanggan') %></th>
              <th><%= t('admin.reports.table.period', 'Periode') %></th>
              <th class="num"><%= t('admin.reports.table.amount', 'Jumlah') %></th>
              <th><%= t('admin.reports.table.recorded_by', 'Dicatat Oleh') %></th>
              <th><%= t('admin.reports.table.time', 'Waktu') %></th>
            </tr>
          </thead>
          <tbody>
          <% const mn2 = (lang === 'en')
            ? ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
            : ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agt','Sep','Okt','Nov','Des']; %>
          <% if(recentPayments.length===0){%><tr><td colspan="5" class="text-center text-muted" style="padding:24px"><%= t('admin.reports.no_payments', 'Belum ada pembayaran') %></td></tr><%}%>
          <% recentPayments.forEach(p=>{ %>
            <tr>
              <td class="fw6"><%= p.customer_name %></td>
              <td><span class="badge bm"><%= mn2[p.period_month-1] %> <%= p.period_year %></span></td>
              <td class="num fw6" style="color:var(--success)">Rp <%= p.amount.toLocaleString('id-ID') %></td>
              <td style="font-size:12px"><%= p.paid_by_name||'-' %></td>
              <td style="font-size:11px;color:var(--muted)"><%= p.paid_at ? new Date(p.paid_at).toLocaleString('id-ID',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '-' %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
const monthLabels = JSON.parse(`<%- JSON.stringify((lang === 'en') 
  ? ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] 
  : ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agt','Sep','Okt','Nov','Des']) %>`);
const rawData = JSON.parse(`<%- JSON.stringify(chartData) %>`);
const labels = monthLabels;
const incomeValues = Array(12).fill(0);
const expenseValues = Array(12).fill(0);
const profitValues = Array(12).fill(0);

rawData.forEach(d => {
  incomeValues[d.month - 1] = d.income || 0;
  expenseValues[d.month - 1] = d.expense || 0;
  profitValues[d.month - 1] = d.net_profit || 0;
});

new Chart(document.getElementById('revenueChart'), {
  type: 'bar',
  data: {
    labels,
    datasets: [
      {
        label: 'Pemasukan (Kas Masuk)',
        data: incomeValues,
        backgroundColor: 'rgba(2, 132, 199, 0.75)',
        borderColor: '#0284c7',
        borderWidth: 1.5,
        borderRadius: 4,
      },
      {
        label: 'Pengeluaran (Kas Keluar)',
        data: expenseValues,
        backgroundColor: 'rgba(239, 68, 68, 0.75)',
        borderColor: '#ef4444',
        borderWidth: 1.5,
        borderRadius: 4,
      },
      {
        label: 'Laba Bersih',
        data: profitValues,
        type: 'line',
        borderColor: '#10b981',
        backgroundColor: 'rgba(16, 185, 129, 0.15)',
        borderWidth: 2.5,
        tension: 0.3,
        pointBackgroundColor: '#10b981',
        pointRadius: 4
      }
    ]
  },
  options: {
    responsive: true,
    plugins: {
      legend: { display: true, position: 'top' },
      tooltip: { callbacks: { label: ctx => ctx.dataset.label + ': Rp ' + ctx.raw.toLocaleString('id-ID') } }
    },
    scales: {
      x: { ticks: { color: '#7d8590' }, grid: { color: 'rgba(240,246,252,0.05)' } },
      y: { ticks: { color: '#7d8590', callback: v => 'Rp ' + (v/1000).toFixed(0)+'k' }, grid: { color: 'rgba(240,246,252,0.05)' } }
    }
  }
});

function filterReport() {
  const y = document.getElementById('yearSelect').value;
  const m = document.getElementById('monthSelect').value;
  window.location = '/admin/reports?year=' + y + '&month=' + m;
}
</script>
</body>
</html>
