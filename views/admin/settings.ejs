<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= ((typeof viewMode !== 'undefined' && viewMode === 'ewallet_logs') ? t('admin.settings.ewallet_logs.title', 'Log Notifikasi E-Wallet (Webhook)') : t('admin.settings.title', 'Pengaturan')) %> | <%= company %></title>
  <meta name="theme-color" content="#0f172a">
  <link rel="manifest" href="/admin/manifest.webmanifest">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<%- include('partials/sidebar', { activePage: (typeof activePage !== 'undefined' && activePage ? activePage : 'settings'), company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-gear"></i> <%= t('admin.settings.system_title', 'Pengaturan Sistem') %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i> <%= t('common.logout', 'Logout') %></a>
    </div>
  </div>
  <div class="page">

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type==='success'?'s':'d' %>">
      <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

    <% const logsOnly = (typeof viewMode !== 'undefined' && viewMode === 'ewallet_logs'); %>

    <% if (logsOnly) { %>
    <div class="card mb16">
      <div class="card-hd" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
        <h6 style="margin:0"><i class="bi bi-wallet2"></i> <%= t('admin.settings.ewallet_logs.title', 'Log Notifikasi E-Wallet (Webhook)') %></h6>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
          <a class="btn btn-g btn-sm" href="/admin/settings"><i class="bi bi-arrow-left"></i> <%= t('common.back', 'Kembali') %></a>
          <button type="button" class="btn btn-g btn-sm" onclick="enableEwalletNotif()"><i class="bi bi-bell"></i> <%= t('admin.settings.ewallet_logs.enable_notif', 'Aktifkan Notif') %></button>
          <button type="button" class="btn btn-p btn-sm" onclick="toggleEwalletLive()" id="ew_live_btn"><i class="bi bi-broadcast"></i> <%= t('admin.settings.ewallet_logs.live', 'Live') %></button>
          <button type="button" class="btn btn-g btn-sm" onclick="loadEwalletLogs()"><i class="bi bi-arrow-clockwise"></i> <%= t('common.refresh', 'Refresh') %></button>
          <button type="button" class="btn btn-d btn-sm" onclick="clearEwalletLogs()"><i class="bi bi-trash"></i> <%= t('common.clear', 'Clear') %></button>
        </div>
      </div>
      <div class="card-bd">
        <div class="form-row" style="align-items:flex-end">
          <div class="fg">
            <label class="fl"><%= t('admin.settings.ewallet_logs.service', 'Service') %></label>
            <input class="fc" id="ew_service" placeholder="DANA / Gojek / ShopeePay (opsional)">
          </div>
          <div class="fg" style="flex:2">
            <label class="fl"><%= t('admin.settings.ewallet_logs.search', 'Cari') %></label>
            <input class="fc" id="ew_q" placeholder="kata kunci (opsional)">
          </div>
          <div class="fg w160">
            <label class="fl"><%= t('admin.settings.ewallet_logs.limit', 'Limit') %></label>
            <select class="fs" id="ew_limit">
              <option value="50">50</option>
              <option value="100">100</option>
              <option value="200" selected>200</option>
              <option value="500">500</option>
            </select>
          </div>
        </div>
        <div class="hint" style="margin-top:6px">
          Endpoint MacroDroid: <span class="mono">POST /api/webhook/v1/payment-notif</span>
        </div>
        <div class="hint" style="margin-top:6px" id="ew_notif_hint"></div>
        <div class="tbl-wrap" style="margin-top:10px;max-height:420px;overflow:auto">
          <table class="dtbl">
            <thead>
              <tr>
                <th style="width:160px"><%= t('common.time', 'Waktu') %></th>
                <th style="width:110px">Service</th>
                <th style="width:120px"><%= t('admin.settings.ewallet_logs.amount', 'Nominal') %></th>
                <th style="width:80px">OK</th>
                <th style="width:90px">Match</th>
                <th><%= t('admin.settings.ewallet_logs.content', 'Content') %></th>
                <th style="width:80px"><%= t('common.actions', 'Aksi') %></th>
              </tr>
            </thead>
            <tbody id="ew_logs_body">
              <tr><td colspan="7" class="text-center text-muted"><%= t('common.loading', 'Memuat data...') %></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <% } else { %>
    <div class="card mb16">
      <div class="card-hd" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
        <h6 style="margin:0"><i class="bi bi-wallet2"></i> <%= t('admin.settings.ewallet_logs.title', 'Log Notifikasi E-Wallet (Webhook)') %></h6>
        <a class="btn btn-p btn-sm" href="/admin/ewallet-logs"><i class="bi bi-box-arrow-up-right"></i> <%= t('common.open', 'Buka') %></a>
      </div>
      <div class="card-bd">
        <div class="hint">Log notifikasi e-wallet dipindah ke halaman khusus agar pengaturan tidak terdorong ke bawah.</div>
      </div>
    </div>
    <% } %>

    <% if (!logsOnly) { %>
    <form method="POST" action="/admin/settings">

        <div class="card mb16">
          <div class="card-hd"><h6><i class="bi bi-telegram"></i> <%= t('admin.settings.telegram.title', 'Pengaturan Telegram Bot (Backup Admin)') %></h6></div>
          <div class="card-bd">
            <div class="form-row">
              <div class="fg">
                <label class="fl"><%= t('admin.settings.telegram.status', 'Status Bot Telegram') %></label>
                <select class="fs" name="telegram_enabled">
                  <option value="true" <%= settings.telegram_enabled ? 'selected' : '' %>><%= t('common.active', 'Aktif') %></option>
                  <option value="false" <%= !settings.telegram_enabled ? 'selected' : '' %>><%= t('common.inactive', 'Nonaktif') %></option>
                </select>
              </div>
              <div class="fg">
                <label class="fl"><%= t('admin.settings.telegram.admin_id', 'Admin Telegram ID') %></label>
                <input class="fc" name="telegram_admin_id" value="<%= settings.telegram_admin_id || '' %>" placeholder="Contoh: 12345678">
              </div>
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.settings.telegram.bot_token', 'Telegram Bot Token') %></label>
              <div style="display:flex;gap:8px">
                <input class="fc" name="telegram_bot_token" value="<%= settings.telegram_bot_token || '' %>" placeholder="Dapatkan dari @BotFather">
                <button type="button" class="btn btn-g" onclick="syncTelegram()" title="<%= t('admin.settings.telegram.sync_title', 'Sinkronkan / Hapus Webhook Lama') %>"><i class="bi bi-arrow-repeat"></i> <%= t('admin.settings.telegram.sync', 'Sinkronkan') %></button>
              </div>
            </div>

            <!-- Sub-section: Asisten AI & Grup Telegram Komunitas -->
            <div style="margin-top:16px; padding-top:14px; border-top:1px dashed var(--border, #e2e8f0)">
              <h6 style="font-size:13px; font-weight:600; color:var(--primary, #0ea5e9); margin-bottom:12px">
                <i class="bi bi-robot"></i> Asisten AI & Grup Telegram Komunitas
              </h6>

              <div class="form-row">
                <div class="fg">
                  <label class="fl">Asisten AI di Grup</label>
                  <select class="fs" name="telegram_group_ai_enabled">
                    <option value="true" <%= settings.telegram_group_ai_enabled !== false ? 'selected' : '' %>>Aktif</option>
                    <option value="false" <%= settings.telegram_group_ai_enabled === false ? 'selected' : '' %>>Nonaktif</option>
                  </select>
                  <div style="font-size:11px;color:var(--muted);margin-top:4px">Menjawab pertanyaan seputar fitur aplikasi saat di-tag @bot atau via /tanya</div>
                </div>
                <div class="fg">
                  <label class="fl">Status Mesin AI Terhubung</label>
                  <div style="font-size:12px; font-weight:600; color:var(--primary,#0ea5e9); padding-top:6px">
                    <i class="bi bi-cpu"></i> Provider Aktif: <span style="text-transform:uppercase"><%= settings.ai_provider || 'gemini' %></span>
                  </div>
                  <div style="font-size:11px;color:var(--muted);margin-top:4px">Kunci API & model diatur pada kartu "Pengaturan Mesin AI" di bawah.</div>
                </div>
              </div>

              <div class="form-row" style="margin-top:10px">
                <div class="fg">
                  <label class="fl">Sambut Member Baru di Grup</label>
                  <select class="fs" name="telegram_welcome_enabled">
                    <option value="true" <%= settings.telegram_welcome_enabled !== false ? 'selected' : '' %>>Aktif</option>
                    <option value="false" <%= settings.telegram_welcome_enabled === false ? 'selected' : '' %>>Nonaktif</option>
                  </select>
                </div>
                <div class="fg">
                  <label class="fl">Pesan Sambutan Kustom (Opsional)</label>
                  <input class="fc" name="telegram_welcome_msg" value="<%= settings.telegram_welcome_msg || '' %>" placeholder="Gunakan {nama} dan {bot}">
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- PENGATURAN MESIN AI (SHARED: TELEGRAM & WHATSAPP) -->
        <div class="card mb16">
          <div class="card-hd" style="display:flex;justify-content:space-between;align-items:center">
            <h6><i class="bi bi-robot"></i> Pengaturan Mesin AI (Artificial Intelligence Multi-Provider)</h6>
            <span class="badge" style="background:#0284c7;color:#fff;font-size:11px;padding:3px 8px;border-radius:4px">Telegram & WhatsApp</span>
          </div>
          <div class="card-bd">
            <div class="hint" style="margin-bottom:14px">
              Mesin AI ini digunakan secara otomatis oleh <strong>Telegram Bot</strong> dan <strong>WhatsApp Bot</strong> untuk menjawab tanya jawab pelanggan, melayani pertanyaan umum di luar sistem, serta mengeksekusi perintah operasional admin (cek tagihan, isolir, unisolir, reboot modem ONU, dsb.).
            </div>

            <div class="form-row">
              <div class="fg">
                <label class="fl">Provider AI Utama</label>
                <select class="fs" name="ai_provider" id="ai_provider_select" onchange="toggleAiProviderFields()">
                  <option value="gemini" <%= (settings.ai_provider || 'gemini') === 'gemini' ? 'selected' : '' %>>Google Gemini (Gratis, Sangat Cepat & Rekomendasi)</option>
                  <option value="openai" <%= settings.ai_provider === 'openai' ? 'selected' : '' %>>OpenAI (ChatGPT - GPT-4o / GPT-4o-mini)</option>
                  <option value="deepseek" <%= settings.ai_provider === 'deepseek' ? 'selected' : '' %>>DeepSeek (DeepSeek-V3 / DeepSeek-R1)</option>
                  <option value="groq" <%= settings.ai_provider === 'groq' ? 'selected' : '' %>>Groq Cloud (Llama 3.3 Ultra Fast Inference)</option>
                  <option value="openrouter" <%= settings.ai_provider === 'openrouter' ? 'selected' : '' %>>OpenRouter (Multi-Model Hub API)</option>
                  <option value="custom" <%= settings.ai_provider === 'custom' ? 'selected' : '' %>>Custom / Local AI (Ollama / vLLM / LM Studio)</option>
                </select>
                <div style="font-size:11px;color:var(--muted);margin-top:4px">Pilih penyedia AI yang ingin digunakan untuk bot Telegram & WhatsApp.</div>
              </div>
            </div>

            <!-- Provider: Google Gemini -->
            <div id="ai_fields_gemini" class="ai-provider-field" style="margin-top:12px">
              <div class="form-row">
                <div class="fg">
                  <label class="fl">Google Gemini API Key (Gratis)</label>
                  <input class="fc" name="gemini_api_key" value="<%= settings.gemini_api_key || '' %>" placeholder="AIzaSy... (dapatkan dari aistudio.google.com)">
                  <div style="font-size:11px;color:var(--muted);margin-top:4px">Dapatkan gratis di <strong>aistudio.google.com</strong>. Auto fallback: gemini-2.5-flash / gemini-2.0-flash. Kosongkan jika ingin mode offline.</div>
                </div>
              </div>
            </div>

            <!-- Provider: OpenAI -->
            <div id="ai_fields_openai" class="ai-provider-field" style="margin-top:12px; display:none">
              <div class="form-row">
                <div class="fg">
                  <label class="fl">OpenAI API Key</label>
                  <input class="fc" type="password" name="openai_api_key" value="<%= settings.openai_api_key || '' %>" placeholder="sk-proj-...">
                  <div style="font-size:11px;color:var(--muted);margin-top:4px">Dapatkan dari platform.openai.com/api-keys</div>
                </div>
                <div class="fg">
                  <label class="fl">Model OpenAI</label>
                  <input class="fc" name="openai_model" value="<%= settings.openai_model || 'gpt-4o-mini' %>" placeholder="gpt-4o-mini">
                  <div style="font-size:11px;color:var(--muted);margin-top:4px">Contoh: <span class="mono">gpt-4o-mini</span> atau <span class="mono">gpt-4o</span></div>
                </div>
              </div>
            </div>

            <!-- Provider: DeepSeek -->
            <div id="ai_fields_deepseek" class="ai-provider-field" style="margin-top:12px; display:none">
              <div class="form-row">
                <div class="fg">
                  <label class="fl">DeepSeek API Key</label>
                  <input class="fc" type="password" name="deepseek_api_key" value="<%= settings.deepseek_api_key || '' %>" placeholder="sk-...">
                  <div style="font-size:11px;color:var(--muted);margin-top:4px">Dapatkan dari platform.deepseek.com</div>
                </div>
                <div class="fg">
                  <label class="fl">Model DeepSeek</label>
                  <input class="fc" name="deepseek_model" value="<%= settings.deepseek_model || 'deepseek-chat' %>" placeholder="deepseek-chat">
                  <div style="font-size:11px;color:var(--muted);margin-top:4px">Contoh: <span class="mono">deepseek-chat</span> (V3) atau <span class="mono">deepseek-reasoner</span> (R1)</div>
                </div>
              </div>
            </div>

            <!-- Provider: Groq -->
            <div id="ai_fields_groq" class="ai-provider-field" style="margin-top:12px; display:none">
              <div class="form-row">
                <div class="fg">
                  <label class="fl">Groq API Key (Inference Sangat Cepat)</label>
                  <input class="fc" type="password" name="groq_api_key" value="<%= settings.groq_api_key || '' %>" placeholder="gsk_...">
                  <div style="font-size:11px;color:var(--muted);margin-top:4px">Dapatkan gratis di console.groq.com/keys</div>
                </div>
                <div class="fg">
                  <label class="fl">Model Groq</label>
                  <input class="fc" name="groq_model" value="<%= settings.groq_model || 'llama-3.3-70b-versatile' %>" placeholder="llama-3.3-70b-versatile">
                  <div style="font-size:11px;color:var(--muted);margin-top:4px">Contoh: <span class="mono">llama-3.3-70b-versatile</span></div>
                </div>
              </div>
            </div>

            <!-- Provider: OpenRouter -->
            <div id="ai_fields_openrouter" class="ai-provider-field" style="margin-top:12px; display:none">
              <div class="form-row">
                <div class="fg">
                  <label class="fl">OpenRouter API Key</label>
                  <input class="fc" type="password" name="openrouter_api_key" value="<%= settings.openrouter_api_key || '' %>" placeholder="sk-or-v1-...">
                  <div style="font-size:11px;color:var(--muted);margin-top:4px">Dapatkan dari openrouter.ai/keys</div>
                </div>
                <div class="fg">
                  <label class="fl">Model OpenRouter</label>
                  <input class="fc" name="openrouter_model" value="<%= settings.openrouter_model || 'meta-llama/llama-3.3-70b-instruct' %>" placeholder="meta-llama/llama-3.3-70b-instruct">
                  <div style="font-size:11px;color:var(--muted);margin-top:4px">Contoh: <span class="mono">meta-llama/llama-3.3-70b-instruct</span></div>
                </div>
              </div>
            </div>

            <!-- Provider: Custom / Local AI -->
            <div id="ai_fields_custom" class="ai-provider-field" style="margin-top:12px; display:none">
              <div class="form-row">
                <div class="fg">
                  <label class="fl">API Base URL (OpenAI-Compatible Endpoint)</label>
                  <input class="fc" name="custom_ai_base_url" value="<%= settings.custom_ai_base_url || '' %>" placeholder="http://localhost:11434/v1">
                  <div style="font-size:11px;color:var(--muted);margin-top:4px">Contoh Ollama: <span class="mono">http://localhost:11434/v1</span> | LM Studio: <span class="mono">http://localhost:1234/v1</span></div>
                </div>
                <div class="fg">
                  <label class="fl">Nama Model</label>
                  <input class="fc" name="custom_ai_model" value="<%= settings.custom_ai_model || '' %>" placeholder="llama3:latest">
                  <div style="font-size:11px;color:var(--muted);margin-top:4px">Contoh: <span class="mono">llama3</span>, <span class="mono">qwen2.5</span>, atau <span class="mono">mistral</span></div>
                </div>
              </div>
              <div class="form-row" style="margin-top:10px">
                <div class="fg">
                  <label class="fl">API Key (Opsional)</label>
                  <input class="fc" type="password" name="custom_ai_api_key" value="<%= settings.custom_ai_api_key || '' %>" placeholder="Kosongkan jika Ollama lokal tanpa password/auth">
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- Kustomisasi Beranda & Portal Pelanggan -->
        <div class="card mb16">
          <div class="card-hd">
            <h6 style="margin:0"><i class="bi bi-window-desktop"></i> Kustomisasi Beranda & Portal Pelanggan (/customer/login)</h6>
          </div>
          <div class="card-bd settings-grid">
            <!-- Kolom 1: Banner Pengumuman & Status Jaringan -->
            <div>
              <h6 style="font-size:13px;color:var(--muted);margin-bottom:12px;text-transform:uppercase;letter-spacing:1px">
                <i class="bi bi-megaphone"></i> Banner Pengumuman & Status Jaringan
              </h6>

              <div class="form-row">
                <div class="fg">
                  <label class="fl">Banner Pengumuman Portal</label>
                  <select class="fs" name="portal_banner_enabled">
                    <option value="false" <%= !settings.portal_banner_enabled ? 'selected' : '' %>>Nonaktif</option>
                    <option value="true" <%= settings.portal_banner_enabled ? 'selected' : '' %>>Aktif (Tampilkan di Beranda)</option>
                  </select>
                </div>
                <div class="fg">
                  <label class="fl">Tipe / Warna Banner</label>
                  <select class="fs" name="portal_banner_type">
                    <option value="info" <%= (settings.portal_banner_type === 'info' || !settings.portal_banner_type) ? 'selected' : '' %>>Info (Biru)</option>
                    <option value="warning" <%= settings.portal_banner_type === 'warning' ? 'selected' : '' %>>Peringatan / Maintenance (Kuning)</option>
                    <option value="danger" <%= settings.portal_banner_type === 'danger' ? 'selected' : '' %>>Gangguan Jaringan (Merah)</option>
                    <option value="success" <%= settings.portal_banner_type === 'success' ? 'selected' : '' %>>Promo / Berita Baik (Hijau)</option>
                  </select>
                </div>
              </div>

              <div class="fg">
                <label class="fl">Teks Pengumuman / Info Gangguan</label>
                <textarea class="fc" name="portal_banner_text" rows="3" placeholder="Contoh: Jadwal pemeliharaan jaringan kabel fiber optik wilayah Sektor 2 pada Kamis dini hari 01.00 - 04.00 WIB. Mohon maaf atas ketidaknyamanannya."><%= settings.portal_banner_text || '' %></textarea>
                <div style="font-size:10px; color:var(--muted); margin-top:4px">
                  Teks ini akan tampil paling atas sebagai banner perhatian bagi setiap pengunjung atau pelanggan yang membuka halaman web.
                </div>
              </div>

              <div class="form-row" style="margin-top:16px">
                <div class="fg">
                  <label class="fl"><i class="bi bi-activity"></i> Status Jaringan</label>
                  <select class="fs" name="portal_network_status">
                    <option value="normal" <%= (settings.portal_network_status === 'normal' || !settings.portal_network_status) ? 'selected' : '' %>>🟢 Normal (Semua Server Stabil)</option>
                    <option value="maintenance" <%= settings.portal_network_status === 'maintenance' ? 'selected' : '' %>>🟠 Pemeliharaan Terjadwal</option>
                    <option value="issue" <%= settings.portal_network_status === 'issue' ? 'selected' : '' %>>🔴 Sedang Ada Kendala Teknis</option>
                  </select>
                </div>
              </div>

              <div class="fg">
                <label class="fl">Kustom Keterangan Status Jaringan (Opsional)</label>
                <input class="fc" name="portal_network_status_text" value="<%= settings.portal_network_status_text || '' %>" placeholder="Kosongkan untuk teks otomatis bawaan sistem">
              </div>

              <h6 style="font-size:13px;color:var(--muted);margin-top:20px;margin-bottom:12px;text-transform:uppercase;letter-spacing:1px">
                <i class="bi bi-geo-alt"></i> Lokasi & Media Sosial
              </h6>

              <div class="fg">
                <label class="fl">Link Google Maps Kantor</label>
                <input class="fc" name="social_maps_url" value="<%= settings.social_maps_url || '' %>" placeholder="https://maps.google.com/?q=-6.123,106.123">
                <div style="font-size:10px; color:var(--muted); margin-top:4px">Link ini akan muncul di kartu Kontak Kantor agar pelanggan bisa langsung membuka navigasi Google Maps.</div>
              </div>

              <div class="form-row">
                <div class="fg">
                  <label class="fl"><i class="bi bi-instagram"></i> Instagram</label>
                  <input class="fc" name="social_instagram" value="<%= settings.social_instagram || '' %>" placeholder="https://instagram.com/alijayanet">
                </div>
                <div class="fg">
                  <label class="fl"><i class="bi bi-facebook"></i> Facebook</label>
                  <input class="fc" name="social_facebook" value="<%= settings.social_facebook || '' %>" placeholder="https://facebook.com/alijayanet">
                </div>
              </div>

              <div class="fg">
                <label class="fl"><i class="bi bi-tiktok"></i> TikTok</label>
                <input class="fc" name="social_tiktok" value="<%= settings.social_tiktok || '' %>" placeholder="https://tiktok.com/@alijayanet">
              </div>
            </div>

            <!-- Kolom 2: Slogan, Hero & Highlight Statistik -->
            <div>
              <h6 style="font-size:13px;color:var(--muted);margin-bottom:12px;text-transform:uppercase;letter-spacing:1px">
                <i class="bi bi-card-heading"></i> Slogan & Konten Hero Promosi
              </h6>

              <div class="fg">
                <label class="fl">Tagline Badge Kecil</label>
                <input class="fc" name="portal_hero_badge" value="<%= settings.portal_hero_badge || '' %>" placeholder="Internet Fiber Optic Super Cepat & Unlimited">
                <div style="font-size:10px; color:var(--muted); margin-top:4px">Tampil di atas judul utama (Contoh: Promo Ramadhan: Bebas Biaya Pasang!).</div>
              </div>

              <div class="fg">
                <label class="fl">Judul Utama (Hero Title)</label>
