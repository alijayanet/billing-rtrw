<!-- ========================================== -->
<div class="mo" id="modal-stock-adjust">
  <div class="mb" style="max-width:500px;">
    <div class="mh" style="border-bottom:2px solid #f59e0b;">
      <div class="mt" style="color:#d97706;"><i class="bi bi-sliders"></i> Stock Opname / Penyesuaian Fisik</div>
      <button class="mc" onclick="closeModal('modal-stock-adjust')">&times;</button>
    </div>
    <form action="/admin/inventory/stock/adjust" method="POST">
      <div class="mbody">
        <div class="fg">
          <label class="fl">Pilih Barang yang Disesuaikan *</label>
          <select class="fs" name="item_id" id="adj_item_id" required onchange="onStockAdjustItemChange(this.value)">
            <option value="">-- Pilih Barang --</option>
