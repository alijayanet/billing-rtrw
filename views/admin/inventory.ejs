<!-- ========================================== -->
<!-- MODAL: 4. DETAIL BARANG & KARTU STOK       -->
<!-- ========================================== -->
<div class="mo" id="modal-view-stock">
  <div class="mb" style="max-width:850px; width:95%;">
    <div class="mh">
      <div>
        <div class="mt" id="view-title">Kartu Stok & Riwayat Mutasi</div>
        <div class="text-muted fs11" id="view-subtitle">-</div>
      </div>
      <button class="mc" onclick="closeModal('modal-view-stock')">&times;</button>
    </div>
    <div class="mbody" style="max-height:75vh; overflow-y:auto; padding:16px;">
      <!-- Ringkasan Stok Barang -->
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(140px, 1fr)); gap:10px; margin-bottom:16px;">
        <div style="background:var(--bg3); padding:12px; border-radius:8px; text-align:center;">
          <div class="text-muted fs11">Stok di Gudang</div>
          <div id="v-stock-avail" style="font-size:20px; font-weight:700; color:#16a34a;">0</div>
        </div>
        <div style="background:var(--bg3); padding:12px; border-radius:8px; text-align:center;">
          <div class="text-muted fs11">Terpasang Pelanggan</div>
          <div id="v-stock-assigned" style="font-size:20px; font-weight:700; color:#0284c7;">0</div>
        </div>
        <div style="background:var(--bg3); padding:12px; border-radius:8px; text-align:center;">
          <div class="text-muted fs11">Rusak / Afkir</div>
          <div id="v-stock-broken" style="font-size:20px; font-weight:700; color:#dc2626;">0</div>
        </div>
        <div style="background:var(--bg3); padding:12px; border-radius:8px; text-align:center;">
          <div class="text-muted fs11">Batas Minimum</div>
          <div id="v-stock-min" style="font-size:20px; font-weight:700; color:var(--text);">0</div>
        </div>
      </div>

      <!-- Action buttons khusus item ini -->
      <div style="display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap;">
        <button class="btn btn-sm btn-p" style="background:#10b981; border-color:#10b981;" id="btn-quick-in"><i class="bi bi-box-arrow-in-down"></i> + Stok Masuk</button>
        <button class="btn btn-sm btn-p" style="background:#ef4444; border-color:#ef4444;" id="btn-quick-out"><i class="bi bi-box-arrow-up-right"></i> - Keluarkan Barang</button>
        <button class="btn btn-sm btn-g" id="btn-quick-adj"><i class="bi bi-sliders"></i> Penyesuaian Opname</button>
      </div>

      <!-- Tab detail: Unit / SN vs Kartu Mutasi -->
      <h6 style="margin:16px 0 8px; font-size:13px; font-weight:700; color:var(--primary);"><i class="bi bi-clock-history"></i> Riwayat Transaksi Kartu Stok (Mutasi & Sisa)</h6>
      <div class="tbl-wrap" style="max-height:280px; overflow-y:auto; border:1px solid var(--border); border-radius:8px;">
        <table class="dtbl" style="font-size:11.5px;">
          <thead>
            <tr>
              <th>Waktu</th>
              <th>Jenis</th>
              <th>SN</th>
              <th class="num">Perubahan</th>
              <th class="num" style="background:rgba(0,0,0,0.02);">Sisa Stok</th>
              <th>Penerima / Sumber</th>
              <th>Petugas</th>
              <th>Catatan</th>
            </tr>
          </thead>
          <tbody id="v-logs-body">
            <tr><td colspan="8" class="text-center text-muted" style="padding:20px;">Memuat data...</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Unit SN Terdaftar (Jika Ada) -->
      <div id="v-sn-section" style="display:none; margin-top:20px;">
        <h6 style="margin:0 0 8px; font-size:13px; font-weight:700; color:var(--primary);"><i class="bi bi-upc-scan"></i> Daftar Unit & Serial Number Terdaftar</h6>
        <div class="tbl-wrap" style="max-height:200px; overflow-y:auto; border:1px solid var(--border); border-radius:8px;">
          <table class="dtbl" style="font-size:11.5px;">
            <thead>
              <tr>
                <th>Serial Number</th>
                <th>Status Unit</th>
                <th>Kondisi</th>
                <th>Lokasi / Terpasang Di</th>
                <th>Catatan</th>
              </tr>
            </thead>
            <tbody id="v-sn-body"></tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g" onclick="closeModal('modal-view-stock')">Tutup</button>
    </div>
  </div>
</div>

<script>
  // ─── TAB NAVIGATION ────────────────────────────────────────────────────────
  function switchTab(tab) {
    document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
    document.querySelectorAll('.inv-tab').forEach(el => el.classList.remove('active'));
    const target = document.getElementById('tab-' + tab);
    if (target) target.style.display = 'block';
    const btn = document.getElementById('tabbtn-' + tab);
    if (btn) btn.classList.add('active');
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove('show');
  }

  function toggleSidebar() {
    const sb = document.querySelector('.sidebar');
    if (sb) sb.classList.toggle('open');
  }

  // ─── FILTERING ─────────────────────────────────────────────────────────────
  function filterItems(q) {
    q = (q || '').toLowerCase();
    const catId = document.getElementById('cat-filter').value;
    const rows = document.querySelectorAll('#items-list tr');
    rows.forEach(row => {
      const rowCat = row.getAttribute('data-cat-id');
      const text = row.innerText.toLowerCase();
      const matchCat = (!catId || rowCat === catId);
      const matchText = (!q || text.includes(q));
      row.style.display = (matchCat && matchText) ? '' : 'none';
    });
  }

  function filterCategory(catId) {
    const q = (document.getElementById('item-search-input').value || '').toLowerCase();
    const rows = document.querySelectorAll('#items-list tr');
    rows.forEach(row => {
      const rowCat = row.getAttribute('data-cat-id');
      const text = row.innerText.toLowerCase();
      const matchCat = (!catId || rowCat === catId);
      const matchText = (!q || text.includes(q));
      row.style.display = (matchCat && matchText) ? '' : 'none';
    });
  }

  // ─── MASTER DATA LOOKUP ───────────────────────────────────────────────────
  const allItems = <%- JSON.stringify(items || []) %>;
  const allCategories = <%- JSON.stringify(categories || []) %>;

  // ─── MASTER ITEM MODAL ─────────────────────────────────────────────────────
  function openAddItem() {
    document.getElementById('item-modal-title').innerText = 'Tambah Barang Baru';
    document.getElementById('item-form').action = '/admin/inventory/item/add';
    document.getElementById('item-form').reset();
    document.getElementById('modal-item').classList.add('show');
  }

  function openEditItemById(itemId) {
    const item = allItems.find(i => i.id == itemId);
    if (!item) return;
    document.getElementById('item-modal-title').innerText = 'Edit Data Barang';
    document.getElementById('item-form').action = '/admin/inventory/item/edit/' + item.id;
    document.getElementById('i_category_id').value = item.category_id || '';
    document.getElementById('i_name').value = item.name || '';
    document.getElementById('i_brand').value = item.brand || '';
    document.getElementById('i_model').value = item.model || '';
    document.getElementById('i_unit').value = item.unit || 'pcs';
    document.getElementById('i_min_stock').value = item.min_stock || 5;
    document.getElementById('i_description').value = item.description || '';
    document.getElementById('modal-item').classList.add('show');
  }

  // ─── KATEGORI EDIT ─────────────────────────────────────────────────────────
  function openEditCategoryById(catId) {
    const cat = allCategories.find(c => c.id == catId);
    if (!cat) return;
    switchTab('categories');
    document.getElementById('cat-card-title').innerHTML = '<i class="bi bi-pencil"></i> Edit Kategori';
    document.getElementById('cat-form').action = '/admin/inventory/category/edit/' + cat.id;
    document.getElementById('c_name').value = cat.name || '';
    document.getElementById('c_description').value = cat.description || '';
    document.getElementById('btn-cancel-cat').style.display = 'inline-block';
    document.getElementById('btn-submit-cat').innerHTML = '<i class="bi bi-check-lg"></i> Perbarui Kategori';
    document.getElementById('c_name').focus();
  }

  function cancelEditCategory() {
    document.getElementById('cat-card-title').innerHTML = '<i class="bi bi-plus-lg"></i> Tambah Kategori Baru';
    document.getElementById('cat-form').action = '/admin/inventory/category/add';
    document.getElementById('cat-form').reset();
    document.getElementById('btn-cancel-cat').style.display = 'none';
    document.getElementById('btn-submit-cat').innerHTML = '<i class="bi bi-save"></i> Simpan Kategori';
  }

  // ─── STOK MASUK (IN) ───────────────────────────────────────────────────────
  function openAddStockModal() {
    document.getElementById('in_item_id').value = '';
    document.getElementById('in_quantity').value = 1;
    document.getElementById('modal-stock-in').classList.add('show');
  }

  function openAddStockFor(itemId, itemName, unit) {
    document.getElementById('in_item_id').value = itemId;
    document.getElementById('in_quantity').value = 1;
    document.getElementById('modal-stock-in').classList.add('show');
  }

  function onStockInItemChange(val) {}

  // ─── STOK KELUAR (OUT) ─────────────────────────────────────────────────────
  let currentSelectedAvailable = 0;

  function openIssueStockModal() {
    document.getElementById('out_item_id').value = '';
    document.getElementById('out_quantity').value = 1;
    document.getElementById('out-stock-info').style.display = 'none';
    document.getElementById('out-sn-container').style.display = 'none';
    document.getElementById('modal-stock-out').classList.add('show');
  }

  function openIssueStockFor(itemId, itemName, availableStock, unit) {
    document.getElementById('out_item_id').value = itemId;
    onStockOutItemChange(itemId);
    document.getElementById('modal-stock-out').classList.add('show');
  }

  async function onStockOutItemChange(itemId) {
    const sel = document.getElementById('out_item_id');
    const opt = sel.options[sel.selectedIndex];
    const infoBox = document.getElementById('out-stock-info');
    const snBox = document.getElementById('out-sn-container');
    const snSelect = document.getElementById('out_serial_number');

    if (!itemId) {
      infoBox.style.display = 'none';
      snBox.style.display = 'none';
      return;
    }

    currentSelectedAvailable = parseInt(opt.getAttribute('data-stock'), 10) || 0;
    const unit = opt.getAttribute('data-unit') || 'pcs';
    document.getElementById('out-avail-label').innerText = currentSelectedAvailable + ' ' + unit;
    infoBox.style.display = 'block';

    // Cek apakah item punya serial number
    try {
      const res = await fetch('/admin/api/inventory/serials/' + itemId);
      const json = await res.json();
      if (json.success && json.data && json.data.length > 0) {
        snSelect.innerHTML = '<option value="">-- Pilih Serial Number (Opsional) --</option>';
        json.data.forEach(s => {
          snSelect.innerHTML += `<option value="${s.serial_number}">SN: ${s.serial_number} (${s.condition || 'new'} - ${s.location || 'Gudang'})</option>`;
        });
        snBox.style.display = 'block';
      } else {
        snBox.style.display = 'none';
        snSelect.innerHTML = '';
      }
    } catch (e) {
      snBox.style.display = 'none';
    }
  }

  function onStockOutSnSelect(sn) {
    if (sn) {
      document.getElementById('out_quantity').value = 1;
      document.getElementById('out_quantity').readOnly = true;
    } else {
      document.getElementById('out_quantity').readOnly = false;
    }
  }

  function onStockOutTypeChange(type) {
    const custGroup = document.getElementById('out-customer-group');
    if (type === 'assigned') {
      custGroup.style.display = 'block';
    } else {
      custGroup.style.display = 'none';
    }
  }

  function validateStockOutForm() {
    const qty = parseInt(document.getElementById('out_quantity').value, 10) || 0;
    if (qty <= 0) {
      alert('Jumlah keluar minimal 1');
      return false;
    }
    if (qty > currentSelectedAvailable) {
      alert(`Stok tidak mencukupi! Tersedia di gudang: ${currentSelectedAvailable}, diminta: ${qty}`);
      return false;
    }
    return true;
  }

  // ─── STOCK OPNAME / ADJUSTMENT ─────────────────────────────────────────────
  function openAdjustStockModal() {
    document.getElementById('adj_item_id').value = '';
    document.getElementById('adj_sys_stock').value = 0;
    document.getElementById('adj_actual_quantity').value = 0;
    document.getElementById('adj-diff-box').style.display = 'none';
    document.getElementById('modal-stock-adjust').classList.add('show');
  }

  function onStockAdjustItemChange(itemId) {
    const sel = document.getElementById('adj_item_id');
    const opt = sel.options[sel.selectedIndex];
    if (!itemId) {
      document.getElementById('adj_sys_stock').value = 0;
      document.getElementById('adj_actual_quantity').value = 0;
      document.getElementById('adj-diff-box').style.display = 'none';
      return;
    }
    const currentStock = parseInt(opt.getAttribute('data-stock'), 10) || 0;
    document.getElementById('adj_sys_stock').value = currentStock;
    document.getElementById('adj_actual_quantity').value = currentStock;
    calcAdjustDiff();
  }

  function calcAdjustDiff() {
    const sys = parseInt(document.getElementById('adj_sys_stock').value, 10) || 0;
    const act = parseInt(document.getElementById('adj_actual_quantity').value, 10) || 0;
    const diff = act - sys;
    const box = document.getElementById('adj-diff-box');
    box.style.display = 'block';
    if (diff === 0) {
      box.style.background = '#f1f5f9';
      box.style.color = '#475569';
      box.innerHTML = '⚖️ Jumlah fisik sama persis dengan sistem (Tidak ada selisih).';
    } else if (diff > 0) {
      box.style.background = '#dcfce7';
      box.style.color = '#15803d';
      box.innerHTML = `🟢 Stok fisik lebih banyak <b>+${diff}</b>. Sistem akan menambahkan ${diff} ke stok gudang.`;
    } else {
      box.style.background = '#fee2e2';
      box.style.color = '#b91c1c';
      box.innerHTML = `🔴 Stok fisik berkurang <b>${diff}</b>. Sistem akan mengurangi ${Math.abs(diff)} dari stok gudang.`;
    }
  }

  // ─── DETAIL & KARTU STOK (VIEW STOCK) ──────────────────────────────────────
  let currentViewingItemId = null;

  async function viewStock(itemId, itemName) {
    currentViewingItemId = itemId;
    document.getElementById('view-title').innerText = itemName;
    document.getElementById('view-subtitle').innerText = 'Memuat rincian stok...';
    document.getElementById('v-logs-body').innerHTML = '<tr><td colspan="8" class="text-center text-muted" style="padding:20px;">Memuat riwayat transaksi...</td></tr>';
    document.getElementById('v-sn-section').style.display = 'none';
    document.getElementById('modal-view-stock').classList.add('show');

    try {
      const res = await fetch('/admin/api/inventory/item/' + itemId);
      const json = await res.json();
      if (!json.success || !json.data) throw new Error(json.message || 'Gagal memuat');

      const { item, stockList, logs } = json.data;
      const unit = item.unit || 'pcs';

      document.getElementById('view-subtitle').innerText = `${item.category_name || '-'} &bull; ${[item.brand, item.model].filter(Boolean).join(' ')} &bull; Satuan: ${unit}`;
      document.getElementById('v-stock-avail').innerText = `${item.stock_available || 0} ${unit}`;
      document.getElementById('v-stock-assigned').innerText = `${item.stock_assigned || 0} ${unit}`;
      document.getElementById('v-stock-broken').innerText = `${item.stock_broken || 0} ${unit}`;
      document.getElementById('v-stock-min').innerText = `${item.min_stock || 0} ${unit}`;

      // Set quick action buttons
      document.getElementById('btn-quick-in').onclick = function() {
        closeModal('modal-view-stock');
        openAddStockFor(item.id, item.name, unit);
      };
      document.getElementById('btn-quick-out').onclick = function() {
        closeModal('modal-view-stock');
        openIssueStockFor(item.id, item.name, item.stock_available || 0, unit);
      };
      document.getElementById('btn-quick-adj').onclick = function() {
        closeModal('modal-view-stock');
        openAdjustStockModal();
        document.getElementById('adj_item_id').value = item.id;
        onStockAdjustItemChange(item.id);
      };

      // Render Logs / Kartu Stok
      const tbody = document.getElementById('v-logs-body');
      if (logs && logs.length > 0) {
        tbody.innerHTML = '';
        logs.forEach(l => {
          let bClass = 'log-badge-in';
          let bLabel = 'Masuk';
          if (l.type === 'out') { bClass = 'log-badge-out'; bLabel = 'Keluar'; }
          else if (l.type === 'assigned') { bClass = 'log-badge-assigned'; bLabel = 'Terpasang'; }
          else if (l.type === 'adjust') { bClass = 'log-badge-adjust'; bLabel = 'Opname'; }
          else if (l.type === 'return') { bClass = 'log-badge-return'; bLabel = 'Kembali'; }
          else if (l.type === 'broken') { bClass = 'log-badge-broken'; bLabel = 'Rusak'; }

          tbody.innerHTML += `
            <tr>
              <td class="text-muted" style="white-space:nowrap;">${new Date(l.created_at).toLocaleString('id-ID')}</td>
              <td><span class="log-badge ${bClass}">${bLabel}</span></td>
              <td style="font-family:monospace;">${l.serial_number || '-'}</td>
              <td class="num fw6" style="color:${l.quantity > 0 ? '#16a34a' : '#dc2626'}">
                ${l.quantity > 0 ? ('+' + l.quantity) : l.quantity} ${unit}
              </td>
              <td class="num"><span class="balance-pill">${l.remaining_stock ?? '-'} ${unit}</span></td>
              <td><b>${l.recipient || '-'}</b></td>
              <td class="text-muted">${l.actor || 'Admin'}</td>
              <td class="text-muted">${l.note || '-'}</td>
            </tr>
          `;
        });
      } else {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted" style="padding:20px;">Belum ada riwayat mutasi stok untuk barang ini.</td></tr>';
      }

      // Render Serial Numbers jika ada yang ber-SN
      const serialRows = (stockList || []).filter(s => s.serial_number);
      if (serialRows.length > 0) {
        const snBody = document.getElementById('v-sn-body');
        snBody.innerHTML = '';
        serialRows.forEach(s => {
          let stBadge = '<span class="badge bp">Tersedia di Gudang</span>';
          if (s.status === 'assigned') {
            stBadge = `<span class="badge" style="background:#e0f2fe; color:#0369a1;">Terpasang: ${s.customer_name || s.pppoe_user || 'Pelanggan'}</span>`;
          } else if (s.status === 'broken') {
            stBadge = '<span class="badge" style="background:#fee2e2; color:#dc2626;">Rusak / Afkir</span>';
          } else if (s.status === 'out') {
            stBadge = '<span class="badge" style="background:#f1f5f9; color:#475569;">Keluar</span>';
          }

          snBody.innerHTML += `
            <tr>
              <td style="font-family:monospace; font-weight:700;">${s.serial_number}</td>
              <td>${stBadge}</td>
              <td>${s.condition === 'new' ? 'Baru' : 'Bekas / Copotan'}</td>
              <td>${s.location || 'Gudang Utama'}</td>
              <td class="text-muted">${s.note || '-'}</td>
            </tr>
          `;
        });
        document.getElementById('v-sn-section').style.display = 'block';
      }

    } catch (err) {
      document.getElementById('view-subtitle').innerText = 'Gagal memuat detail barang: ' + err.message;
      document.getElementById('v-logs-body').innerHTML = `<tr><td colspan="8" class="text-center text-danger" style="padding:20px;">Error: ${err.message}</td></tr>`;
    }
  }
</script>
</body>
</html>
