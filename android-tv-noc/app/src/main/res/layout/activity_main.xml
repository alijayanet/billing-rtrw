<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cyberpunk">

    <!-- 1. FULLSCREEN HIGH-PERFORMANCE LEANBACK TV WEBVIEW (NOC.EJS) -->
    <WebView
        android:id="@+id/webViewNoc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="visible" />

    <!-- 2. CYBERPUNK OFFLINE / AUTO-RETRY OVERLAY -->
    <LinearLayout
        android:id="@+id/offlineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6050B14"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="540dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_subtle"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:text="⚡ ALIJAYA NOC DISPLAY TV"
                android:textColor="@color/neon_cyan"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvOfflineTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Menghubungkan ke Server NOC..."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOfflineSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Target: http://192.168.8.8:3001/noc"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvRetryCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:text="Mencoba menghubungkan kembali dalam 5s..."
                android:textColor="@color/neon_emerald"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRetryNow"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_test"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:text="⚡ COBA SEKARANG"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSettingsFromOffline"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_btn_save"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:text="⚙ PENGATURAN URL / IP"
                    android:textColor="#050B14"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:text="Tekan tombol [MENU] pada remote TV untuk mengatur URL"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. NATIVE SOCKET DASHBOARD (FALLBACK JIKA ENGINE WEB DIMATIKAN) -->
    <LinearLayout
        android:id="@+id/nativeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

    <!-- 1. TOP HEADER BAR -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- App Logo & Title -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="⚡ ALIJAYA NOC DISPLAY"
            android:textColor="@color/neon_cyan"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.04"
            android:text="• STB / TV WALLBOARD"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Digital Clock & Date -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginEnd="16dp">

            <TextView
                android:id="@+id/tvDigitalClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="14:35:00 WIB"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDateDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:text="Sabtu, 21 Nov 2026"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Status Badge Pill -->
        <LinearLayout
            android:id="@+id/pillStatus"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_status_pill"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:layout_marginEnd="10dp">

            <View
                android:id="@+id/dotStatus"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/shape_dot_green" />

            <TextView
                android:id="@+id/tvStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:text="ONLINE (192.168.8.1)"
                android:textColor="@color/neon_emerald"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Theme Button -->
        <Button
            android:id="@+id/btnQuickTheme"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_tv_button"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:text="🎨 TEMA"
            android:textColor="@color/neon_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Settings Button -->
        <Button
            android:id="@+id/btnOpenSettings"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_tv_button"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:text="⚙ PENGATURAN"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. TOP KPI CARDS (SINGLE ROW) -->
    <LinearLayout
        android:id="@+id/kpiContainer"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <!-- Card 1: WAN RX (Download) -->
        <LinearLayout
            android:id="@+id/cardWanRx"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_subtle"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="DOWNLOAD ISP (RX)"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvKpiWanRx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0.0 Mbps"
                android:textColor="@color/neon_cyan"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 2: WAN TX (Upload) -->
        <LinearLayout
            android:id="@+id/cardWanTx"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_subtle"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="UPLOAD ISP (TX)"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvKpiWanTx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0.0 Mbps"
                android:textColor="@color/neon_emerald"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 3: PPPoE SESSIONS -->
        <LinearLayout
            android:id="@+id/cardPppoe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_subtle"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="PPPoE AKTIF"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvKpiPppoe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0 Sesi"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 4: HOTSPOT USERS -->
        <LinearLayout
            android:id="@+id/cardHotspot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_subtle"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="HOTSPOT AKTIF"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvKpiHotspot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0 User"
                android:textColor="@color/neon_yellow"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 5: HARDWARE & ROUTER INFO -->
        <LinearLayout
            android:id="@+id/cardHardware"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:background="@drawable/bg_card_subtle"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvRouterBoard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="RB4011iGS+ (v6.49.7)"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHealthTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Temp: 44°C"
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvHealthVolt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:text="Volt: 24.1V"
                    android:textColor="@color/neon_emerald"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 3. MAIN DASHBOARD SPLIT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- LEFT PANEL: DONUT GAUGES (CPU & RAM) -->
        <LinearLayout
            android:id="@+id/panelGauges"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="0.32"
            android:background="@drawable/bg_card_subtle"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Donut Gauge 1: CPU -->
            <net.alijaya.nocdisplay.ui.views.DonutGaugeView
                android:id="@+id/gaugeCpu"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="4dp"
                android:background="@color/border_cyberpunk" />

            <!-- Donut Gauge 2: RAM -->
            <net.alijaya.nocdisplay.ui.views.DonutGaugeView
                android:id="@+id/gaugeRam"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- RIGHT PANEL: TRAFFIC WAVE & INTERFACE MATRIX -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.68"
            android:orientation="vertical">

            <!-- Traffic Throughput Wave Chart -->
            <LinearLayout
                android:id="@+id/panelWave"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_subtle"
                android:orientation="vertical"
                android:padding="8dp">

                <net.alijaya.nocdisplay.ui.views.TrafficWaveView
                    android:id="@+id/waveChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </LinearLayout>

            <!-- Active Interface Matrix -->
            <LinearLayout
                android:id="@+id/panelInterfaces"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_subtle"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:text="ACTIVE INTERFACE MATRIX (ETHERNET &amp; SFP)"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvInterfaces"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- 4. FOOTER BAR (REMOTE CONTROL HINTS) -->
    <LinearLayout
        android:id="@+id/footerBar"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="[MENU] Pengaturan"
            android:textColor="@color/neon_cyan"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="monospace"
            android:text="[1..5 / TEMA] Ganti Tema"
            android:textColor="@color/neon_emerald"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="monospace"
            android:text="[D-PAD] Navigasi Kartu"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvUptime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Uptime: -"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    </LinearLayout>

</FrameLayout>
