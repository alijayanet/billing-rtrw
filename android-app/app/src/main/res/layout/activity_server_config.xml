<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Konfigurasi Server &amp; Peran"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Hubungkan aplikasi ke server billing dan pilih peran portal yang sesuai."
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- 0. QR SCANNER SECTION (CARA PALING MUDAH) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_scan_qr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_dark"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CARA PALING CEPAT &amp; MUDAH"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Pindai QR Code pada stiker modem ONU pelanggan untuk otomatis terhubung tanpa mengetik URL."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_scan_qr"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/primary"
                    android:text="📷 Pindai QR Stiker Modem ONU"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1. SERVER URL SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="ATAU MASUKKAN URL MANUAL"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_server_url"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@color/card_dark"
                android:hint="https://app.alijaya.com"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_test_connection"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/primary"
                android:text=" Tes"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Status Koneksi -->
        <TextView
            android:id="@+id/tv_connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Status: Belum diuji"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Quick Presets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_preset_alijaya"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="app.alijaya.com"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_preset_local"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="IP Lokal LAN"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. PILIHAN PERAN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="PILIH PERAN PORTAL"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_portal_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/card_dark"
            android:padding="10dp">

            <RadioButton
                android:id="@+id/rb_customer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=" Pelanggan (Cek &amp; Bayar Tagihan, WiFi)"
                android:textColor="@color/text_white"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_agent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=" Agen &amp; Reseller (Jual Voucher, PPOB)"
                android:textColor="@color/text_white"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_tech"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=" Teknisi Lapangan (SPK Tugas, ODP, OLT)"
                android:textColor="@color/text_white"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_admin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=" Admin &amp; Kasir (Manajemen ISP Penuh)"
                android:textColor="@color/text_white"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_collector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=" Kolektor Tagihan (Penagihan Lapangan)"
                android:textColor="@color/text_white"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- 3. BLUETOOTH PRINTER SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="PRINTER STRUK BLUETOOTH (AGEN / KOLEKTOR)"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/card_dark"
            android:orientation="vertical"
            android:padding="12dp">

            <Spinner
                android:id="@+id/sp_printers"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@color/bg_dark"
                android:padding="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_scan_printers"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text=" Pindai Printer"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_open_bt_settings"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text=" Bluetooth HP"
                    android:textColor="@color/text_white"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ukuran Kertas:"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rg_paper_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_58mm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="58mm"
                        android:textColor="@color/text_white"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_80mm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="80mm"
                        android:textColor="@color/text_white"
                        android:textSize="12sp" />
                </RadioGroup>
            </LinearLayout>

            <Button
                android:id="@+id/btn_test_print"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:text=" Tes Cetak Struk Contoh"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Preview URL -->
        <TextView
            android:id="@+id/tv_preview_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#1e293b"
            android:padding="8dp"
            android:text="Target: https://app.alijaya.com/customer/login"
            android:textColor="@color/warning"
            android:textSize="11sp" />

        <!-- Buttons -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/primary"
            android:text=" Simpan &amp; Masuk ke Aplikasi"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_reset"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text=" Reset ke Default"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>